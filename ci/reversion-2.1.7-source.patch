+import { beforeEach, describe, expect, it, vi, type Mock } from 'vitest'
+import { createPinia, setActivePinia } from 'pinia'
+
+vi.hoisted(() => {
+  const w = globalThis as unknown as { window?: { path?: { sep: string } } }
+  w.window ??= {}
+  w.window.path ??= { sep: '/' }
+})
+
+import { useLayoutStore } from '@/store/layout'
+
+const win = window as unknown as {
+  electron?: { ipcRenderer: { on: Mock; send: Mock; invoke: Mock } }
+  marktext?: { env: { windowId: number } }
+}
+
+describe('layout store reference-aligned startup width', () => {
+  beforeEach(() => {
+    Object.defineProperty(window, 'innerWidth', {
+      configurable: true,
+      value: 1200
+    })
+    localStorage.clear()
+    win.electron = {
+      ipcRenderer: {
+        on: vi.fn(),
+        send: vi.fn(),
+        invoke: vi.fn(() => Promise.resolve(false))
+      }
+    }
+    win.marktext = { env: { windowId: 1 } }
+    setActivePinia(createPinia())
+  })
+
+  it('replaces a buffered sidebar width with a 1:3 sidebar-to-editor split', () => {
+    const layoutStore = useLayoutStore()
+
+    layoutStore.RESTORE_BUFFERED_STATE({
+      rightColumn: 'files',
+      showSideBar: false,
+      showTabBar: true,
+      sideBarWidth: 640
+    })
+
+    const expectedWidth = Math.max(232, window.innerWidth / (1 + 3))
+    expect(layoutStore.sideBarWidth).toBeCloseTo(expectedWidth, 5)
+    expect(Number(localStorage.getItem('side-bar-width'))).toBeCloseTo(expectedWidth, 5)
+    expect(layoutStore.rightColumn).toBe('toc')
+    expect(layoutStore.showSideBar).toBe(true)
+    expect(layoutStore.showTabBar).toBe(true)
+  })
+
+  it('keeps the 232px safety floor on narrow windows', () => {
+    Object.defineProperty(window, 'innerWidth', {
+      configurable: true,
+      value: 600
+    })
+    const layoutStore = useLayoutStore()
+
+    layoutStore.RESTORE_BUFFERED_STATE({
+      showTabBar: false,
+      sideBarWidth: 500
+    })
+
+    expect(layoutStore.sideBarWidth).toBe(232)
+  })
+})
