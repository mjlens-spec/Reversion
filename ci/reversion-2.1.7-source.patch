+import { describe, expect, it } from 'vitest'
+
+import { resolveAppearance } from '@/util/appearance'
+
+describe('Reversion appearance resolution', () => {
+  it('honors explicit light and dark choices', () => {
+    expect(resolveAppearance('light', true, 'light')).toBe('light')
+    expect(resolveAppearance('dark', false, 'dark')).toBe('dark')
+  })
+
+  it('follows the live system state in system mode', () => {
+    expect(resolveAppearance('system', true, 'dark')).toBe('dark')
+    expect(resolveAppearance('system', false, 'dark')).toBe('light')
+  })
+
+  it('locks imported Typora themes to light appearance', () => {
+    expect(resolveAppearance('dark', true, 'my-typora-theme')).toBe('light')
+    expect(resolveAppearance('system', true, 'my-typora-theme')).toBe('light')
+  })
+
+  it('keeps Claude like and Lens Design on their original light appearance', () => {
+    for (const theme of ['claude-like', 'lens-design']) {
+      expect(resolveAppearance('dark', true, theme)).toBe('light')
+      expect(resolveAppearance('system', true, theme)).toBe('light')
+    }
+  })
+})
diff --git a/packages/desktop/test/unit/specs/cjk-typography.spec.ts b/packages/desktop/test/unit/specs/cjk-typography.spec.ts
