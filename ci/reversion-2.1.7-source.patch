+    min-width: 4.5em;
+    font-size: var(--reading-table-font-size) !important;
+    border-color: var(--claude-line) !important;
+    vertical-align: top;
+    overflow-wrap: break-word;
+    word-break: normal;
+  }
+
+  .mu-container table td *,
+  .mu-container table th * {
+    font-size: inherit !important;
+    line-height: inherit !important;
+  }
+
+  .mu-container table td:first-child,
+  .mu-container table th:first-child {
+    min-width: 3.25em;
+  }
+
+  .mu-container table td:last-child,
+  .mu-container table th:last-child {
+    min-width: 8.5em;
+  }
+
+  .mu-container mark {
+    padding: 0.08em 0.2em;
+    border-radius: 4px;
+    background: rgba(184, 231, 119, 0.46);
+    color: inherit;
+    box-decoration-break: clone;
+  }
+
+  .mu-container mark[data-color='green'] {
+    background: rgba(184, 231, 119, 0.46);
+  }
+
+  .mu-container mark[data-color='blue'] {
+    background: rgba(143, 206, 232, 0.4);
+  }
+
+  .mu-container mark[data-color='orange'] {
+    background: rgba(244, 190, 107, 0.4);
+  }
+
+  .mu-container mark[data-color='pink'] {
+    background: rgba(238, 164, 194, 0.38);
+  }
+
+  ul.mu-bullet-list > li.mu-list-item::before {
+    background: var(--claude-accent) !important;
+  }
+
+  li.mu-task-list-item > input[type="checkbox"]::before,
+  li.mu-task-list-item > span.mu-task-list-checkbox::before {
+    border: 1.5px solid var(--claude-accent) !important;
+    border-radius: 4px !important;
+    background: var(--claude-surface) !important;
+  }
+
+  li.mu-task-list-item > input.mu-checkbox-checked::before,
+  li.mu-task-list-item > span.mu-checkbox-checked::before {
+    background: var(--claude-accent) !important;
+  }
+
+  .CodeMirror {
+    background: var(--claude-surface-soft) !important;
+    color: var(--claude-text) !important;
+    font-family: var(--claude-font-mono) !important;
+    line-height: 1.62 !important;
+  }
+
+  .CodeMirror-gutters {
+    background: var(--claude-surface-muted) !important;
+    border-right: 1px solid var(--claude-line) !important;
+  }
+
+  .CodeMirror-linenumber {
+    color: rgba(110, 98, 89, 0.64) !important;
+  }
+
+  .cm-keyword {
+    color: #7b2ff7 !important;
+  }
+
+  .cm-string {
+    color: #2f8f2f !important;
+  }
+
+  .cm-number {
+    color: #c06a2a !important;
+  }
+
+  .cm-variable,
+  .cm-property {
+    color: #2c5ec6 !important;
+  }
+
+  .cm-comment {
+    color: #8f8378 !important;
+    font-style: italic;
+  }
+}
