diff --git a/packages/desktop/test/unit/specs/context-file-tree.spec.ts b/packages/desktop/test/unit/specs/context-file-tree.spec.ts
new file mode 100644
index 00000000..008dea1b
--- /dev/null
+++ b/packages/desktop/test/unit/specs/context-file-tree.spec.ts
@@ -0,0 +1,263 @@
+import { describe, expect, it, vi } from 'vitest'
+import path from 'node:path'
+import {
+  ContextTreeController,
+  compareTreeEntries,
+  getParentDirectory,
+  isSupportedFileName,
+  type ContextTreeFs,
+  type ContextTreeEntry
+} from '../../../src/renderer/src/components/sideBar/contextTree'
+
+const posixPath = {
+  normalize: (value: string): string => value.replace(/\\/g, '/').replace(/\/{2,}/g, '/') || '/',
+  basename: (value: string): string => value.replace(/\/$/, '').split('/').pop() || '/',
+  dirname: (value: string): string => {
+    const normalized = value.replace(/\\/g, '/').replace(/\/{2,}/g, '/').replace(/\/$/, '') || '/'
+    const index = normalized.lastIndexOf('/')
+    return index <= 0 ? '/' : normalized.slice(0, index)
+  },
+  join: (...parts: string[]): string => {
+    const value = parts.join('/').replace(/\/{2,}/g, '/')
+    return value.startsWith('/') ? value : `/${value}`
+  },
+  isAbsolute: (value: string): boolean => value.startsWith('/')
+}
+
+const makeFs = (entries: Record<string, ContextTreeEntry[]>, delays: Record<string, number> = {}): ContextTreeFs => ({
+  path: posixPath,
+  hasMarkdownExtension: (name) => /\.(?:markdown|mdown|mkdn|md|mkd|mdwn|mdtxt|mdtext|mdx|text|txt)$/i.test(name),
+  readdir: async(pathname) => {
+    const delay = delays[pathname] ?? 0
+    if (delay) await new Promise((resolve) => setTimeout(resolve, delay))
+    const value = entries[pathname]
+    if (!value) throw new Error(`missing ${pathname}`)
+    return value.map((entry) => entry.name)
+  },
+  stat: async(pathname) => {
+    const parent = posixPath.dirname(pathname)
+    const name = posixPath.basename(pathname)
+    const entry = entries[parent]?.find((candidate) => candidate.name === name)
+    if (!entry) throw new Error(`missing ${pathname}`)
+    return entry.stat
+  }
+})
+
+describe('context sidebar file tree helpers', () => {
+  it('sorts directories before files with a stable natural name order', () => {
+    const entries: ContextTreeEntry[] = [
+      { name: '10.md', pathname: '/root/10.md', isDirectory: false, isFile: true },
+      { name: '2-dir', pathname: '/root/2-dir', isDirectory: true, isFile: false },
+      { name: '1-dir', pathname: '/root/1-dir', isDirectory: true, isFile: false },
+      { name: '02.md', pathname: '/root/02.md', isDirectory: false, isFile: true }
+    ]
+    expect([...entries].sort(compareTreeEntries).map((entry) => entry.name)).toEqual([
+      '1-dir',
+      '2-dir',
+      '02.md',
+      '10.md'
+    ])
+  })
+
+  it('recognizes the complete markdown extension set including text and txt', () => {
+    expect(isSupportedFileName('README.MD')).toBe(true)
+    expect(isSupportedFileName('plain.text')).toBe(true)
+    expect(isSupportedFileName('plain.txt')).toBe(true)
+    expect(isSupportedFileName('image.png')).toBe(false)
+    expect(isSupportedFileName('data.json')).toBe(false)
+  })
+
+  it('returns null at the system root and the immediate parent otherwise', () => {
+    expect(getParentDirectory('/', posixPath)).toBeNull()
+    expect(getParentDirectory('/Users/lens/note.md', posixPath)).toBe('/Users/lens')
+    expect(getParentDirectory('/Users/lens', posixPath)).toBe('/Users')
+  })
+
+  it('handles Windows drive and UNC roots without walking above the root', () => {
+    const win32Path = {
+      normalize: path.win32.normalize,
+      basename: path.win32.basename,
+      dirname: path.win32.dirname,
+      join: path.win32.join,
+      isAbsolute: path.win32.isAbsolute,
+      parse: path.win32.parse
+    }
+    expect(getParentDirectory('C:\\', win32Path)).toBeNull()
+    expect(getParentDirectory('C:\\Users\\lens', win32Path)).toBe('C:\\Users')
+    expect(getParentDirectory('\\\\server\\share\\', win32Path)).toBeNull()
+    expect(getParentDirectory('\\\\server\\share\\notes', win32Path)).toBe('\\\\server\\share\\')
+  })
+
+  it('degrades unreadable directories to an empty, marked root', async() => {
+    const controller = new ContextTreeController(makeFs({}), '/missing.md')
+    const root = await controller.setRoot('/missing')
+    expect(root?.files).toEqual([])
+    expect(root?.folders).toEqual([])
+    expect(root?.readError).toBe(true)
+  })
+
+  it('shows symbolic links while keeping both link kinds non-recursive', async() => {
+    const controller = new ContextTreeController(makeFs({
+      '/root': [
+        { name: 'loop', pathname: '/root/loop', isDirectory: true, isFile: false, stat: { isDirectory: true, isFile: false, isSymbolicLink: true } },
+        { name: 'link.md', pathname: '/root/link.md', isDirectory: false, isFile: false, stat: { isDirectory: false, isFile: false, isSymbolicLink: true } },
+        { name: 'note.md', pathname: '/root/note.md', isDirectory: false, isFile: true, stat: { isDirectory: false, isFile: true } }
+      ]
+    }), '/root/note.md')
+    const root = await controller.setRoot('/root')
+    expect(root?.folders.map((folder) => [folder.name, folder.isSymbolicLink])).toEqual([['loop', true]])
+    expect(root?.files.map((file) => [file.name, file.isSymbolicLink])).toEqual([
+      ['link.md', true],
+      ['note.md', undefined]
+    ])
+    if (!root) throw new Error('expected context tree root')
+    const symlinkFolder = root.folders[0]
+    if (!symlinkFolder) throw new Error('expected symbolic-link folder')
+    await controller.expand(symlinkFolder)
+    expect(root?.folders[0]?.folders).toEqual([])
+  })
+
+  it('uses one batch directory read and does not issue one IPC stat per child', async() => {
+    const stat = vi.fn(async() => { throw new Error('stat should not be called') })
+    const controller = new ContextTreeController({
+      path: posixPath,
+      readdir: async() => [],
+      readdirWithTypes: async() => [
+        { name: 'folder', isDirectory: true, isFile: false, isSymbolicLink: false },
+        { name: 'note.md', isDirectory: false, isFile: true, isSymbolicLink: false }
+      ],
+      stat,
+      hasMarkdownExtension: isSupportedFileName
+    }, '/root/note.md')
+    const root = await controller.setRoot('/root')
+    expect(stat).not.toHaveBeenCalled()
+    expect(root?.folders.map((folder) => folder.name)).toEqual(['folder'])
+    expect(root?.files.map((file) => file.name)).toEqual(['note.md'])
+  })
+
+  it('reuses the loaded root for tabs in the same directory', async() => {
+    const readdir = vi.fn(async() => ['note.md'])
+    const controller = new ContextTreeController({
+      path: posixPath,
+      readdir,
+      stat: async() => ({ isDirectory: false, isFile: true }),
+      hasMarkdownExtension: isSupportedFileName
+    }, '/root/note.md')
+    await controller.setRoot('/root')
+    const firstRoot = controller.root
+    await controller.setRootForFile('/root/other.md')
+    expect(controller.root).toBe(firstRoot)
+    expect(readdir).toHaveBeenCalledTimes(1)
+  })
+
+  it('waits for an in-flight same-directory root before returning the current tab tree', async() => {
+    let releaseDirectory!: (entries: unknown[]) => void
+    const pendingDirectory = new Promise<unknown[]>((resolve) => {
+      releaseDirectory = resolve
+    })
+    const readdirWithTypes = vi.fn(() => pendingDirectory)
+    const controller = new ContextTreeController({
+      path: posixPath,
+      readdir: async() => [],
+      readdirWithTypes: readdirWithTypes as never,
+      stat: async() => ({ isDirectory: false, isFile: true }),
+      hasMarkdownExtension: isSupportedFileName
+    }, '/root/a.md')
+
+    const first = controller.setRootForFile('/root/a.md')
+    expect(controller.root?.loading).toBe(true)
+    const second = controller.setRootForFile('/root/b.md')
+    let secondSettled = false
+    second.then(() => { secondSettled = true })
+    await new Promise((resolve) => setTimeout(resolve, 0))
+    expect(secondSettled).toBe(false)
+
+    releaseDirectory([
+      { name: 'a.md', isFile: true, isDirectory: false, isSymbolicLink: false },
+      { name: 'b.md', isFile: true, isDirectory: false, isSymbolicLink: false }
+    ])
+    const [firstRoot, secondRoot] = await Promise.all([first, second])
+    expect(secondRoot).toBe(firstRoot)
+    expect(secondRoot?.files.map((file) => file.name)).toEqual(['a.md', 'b.md'])
+    expect(secondRoot?.loaded).toBe(true)
+  })
+
+  it('uses target openability metadata for symbolic-link files', async() => {
+    const controller = new ContextTreeController({
+      path: posixPath,
+      readdir: async() => [],
+      readdirWithTypes: async() => ([
+        {
+          name: 'alias.txt',
+          isFile: true,
+          isDirectory: false,
+          isSymbolicLink: true,
+          isMarkdown: true,
+          isOpenable: true
+        },
+        {
+          name: 'alias.md',
+          isFile: true,
+          isDirectory: false,
+          isSymbolicLink: true,
+          isMarkdown: false,
+          isOpenable: false
+        },
+        {
+          name: 'broken.link',
+          isFile: true,
+          isDirectory: false,
+          isSymbolicLink: true,
+          isMarkdown: false,
+          isOpenable: false
+        }
+      ] as never),
+      stat: async() => ({ isDirectory: false, isFile: true }),
+      hasMarkdownExtension: isSupportedFileName
+    })
+    const root = await controller.setRoot('/root')
+    const files = root?.files.map((file) => ({
+      name: file.name,
+      isMarkdown: file.isMarkdown,
+      isOpenable: (file as { isOpenable?: boolean }).isOpenable
+    }))
+    expect(files).toEqual([
+      { name: 'alias.md', isMarkdown: false, isOpenable: false },
+      { name: 'alias.txt', isMarkdown: true, isOpenable: true },
+      { name: 'broken.link', isMarkdown: false, isOpenable: false }
+    ])
+  })
+
+  it('keeps a newer root when an older directory read resolves later', async() => {
+    const fs = makeFs({
+      '/slow': [{ name: 'old.md', pathname: '/slow/old.md', isDirectory: false, isFile: true, stat: { isDirectory: false, isFile: true } }],
+      '/fast': [{ name: 'new.md', pathname: '/fast/new.md', isDirectory: false, isFile: true, stat: { isDirectory: false, isFile: true } }]
+    }, { '/slow': 40 })
+    const controller = new ContextTreeController(fs, '/slow/old.md')
+    const stale = controller.setRoot('/slow')
+    await controller.setRoot('/fast')
+    await stale
+    expect(controller.root?.pathname).toBe('/fast')
+    expect(controller.root?.files.map((file) => file.name)).toEqual(['new.md'])
+  })
+
+  it('allows a failed directory to be retried after the first read error', async() => {
+    let attempts = 0
+    const controller = new ContextTreeController({
+      path: posixPath,
+      readdir: async() => {
+        attempts++
+        if (attempts === 1) throw new Error('temporary permission error')
+        return ['note.md']
+      },
+      stat: async() => ({ isDirectory: false, isFile: true }),
+      hasMarkdownExtension: isSupportedFileName
+    }, '/root/note.md')
+    const root = await controller.setRoot('/root')
+    expect(root?.readError).toBe(true)
+    if (!root) throw new Error('expected context tree root')
+    await controller.expand(root)
+    expect(root?.readError).toBe(false)
+    expect(root?.files.map((file) => file.name)).toEqual(['note.md'])
+  })
+})
