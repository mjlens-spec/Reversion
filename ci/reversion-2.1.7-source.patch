+import { describe, expect, it } from 'vitest'
+
+import {
+  composeReadingFontStacks,
+  createReadingFontOverrideCss,
+  resolveEffectiveCjkFont
+} from '@/util/readingFonts'
+
+const themeStacks = {
+  title: 'Cormorant Garamond',
+  heading: 'Spectral',
+  body: 'Noto Sans SC'
+}
+
+describe('reading font composition', () => {
+  it('keeps the 1.9 theme stacks byte-for-byte when both preferences follow the theme', () => {
+    expect(composeReadingFontStacks(themeStacks, {
+      westernBodyFont: 'theme',
+      cjkFont: 'theme'
+    })).toEqual(themeStacks)
+  })
+
+  it('applies a custom western font to body only', () => {
+    expect(composeReadingFontStacks(themeStacks, {
+      westernBodyFont: 'IBM Plex Sans',
+      cjkFont: 'theme'
+    })).toEqual({
+      title: 'Cormorant Garamond',
+      heading: 'Spectral',
+      body: '"IBM Plex Sans", Noto Sans SC'
+    })
+  })
+
+  it('places a custom CJK font after each theme western stack', () => {
+    expect(composeReadingFontStacks(themeStacks, {
+      westernBodyFont: 'theme',
+      cjkFont: '霞鹜文楷'
+    })).toEqual({
+      title: 'Cormorant Garamond, "霞鹜文楷"',
+      heading: 'Spectral, "霞鹜文楷"',
+      body: 'Noto Sans SC, "霞鹜文楷"'
+    })
+  })
+
+  it('quotes user-selected families with spaces or non-ASCII characters', () => {
+    expect(composeReadingFontStacks(themeStacks, {
+      westernBodyFont: 'Avenir Next',
+      cjkFont: 'PingFang SC'
+    }).body).toBe('"Avenir Next", Noto Sans SC, "PingFang SC"')
+  })
+
+  it('emits the same three runtime variables for editor and export', () => {
+    const css = createReadingFontOverrideCss({
+      title: 'Cormorant Garamond, "霞鹜文楷"',
+      heading: 'Spectral, "霞鹜文楷"',
+      body: '"IBM Plex Sans", Noto Sans SC, "霞鹜文楷"'
+    })
+
+    expect(css).toContain('--editor-title-font-family: Cormorant Garamond, "霞鹜文楷";')
+    expect(css).toContain('--editor-heading-font-family: Spectral, "霞鹜文楷";')
+    expect(css).toContain('--editor-body-font-family: "IBM Plex Sans", Noto Sans SC, "霞鹜文楷";')
+  })
+
+  it('reports the first CJK-capable family from the effective stack', async() => {
+    const effective = await resolveEffectiveCjkFont(
+      'Inter, "PingFang SC", "Songti SC", sans-serif',
+      async(family) => family === 'PingFang SC' || family === 'Songti SC'
+    )
+
+    expect(effective).toBe('PingFang SC')
+  })
+})
