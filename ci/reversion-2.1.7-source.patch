diff --git a/packages/desktop/electron-builder.yml b/packages/desktop/electron-builder.yml
index 9a49496f..e2944123 100755
--- a/packages/desktop/electron-builder.yml
+++ b/packages/desktop/electron-builder.yml
@@ -1,8 +1,62 @@
 appId: com.github.marktext.marktext
-productName: marktext
+# B2 productName migration. electron-builder derives, from this one field:
+#   * the bundle directory name           -> dist/mac-arm64/Reversion.app
+#   * CFBundleName and CFBundleDisplayName (macPackager.applyCommonInfo)
+#   * CFBundleExecutable                  -> Contents/MacOS/Reversion
+#   * all four Helper bundles             -> Frameworks/Reversion Helper*.app
+#     (app-builder-lib electronMac.createMacApp: `appFilename =
+#      appInfo.sanitizedProductName`, then moveHelpers renames each one)
+#
+# The last two are why this had to move as one unit rather than being patched
+# after packaging: Electron's main delegate resolves its helper apps by
+# CFBundleName at runtime (electron_main_delegate_mac.mm), so rewriting
+# CFBundleName alone -- which is what scripts/brand-app.sh used to do -- makes
+# the app abort with "Unable to find helper app". Confirmed experimentally in
+# B1; see outputs/B1品牌清理报告_Claude_260726.md §4.
+#
+# The payoff is the macOS system chrome that reads CFBundleName and nothing
+# else: the menu-bar application menu title next to the Apple logo, and the
+# Dock tile's name. Both said "marktext" up to 1.2.0-beta.2.
+#
+# Deliberately NOT renamed alongside it (each is a technical identifier with a
+# compatibility contract, not a brand surface): appId / CFBundleIdentifier,
+# package.json `name` (the pnpm `--filter marktext` workspace selector, which
+# also derives updaterCacheDirName), the keytar Keychain service name, the
+# userData directory, and win/linux `executableName`.
+productName: Reversion
+# Without this override, electron-builder falls back to
+# `Copyright © <year> ${companyName || productName}`, where companyName is
+# derived from package.json's `author.name` -- still "Jocs" (the upstream
+# author's GitHub handle), since that field is left untouched for provenance
+# (see NOTICE.md / UPSTREAM_LICENSES). That fallback surfaces as macOS
+# Finder's "Get Info" NSHumanReadableCopyright field (and would be the .exe's
+# LegalCopyright on a future Windows build) still crediting "Jocs" even
+# though every other user-facing surface says Reversion. This is the B1
+# brand-cleanup fix for that one surface.
+copyright: Copyright © 2026 Reversion
 directories:
   buildResources: build
   output: ../../dist
+# Reversion release feed. electron-builder derives owner/repo/provider for
+# the generated app-update.yml from this block, but it also hardcodes
+# `updaterCacheDirName` from packages/desktop/package.json's `name`
+# (app-builder-lib AppInfo: sanitizedName.toLowerCase() + "-updater") with no
+# config override. `name` stays "marktext" because the workspace scripts filter
+# on it (`pnpm --filter marktext ...`); renaming `productName` above does not
+# affect it. So the generated value is still "marktext-updater" while Reversion
+# ships "reversion-updater".
+#
+# Resolution: config/app-update.yml in the Reversion repo is the single source
+# of truth for the release feed and replaces Resources/app-update.yml after
+# packaging. This block is kept in sync with it and is cross-checked field by
+# field by scripts/build-release-from-source.sh and by
+# tests/source-release-pipeline.test.mjs, so the two cannot drift silently.
+# Keeping it here also means `electron-builder --publish` and any future CI
+# release job resolve the same feed without extra flags.
+publish:
+  provider: github
+  owner: mjlens-spec
+  repo: Reversion
 files:
   - '!**/.vscode/*'
   - '!src/*'
