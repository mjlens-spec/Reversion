+  /** Flush the deflate stream and close the file. Resolves once the PNG is on disk. */
+  async finish(): Promise<void> {
+    if (this.rowsWritten !== this.height) {
+      const err = new Error(
+        `PNG is short: wrote ${this.rowsWritten} of ${this.height} rows`
+      )
+      this.deflate.destroy()
+      this.file.destroy()
+      throw err
+    }
+    this.deflate.end()
+    await this.done
+  }
+
+  /** Tear down after a failure so no half-written file handle is left open. */
+  abort(): void {
+    this.deflate.destroy()
+    this.file.destroy()
+  }
+}
+
+/**
+ * Rewrite an Electron `nativeImage.toBitmap()` buffer in place from BGRA to the
+ * RGBA order PNG expects.
+ */
+export const bgraToRgba = (bitmap: Buffer): Buffer => {
+  for (let i = 0; i < bitmap.length; i += 4) {
+    const b = bitmap[i]!
+    bitmap[i] = bitmap[i + 2]!
+    bitmap[i + 2] = b
+  }
+  return bitmap
+}
