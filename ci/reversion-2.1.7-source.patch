diff --git a/packages/desktop/test/unit/specs/workspace-bar.spec.ts b/packages/desktop/test/unit/specs/workspace-bar.spec.ts
new file mode 100644
index 00000000..7272a02e
--- /dev/null
+++ b/packages/desktop/test/unit/specs/workspace-bar.spec.ts
@@ -0,0 +1,353 @@
+// @vitest-environment jsdom
+
+import { computed, nextTick, ref } from 'vue'
+import { describe, expect, it, vi } from 'vitest'
+import { readFileSync, readdirSync } from 'node:fs'
+import { dirname, resolve } from 'node:path'
+import { fileURLToPath } from 'node:url'
+import { compileScript, parse } from 'vue/compiler-sfc'
+import ts from 'typescript'
+
+// The desktop unit runner intentionally does not mount SFC templates. Compile
+// the actual <script setup> and inject the same stores/bus the component uses;
+// this keeps the export/new-tab assertions on the product source itself.
+
+const here = dirname(fileURLToPath(import.meta.url))
+const workspaceBarPath = resolve(here, '../../../src/renderer/src/components/workspaceBar/index.vue')
+const tabsPath = resolve(here, '../../../src/renderer/src/components/editorWithTabs/tabs.vue')
+const themesPath = resolve(here, '../../../src/renderer/src/assets/themes')
+
+interface CssColor {
+  r: number
+  g: number
+  b: number
+  a: number
+}
+
+type CssVariables = Record<string, string>
+
+const parseThemeVariables = (source: string): CssVariables => {
+  const variables: CssVariables = {}
+  const declarations = /(--[\w-]+)\s*:\s*([^;]+);/g
+  for (const match of source.matchAll(declarations)) variables[match[1]] = match[2].trim()
+  return variables
+}
+
+const parseCssColor = (
+  rawValue: string,
+  variables: CssVariables,
+  resolving = new Set<string>()
+): CssColor | null => {
+  const value = rawValue.trim()
+  const variable = value.match(/^var\(\s*(--[\w-]+)\s*(?:,\s*(.+))?\)$/)
+  if (variable) {
+    const name = variable[1]
+    if (resolving.has(name)) return null
+    const replacement = variables[name] ?? variable[2]
+    if (!replacement) return null
+    const nextResolving = new Set(resolving)
+    nextResolving.add(name)
+    return parseCssColor(replacement, variables, nextResolving)
+  }
+
+  const hex = value.match(/^#([\da-f]{3,8})$/i)?.[1]
+  if (hex) {
+    const expanded = hex.length <= 4
+      ? [...hex].map((channel) => channel + channel).join('')
+      : hex
+    const withAlpha = expanded.length === 6 ? `${expanded}ff` : expanded
+    if (withAlpha.length !== 8) return null
+    return {
+      r: Number.parseInt(withAlpha.slice(0, 2), 16) / 255,
+      g: Number.parseInt(withAlpha.slice(2, 4), 16) / 255,
+      b: Number.parseInt(withAlpha.slice(4, 6), 16) / 255,
+      a: Number.parseInt(withAlpha.slice(6, 8), 16) / 255
+    }
+  }
+
+  const functional = value.match(/^rgba?\((.+)\)$/i)?.[1]
+  if (!functional) return null
+  const channels = functional
+    .replace(/\s*\/\s*/g, ',')
+    .split(/\s*,\s*|\s+/)
+    .filter(Boolean)
+  if (channels.length < 3) return null
+  const parseRgbChannel = (channel: string): number => channel.endsWith('%')
+    ? Number.parseFloat(channel) / 100
+    : Number.parseFloat(channel) / 255
+  const parseAlpha = (channel: string): number => channel.endsWith('%')
+    ? Number.parseFloat(channel) / 100
+    : Number.parseFloat(channel)
+  const color = {
+    r: parseRgbChannel(channels[0]),
+    g: parseRgbChannel(channels[1]),
+    b: parseRgbChannel(channels[2]),
+    a: channels[3] ? parseAlpha(channels[3]) : 1
+  }
+  return Object.values(color).every(Number.isFinite) ? color : null
+}
+
+const composite = (foreground: CssColor, background: CssColor): CssColor => {
+  const alpha = foreground.a + background.a * (1 - foreground.a)
+  return {
+    r: (foreground.r * foreground.a + background.r * background.a * (1 - foreground.a)) / alpha,
+    g: (foreground.g * foreground.a + background.g * background.a * (1 - foreground.a)) / alpha,
+    b: (foreground.b * foreground.a + background.b * background.a * (1 - foreground.a)) / alpha,
+    a: alpha
+  }
+}
+
+const mixIdleColor = (editorColor80: CssColor, editorColor: CssColor): CssColor => {
+  const firstWeight = editorColor80.a * 0.7
+  const secondWeight = editorColor.a * 0.3
+  const alpha = firstWeight + secondWeight
+  return {
+    r: (editorColor80.r * firstWeight + editorColor.r * secondWeight) / alpha,
+    g: (editorColor80.g * firstWeight + editorColor.g * secondWeight) / alpha,
+    b: (editorColor80.b * firstWeight + editorColor.b * secondWeight) / alpha,
+    a: alpha
+  }
+}
+
+const relativeLuminance = (color: CssColor): number => {
+  const linear = (channel: number): number => channel <= 0.04045
+    ? channel / 12.92
+    : ((channel + 0.055) / 1.055) ** 2.4
+  return 0.2126 * linear(color.r) + 0.7152 * linear(color.g) + 0.0722 * linear(color.b)
+}
+
+const contrastRatio = (foreground: CssColor, background: CssColor): number => {
+  const foregroundLuminance = relativeLuminance(foreground)
+  const backgroundLuminance = relativeLuminance(background)
+  return (Math.max(foregroundLuminance, backgroundLuminance) + 0.05) /
+    (Math.min(foregroundLuminance, backgroundLuminance) + 0.05)
+}
+
+interface SetupModule {
+  default: {
+    setup: (props: unknown, ctx: { expose: () => void }) => Record<string, unknown>
+  }
+}
+
+const compileSetup = (path: string, deps: Record<string, unknown>, destructured: string): Record<string, unknown> => {
+  const source = readFileSync(path, 'utf8')
+  const { descriptor } = parse(source)
+  const compiled = compileScript(descriptor, { id: 'workspace-bar-test' })
+  const withoutImports = compiled.content
+    .split('\n')
+    .filter(line => !/^\s*import\s/.test(line))
+    .join('\n')
+  const js = ts.transpileModule(withoutImports, {
+    compilerOptions: { module: ts.ModuleKind.CommonJS, target: ts.ScriptTarget.ES2020 }
+  }).outputText
+
+  // eslint-disable-next-line no-new-func
+  const factory = new Function(
+    '__deps',
+    'exports',
+    'module',
+    `const { ${destructured} } = __deps\n${js}\nreturn module.exports`
+  ) as (deps: Record<string, unknown>, exports: object, module: object) => SetupModule
+  const module = { exports: {} as Record<string, unknown> }
+  return factory(deps, module.exports, module).default.setup({}, { expose: () => {} })
+}
+
+const makeWorkspaceBindings = () => {
+  const currentFile = ref<{ pathname: string } | null>({ pathname: '/tmp/note.md' })
+  const bus = { emit: vi.fn() }
+  let hasCurrentFileWatch: ((available: boolean) => void) | undefined
+  const deps = {
+    _defineComponent: (options: unknown) => options,
+    computed,
+    ref,
+    watch: (_source: unknown, callback: (available: boolean) => void) => {
+      hasCurrentFileWatch = callback
+    },
+    onMounted: () => {},
+    onBeforeUnmount: () => {},
+    storeToRefs: () => ({ currentFile }),
+    useI18n: () => ({ t: (key: string) => key }),
+    useEditorStore: () => ({ currentFile }),
+    bus,
+  }
+  const bindings = compileSetup(
+    workspaceBarPath,
+    deps,
+    '_defineComponent, computed, ref, watch, onMounted, onBeforeUnmount, storeToRefs, useI18n, useEditorStore, bus'
+  )
+  return {
+    bindings,
+    currentFile,
+    bus,
+    triggerHasCurrentFileWatch: (available: boolean) => hasCurrentFileWatch?.(available)
+  }
+}
+
