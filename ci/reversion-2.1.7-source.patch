+import { expect, test } from '@playwright/test'
+import type { ElectronApplication, Page } from 'playwright'
+import { launchWithMarkdown, sendIpcToRenderer } from './helpers'
+
+test.describe('Reversion update experience', () => {
+  let app: ElectronApplication
+  let page: Page
+
+  test.beforeAll(async() => {
+    const launched = await launchWithMarkdown('# Update UI\n')
+    app = launched.app
+    page = launched.page
+  })
+
+  test.afterAll(async() => {
+    if (app) await app.close()
+  })
+
+  test('shows available, continuous progress, cancel, and downloaded states', async() => {
+    await sendIpcToRenderer(app, 'mt::UPDATE_AVAILABLE', {
+      version: '1.3.0',
+      releaseNotes: '# Reversion 1.3.0\n\n更新体验升级。'
+    })
+    await expect(page.locator('.update-card')).toBeVisible()
+    await expect(page.locator('.update-card')).toContainText('1.3.0')
+
+    await page.locator('.update-card .button-primary').click()
+    await sendIpcToRenderer(app, 'mt::UPDATE_PROGRESS', {
+      percent: 31.4,
+      transferred: 31_400_000,
+      total: 100_000_000,
+      bytesPerSecond: 2_000_000
+    })
+    await expect(page.locator('.update-card [role="progressbar"]')).toHaveAttribute('aria-valuenow', '31')
+    await expect(page.locator('.update-card')).toContainText('31%')
+    await expect(page.locator('.update-card')).toContainText('MB/s')
+
+    await sendIpcToRenderer(app, 'mt::UPDATE_PROGRESS', {
+      percent: 78.8,
+      transferred: 78_800_000,
+      total: 100_000_000,
+      bytesPerSecond: 4_000_000
+    })
+    await expect(page.locator('.update-card')).toContainText('79%')
+
+    await sendIpcToRenderer(app, 'mt::UPDATE_DOWNLOADED', {
+      version: '1.3.0',
+      releaseNotes: '# Reversion 1.3.0\n\n更新体验升级。'
+    })
+    await expect(page.locator('.update-card')).toContainText('1.3.0')
+    await expect(page.locator('.update-card .button-primary')).toBeVisible()
+  })
+
+  test('shows cached release notes once after a version change', async() => {
+    await page.evaluate(() => localStorage.removeItem('reversion:update:lastSeenVersion'))
+    await page.evaluate(() => {
+      document.body.tabIndex = -1
+      document.body.focus()
+    })
+    const payload = {
+      version: '1.3.0',
+      releaseNotes: '# 本次更新\n\n- 更新说明只显示一次。'
+    }
+    await sendIpcToRenderer(app, 'mt::SHOW_RELEASE_NOTES', payload)
+    const releaseDialog = page.locator('.update-release-dialog')
+    await expect(releaseDialog).toBeVisible()
+    await expect(releaseDialog).toContainText('更新说明只显示一次')
+    await expect(releaseDialog).toHaveAttribute('aria-modal', 'false')
+    expect(
+      await page.evaluate(() => document.body.classList.contains('el-popup-parent--hidden'))
+    ).toBe(false)
+    await expect(releaseDialog.locator('.button-primary')).toBeFocused()
+
+    const minimap = page.locator('.semantic-minimap')
+    const minimapBox = await minimap.boundingBox()
+    if (!minimapBox) throw new Error('semantic minimap has no bounds behind release notes')
+    await page.mouse.move(0, 0)
+    await page.mouse.move(
+      minimapBox.x + minimapBox.width / 2,
+      minimapBox.y + minimapBox.height / 2
+    )
+    const magnifier = page.locator('.semantic-minimap-magnifier')
+    await expect(magnifier).toBeVisible()
+    await expect(releaseDialog).toBeVisible()
+    await page.mouse.move(0, 0)
+    await expect(magnifier).toBeHidden()
+
+    await page.keyboard.press('Escape')
+    await expect(releaseDialog).toBeHidden()
+    expect(await page.evaluate(() => document.activeElement === document.body)).toBe(true)
+    await sendIpcToRenderer(app, 'mt::SHOW_RELEASE_NOTES', payload)
+    await expect(releaseDialog).toBeHidden()
+  })
+})
