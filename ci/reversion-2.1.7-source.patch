@@ -0,0 +1,83 @@
+import { describe, expect, it } from 'vitest'
+import {
+  CJK_TIDY_DEFAULT_RULES,
+  isCjkQuoteContext,
+  tidyCjkMarkdown
+} from '../../../src/renderer/src/util/cjkTypography'
+
+describe('CJK typography', () => {
+  it('recognizes Chinese quote context without treating line starts as Chinese', () => {
+    expect(isCjkQuoteContext('这是中文')).toBe(true)
+    expect(isCjkQuoteContext('中文，  ')).toBe(true)
+    expect(isCjkQuoteContext('English ')).toBe(false)
+    expect(isCjkQuoteContext('')).toBe(false)
+    expect(isCjkQuoteContext('上一行\n  ')).toBe(false)
+  })
+
+  it('applies the four independently countable v1 tidy rules', () => {
+    const result = tidyCjkMarkdown('反文Reversion  很好!　版本2.1.0。', CJK_TIDY_DEFAULT_RULES)
+    expect(result.markdown).toBe('反文 Reversion 很好！ 版本 2.1.0。')
+    expect(result.counts.cjkLatinSpacing).toBe(2)
+    expect(result.counts.fullWidthPunctuation).toBe(1)
+    expect(result.counts.collapseSpaces).toBe(1)
+    expect(result.counts.fullWidthSpace).toBe(1)
+    expect(result.total).toBe(5)
+  })
+
+  it('preserves numeric punctuation and markdown indentation', () => {
+    const input = '    缩进code\n-  列表  item\n价格1,234.50，版本2.1.0'
+    const result = tidyCjkMarkdown(input)
+    expect(result.markdown).toContain('    缩进code')
+    expect(result.markdown).toContain('-  列表 item')
+    expect(result.markdown).toContain('1,234.50')
+    expect(result.markdown).toContain('2.1.0')
+  })
+
+  it('never changes YAML, code, math, URLs or HTML blocks', () => {
+    const input = [
+      '---',
+      'title: 中文Title!',
+      '---',
+      '',
+      '正文English!',
+      '`行内code!` 与 $x+y=1$，',
+      '[链接Text](https://example.com/a,b?x=1)',
+      '![图片Alt](assets/中文 image.png)',
+      '<div data-name="中文Title!">',
+      'HTML English!',
+      '</div>',
+      '',
+      '```ts',
+      'const 中文Name = "value!"',
+      '```'
+    ].join('\n')
+    const result = tidyCjkMarkdown(input)
+    expect(result.markdown).toContain('title: 中文Title!')
+    expect(result.markdown).toContain('正文 English！')
+    expect(result.markdown).toContain('`行内code!`')
+    expect(result.markdown).toContain('$x+y=1$')
+    expect(result.markdown).toContain('https://example.com/a,b?x=1')
+    expect(result.markdown).toContain('assets/中文 image.png')
+    expect(result.markdown).toContain('<div data-name="中文Title!">\nHTML English!\n</div>')
+    expect(result.markdown).toContain('const 中文Name = "value!"')
+  })
+
+  it('can disable each rule independently', () => {
+    const result = tidyCjkMarkdown('中文English  很好!', {
+      cjkLatinSpacing: false,
+      fullWidthPunctuation: false,
+      collapseSpaces: false,
+      fullWidthSpace: true
+    })
+    expect(result.markdown).toBe('中文English  很好!')
+    expect(result.total).toBe(0)
+  })
+
+  it('handles 10k lines comfortably inside the two-second gate', () => {
+    const input = '中文English  很好!\n'.repeat(10_000)
+    const started = performance.now()
+    const result = tidyCjkMarkdown(input)
+    expect(performance.now() - started).toBeLessThan(2_000)
+    expect(result.counts.cjkLatinSpacing).toBe(10_000)
+  })
+})
