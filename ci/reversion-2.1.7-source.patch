@@ -0,0 +1,113 @@
+import { describe, expect, it, vi } from 'vitest';
+import Format from '../format';
+
+// `Format.updateLink` is the write side of the linkTools edit form: it
+// replaces a link's source span with a freshly composed `[text](href)`.
+//
+// Same structural-fake pattern as `formatUnlink.spec` — the method only
+// reads/writes `this.text`, `this.setCursor` and `this.muya.eventCenter.emit`.
+
+interface IFakeFormatThis {
+    text: string;
+    setCursor: ReturnType<typeof vi.fn>;
+    muya: { eventCenter: { emit: ReturnType<typeof vi.fn> } };
+}
+
+interface IFormatProtoUpdateLink {
+    updateLink: (
+        this: IFakeFormatThis,
+        info: { range: { start: number; end: number } | null; text: string; href: string },
+    ) => void;
+}
+
+function applyUpdateLink(
+    source: string,
+    range: { start: number; end: number } | null,
+    text: string,
+    href: string,
+) {
+    const emit = vi.fn();
+    const setCursor = vi.fn();
+    const fakeThis: IFakeFormatThis = {
+        text: source,
+        setCursor,
+        muya: { eventCenter: { emit } },
+    };
+    (Format.prototype as unknown as IFormatProtoUpdateLink).updateLink.call(fakeThis, {
+        range,
+        text,
+        href,
+    });
+    return { text: fakeThis.text, emit, setCursor };
+}
+
+describe('format.updateLink — rewrites a link source span', () => {
+    it('replaces the whole span with the new label and destination', () => {
+        const src = '[old](https://old.example)';
+        const { text } = applyUpdateLink(src, { start: 0, end: src.length }, 'new', 'https://new.example');
+        expect(text).toBe('[new](https://new.example)');
+    });
+
+    it('keeps surrounding text intact when the link is mid-paragraph', () => {
+        const link = '[old](https://old.example)';
+        const src = `see ${link} for details`;
+        const { text } = applyUpdateLink(src, { start: 4, end: 4 + link.length }, 'new', 'https://new.example');
+        expect(text).toBe('see [new](https://new.example) for details');
+    });
+
+    it('places the caret after the rewritten link, clear of its markers', () => {
+        const link = '[old](https://old.example)';
+        const src = `hi ${link}!`;
+        const rewritten = '[new](https://new.example)';
+        const { setCursor } = applyUpdateLink(
+            src,
+            { start: 3, end: 3 + link.length },
+            'new',
+            'https://new.example',
+        );
+        expect(setCursor).toHaveBeenCalledWith(3 + rewritten.length, 3 + rewritten.length, true);
+    });
+
+    it('emits `muya-link-tools` with reference:null so the popover hides', () => {
+        const src = '[a](https://a.example)';
+        const { emit } = applyUpdateLink(src, { start: 0, end: src.length }, 'b', 'https://b.example');
+        expect(emit).toHaveBeenCalledWith('muya-link-tools', { reference: null });
+    });
+
+    // A literal `]` in the label or `)` in the destination would end the token
+    // early and corrupt the surrounding text, so both are escaped rather than
+    // rejected — the user typed a literal, and refusing to save is worse.
+    it('escapes brackets in the label', () => {
+        const src = '[a](https://a.example)';
+        const { text } = applyUpdateLink(src, { start: 0, end: src.length }, 'a [b] c', 'https://a.example');
+        expect(text).toBe('[a \\[b\\] c](https://a.example)');
+    });
+
+    it('escapes parentheses in the destination', () => {
+        const src = '[a](https://a.example)';
+        const { text } = applyUpdateLink(src, { start: 0, end: src.length }, 'a', 'https://x.example/a(b)c');
+        expect(text).toBe('[a](https://x.example/a\\(b\\)c)');
+    });
+
+    it('percent-encodes whitespace in the destination', () => {
+        const src = '[a](https://a.example)';
+        const { text } = applyUpdateLink(src, { start: 0, end: src.length }, 'a', 'https://x.example/a b');
+        expect(text).toBe('[a](https://x.example/a%20b)');
+    });
+
+    // An empty label renders as an invisible, unclickable link, so fall back to
+    // showing the destination — what the renderer would have to show anyway.
+    it('falls back to the destination when the label is empty', () => {
+        const src = '[a](https://a.example)';
+        const { text } = applyUpdateLink(src, { start: 0, end: src.length }, '', 'https://x.example');
+        expect(text).toBe('[https://x.example](https://x.example)');
+    });
+
+    it('no-ops on null range (defensive)', () => {
+        const src = 'untouched';
+        const { text, emit, setCursor } = applyUpdateLink(src, null, 'a', 'https://a.example');
+        expect(text).toBe(src);
+        expect(setCursor).not.toHaveBeenCalled();
+        expect(emit).not.toHaveBeenCalled();
+    });
+});
