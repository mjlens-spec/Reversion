+const readTranslation = (messages: unknown, key: string): string => {
+  let value: unknown = messages
+  for (const segment of key.split('.')) {
+    if (!value || typeof value !== 'object') return key
+    value = (value as Record<string, unknown>)[segment]
+  }
+  return typeof value === 'string' ? value : key
+}
+
+export const getBilingualCommandDescription = (id: string): { en: string; zh: string } => {
+  const key = COMMAND_KEY_MAP[id]
+  if (!key) return { en: id, zh: id }
+  return {
+    en: readTranslation(enTranslations, key),
+    zh: readTranslation(zhTranslations, key)
+  }
+}
