new file mode 100644
index 00000000..bd48fad5
--- /dev/null
+++ b/packages/desktop/src/renderer/src/commands/catalog.ts
@@ -0,0 +1,78 @@
+export type CommandScope = 'app' | 'document'
+
+export interface PaletteCommandDescriptor {
+  id: string
+  title: { en: string; zh: string }
+  scope: CommandScope
+  keywords?: { en?: string[]; zh?: string[] }
+  accelerator?: string
+  execute?: () => void | Promise<void>
+  executeSubcommand?: (commandId: string, value?: unknown) => void | Promise<void>
+  value?: unknown
+  subcommands?: PaletteCommandDescriptor[]
+  [key: string]: unknown
+}
+
+export interface RankedPaletteEntry extends PaletteCommandDescriptor {
+  score: number
+}
+
+const normalize = (value: string): string =>
+  value
+    .toLocaleLowerCase()
+    .replace(/[+⌘⇧⌥⌃]/g, ' ')
+    .replace(/\s+/g, ' ')
+    .trim()
+
+const searchableValues = (entry: PaletteCommandDescriptor): string[] => [
+  entry.title.en,
+  entry.title.zh,
+  entry.id,
+  entry.accelerator ?? '',
+  ...(entry.keywords?.en ?? []),
+  ...(entry.keywords?.zh ?? [])
+]
+
+const matchScore = (entry: PaletteCommandDescriptor, query: string): number => {
+  let best = Number.POSITIVE_INFINITY
+  for (const rawValue of searchableValues(entry)) {
+    const value = normalize(rawValue)
+    if (!value.includes(query)) continue
+    if (value.startsWith(query)) best = Math.min(best, 0)
+    else if (value.split(/\s+/).some((word) => word.startsWith(query))) best = Math.min(best, 1)
+    else best = Math.min(best, 2)
+  }
+  return best
+}
+
+export const flattenCommandDescriptors = (
+  descriptors: PaletteCommandDescriptor[]
+): PaletteCommandDescriptor[] => {
+  const result: PaletteCommandDescriptor[] = []
+  for (const descriptor of descriptors) {
+    if (descriptor.subcommands?.length) {
+      for (const child of flattenCommandDescriptors(descriptor.subcommands)) {
+        result.push({
+          ...child,
+          executeSubcommand: child.executeSubcommand ?? descriptor.executeSubcommand
+        })
+      }
+    } else {
+      result.push(descriptor)
+    }
+  }
+  return result
+}
+
+export const rankPaletteEntries = (
+  entries: PaletteCommandDescriptor[],
+  rawQuery: string
+): RankedPaletteEntry[] => {
+  const query = normalize(rawQuery)
+  if (!query) return entries.map((entry) => ({ ...entry, score: 0 }))
+
+  return entries
+    .map((entry) => ({ ...entry, score: matchScore(entry, query) }))
+    .filter(({ score }) => Number.isFinite(score))
+    .sort((a, b) => a.score - b.score)
+}
