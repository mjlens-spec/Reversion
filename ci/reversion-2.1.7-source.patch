@@ -0,0 +1,64 @@
+import { beforeEach, describe, expect, it, vi } from 'vitest'
+import { createPinia, setActivePinia } from 'pinia'
+
+vi.hoisted(() => {
+  const w = globalThis as unknown as { window?: { path?: { sep: string } } }
+  w.window ??= {}
+  w.window.path ??= { sep: '/' }
+})
+
+import { useLayoutStore } from '@/store/layout'
+
+// Reversion 1.7 keeps the workspace bar mounted and removes the former
+// rightColumn="" 45px icon rail. These are renderer-level contracts rather
+// than screenshot assertions, so they can run in the regular unit suite.
+
+const win = window as unknown as {
+  electron?: { ipcRenderer: { send: ReturnType<typeof vi.fn> } }
+  marktext?: { env: { windowId: number } }
+}
+
+describe('workspace layout migration', () => {
+  beforeEach(() => {
+    Object.defineProperty(window, 'innerWidth', {
+      configurable: true,
+      value: 1200
+    })
+    localStorage.clear()
+    win.electron = { ipcRenderer: { send: vi.fn() } }
+    win.marktext = { env: { windowId: 1 } }
+    setActivePinia(createPinia())
+  })
+
+  it('normalizes legacy hidden tabs and empty rightColumn state', () => {
+    const layout = useLayoutStore()
+
+    layout.SET_LAYOUT({
+      rightColumn: 'search',
+      showSideBar: true,
+      showTabBar: false,
+      sideBarWidth: 420
+    })
+    expect(layout.rightColumn).toBe('search')
+    expect(layout.showSideBar).toBe(true)
+    expect(layout.showTabBar).toBe(true)
+    expect(layout.effectiveSideBarWidth).toBe(420)
+
+    // Empty rightColumn used to mean “collapse to the icon rail”. The
+    // workspace toggle now controls visibility, so retain the active panel.
+    layout.SET_LAYOUT({ rightColumn: '' })
+    expect(layout.rightColumn).toBe('search')
+    expect(layout.effectiveSideBarWidth).toBe(420)
+  })
+
+  it('reports zero effective width only when the whole sidebar is hidden', () => {
+    const layout = useLayoutStore()
+    layout.SET_LAYOUT({ showSideBar: true, sideBarWidth: 460 })
+    expect(layout.effectiveSideBarWidth).toBe(460)
+
+    layout.SET_LAYOUT({ showSideBar: false })
+    expect(layout.effectiveSideBarWidth).toBe(0)
+    layout.TOGGLE_LAYOUT_ENTRY('showTabBar')
+    expect(layout.showTabBar).toBe(true)
+  })
+})
