+import { expect, test } from '@playwright/test'
+import type { ElectronApplication, Page } from 'playwright'
+import { launchWithMarkdown } from './helpers'
+
+/**
+ * Cmd/Ctrl+Click on a rendered link asks the host to open it.
+ *
+ * The engine emits `format-click`, the renderer forwards it as
+ * `mt::format-link-click`, and the main process opens the URL. Only the app
+ * can settle whether that chain is connected: muya's own e2e host registers no
+ * jump handler, so the same click there proves nothing.
+ */
+test.describe('modifier-click on an inline link', () => {
+  let app: ElectronApplication
+  let page: Page
+
+  test.afterEach(async() => {
+    if (app) await app.close()
+  })
+
+  test('Cmd+Click hands the href to the host', async() => {
+    ;({ app, page } = await launchWithMarkdown('see [docs](https://example.com/a) here\n'))
+
+    const jump = app.evaluate(({ ipcMain }) => {
+      return new Promise<unknown>((resolve) => {
+        ipcMain.once('mt::format-link-click', (_event, payload) => resolve(payload))
+      })
+    })
+
+    // Settle into preview mode first: the modifier-click handler only applies
+    // while the link's source markers are collapsed.
+    await page.locator('.mu-paragraph').first().click({ position: { x: 2, y: 2 } })
+    await page.locator('span.mu-link').first().click({ modifiers: ['Meta'] })
+
+    const payload = (await jump) as { data?: { href?: string } }
+    expect(payload?.data?.href).toBe('https://example.com/a')
+  })
+})
