@@ -0,0 +1,19 @@
+const DEFAULT_DIRECTORY_DEPTH = 3
+
+export const getDisplayFilename = (filename = ''): string => {
+  const extensionIndex = filename.lastIndexOf('.')
+  return extensionIndex > 0 ? filename.slice(0, extensionIndex) : filename
+}
+
+export const getDirectoryTrail = (pathname = '', maxDepth = DEFAULT_DIRECTORY_DEPTH): string[] => {
+  if (!pathname || maxDepth <= 0) return []
+
+  const tokens = pathname.split(/[\\/]+/).filter(Boolean)
+  const directories = tokens.slice(0, -1)
+
+  if (directories.length === 1 && /^[A-Za-z]:$/.test(directories[0])) {
+    return []
+  }
+
+  return directories.slice(-maxDepth)
+}
