@@ -0,0 +1,60 @@
+import { describe, it, expect } from 'vitest'
+import fs from 'fs'
+import path from 'path'
+import schema from '../../../src/main/preferences/schema.json'
+import seed from '../../../static/preference.json'
+
+const ROOT = path.resolve(__dirname, '../../..')
+const DOCK_ICONS = path.join(ROOT, 'static/appIcons')
+const PICKER_ICONS = path.join(ROOT, 'src/renderer/src/assets/appIcons')
+
+const appIconSchema = (schema as unknown as Record<string, { enum?: string[]; default?: string }>)
+  .appIcon!
+const ids = appIconSchema.enum!
+
+describe('app icon assets', () => {
+  it('ships a Dock icon for every id the preference accepts', () => {
+    // applyDockIcon() resolves static/appIcons/<id>.png at runtime, so a missing
+    // file is a silently ignored icon rather than a crash.
+    for (const id of ids) {
+      expect(fs.existsSync(path.join(DOCK_ICONS, `${id}.png`)), `${id} Dock icon`).toBe(true)
+    }
+  })
+
+  it('ships a picker thumbnail for every id the preference accepts', () => {
+    for (const id of ids) {
+      expect(fs.existsSync(path.join(PICKER_ICONS, `${id}.png`)), `${id} thumbnail`).toBe(true)
+    }
+  })
+
+  it('offers a label for every id in the picker and in every locale', () => {
+    const picker = fs.readFileSync(
+      path.join(ROOT, 'src/renderer/src/prefComponents/theme/index.vue'),
+      'utf8'
+    )
+    const localeDir = path.join(ROOT, 'static/locales')
+    const locales = fs.readdirSync(localeDir).filter((f) => f.endsWith('.json') && !f.includes('.min.'))
+
+    for (const id of ids) {
+      const labelKey =
+        'appIcon' +
+        id
+          .split('-')
+          .map((part) => part.charAt(0).toUpperCase() + part.slice(1))
+          .join('')
+      expect(picker, `${id} entry`).toContain(`id: '${id}'`)
+      expect(picker, `${id} label key`).toContain(`preferences.theme.${labelKey}`)
+
+      for (const file of locales) {
+        const messages = JSON.parse(fs.readFileSync(path.join(localeDir, file), 'utf8'))
+        expect(messages.preferences.theme[labelKey], `${labelKey} in ${file}`).toBeTruthy()
+      }
+    }
+  })
+
+  it('defaults to an id that actually exists', () => {
+    const defaultId = (seed as Record<string, unknown>).appIcon
+    expect(ids).toContain(defaultId)
+    expect(appIconSchema.default).toBe(defaultId)
+  })
+})
diff --git a/packages/desktop/test/unit/specs/auto-updates.spec.ts b/packages/desktop/test/unit/specs/auto-updates.spec.ts
new file mode 100644
index 00000000..d48208ca
--- /dev/null
+++ b/packages/desktop/test/unit/specs/auto-updates.spec.ts
@@ -0,0 +1,111 @@
+import { beforeEach, describe, expect, it, vi } from 'vitest'
+import { createPinia, setActivePinia } from 'pinia'
+
+vi.mock('@/services/notification', () => ({
+  default: { notify: vi.fn(() => Promise.resolve()) }
+}))
+
+import { useAutoUpdatesStore } from '@/store/autoUpdates'
+
+type Listener = (...args: unknown[]) => void
+
+describe('auto update state machine', () => {
+  const listeners = new Map<string, Listener>()
+  const send = vi.fn()
+  const invoke = vi.fn()
+
+  beforeEach(() => {
+    listeners.clear()
+    send.mockClear()
+    invoke.mockReset()
+    localStorage.clear()
+    Object.assign(window, {
+      electron: {
+        ipcRenderer: {
+          on: vi.fn((channel: string, listener: Listener) => listeners.set(channel, listener)),
+          send,
+          invoke
+        }
+      }
+    })
+    setActivePinia(createPinia())
+  })
+
+  it('moves from available through continuous progress to downloaded', () => {
+    const store = useAutoUpdatesStore()
+    store.LISTEN_FOR_UPDATE()
+
+    listeners.get('mt::UPDATE_AVAILABLE')?.({}, { version: '1.3.0', releaseNotes: '# Notes' })
+    expect(store.phase).toBe('available')
+    expect(store.version).toBe('1.3.0')
+
+    store.startDownload()
+    expect(send).toHaveBeenCalledWith('mt::NEED_UPDATE', { needUpdate: true })
+
+    listeners.get('mt::UPDATE_PROGRESS')?.(
+      {},
+      { percent: 47.2, transferred: 472, total: 1000, bytesPerSecond: 100 }
+    )
+    expect(store.phase).toBe('downloading')
+    expect(store.percentLabel).toBe('47%')
+
+    listeners.get('mt::UPDATE_DOWNLOADED')?.(
+      {},
+      { version: '1.3.0', releaseNotes: '# Notes' }
+    )
+    expect(store.phase).toBe('downloaded')
+    expect(store.progress.percent).toBe(100)
+  })
+
+  it('exposes cancel, retry, and safe install commands', () => {
+    const store = useAutoUpdatesStore()
+    store.cancelDownload()
+    store.version = '1.3.0'
+    store.retryDownload()
+    store.installUpdate([])
+
+    expect(send).toHaveBeenNthCalledWith(1, 'mt::CANCEL_UPDATE')
+    expect(send).toHaveBeenNthCalledWith(2, 'mt::NEED_UPDATE', { needUpdate: true })
+    expect(send).toHaveBeenNthCalledWith(3, 'mt::INSTALL_UPDATE', [])
+  })
+
+  it('shows release notes once per installed version and uses the cached fallback', async() => {
+    localStorage.setItem('reversion:update:releaseNotes:1.3.0', '# Cached notes')
+    // Upgraded profile (1.2.0 predates the last-seen record), notes fetch offline.
+    invoke.mockImplementation((channel: string) =>
+      channel === 'mt::update::previous-run-version'
+        ? Promise.resolve('1.2.0')
+        : Promise.reject(new Error('offline'))
+    )
+    const store = useAutoUpdatesStore()
+
+    await store.checkReleaseNotes('v1.3.0')
+    expect(store.releaseDialogOpen).toBe(true)
+    expect(store.releaseNotes).toBe('# Cached notes')
+    expect(store.version).toBe('1.3.0')
+    expect(invoke).toHaveBeenCalledWith('mt::update::release-notes', '1.3.0')
+
+    store.markReleaseNotesSeen()
+    expect(store.releaseDialogOpen).toBe(false)
+    await store.checkReleaseNotes('1.3.0')
+    expect(store.releaseDialogOpen).toBe(false)
+  })
+
+  it('stays quiet on a fresh install and only records the current version', async() => {
+    invoke.mockImplementation((channel: string) =>
+      channel === 'mt::update::previous-run-version'
+        ? Promise.resolve(null)
+        : Promise.reject(new Error('release notes must not be fetched on a fresh install'))
+    )
+    const store = useAutoUpdatesStore()
+
+    await store.checkReleaseNotes('1.3.0')
+    expect(store.releaseDialogOpen).toBe(false)
+    expect(localStorage.getItem('reversion:update:lastSeenVersion')).toBe('1.3.0')
+    expect(invoke).toHaveBeenCalledTimes(1)
+
+    // Later launches of the same version short-circuit on the recorded value.
+    await store.checkReleaseNotes('1.3.0')
+    expect(invoke).toHaveBeenCalledTimes(1)
+  })
+})
