--- /dev/null
+++ b/packages/desktop/test/e2e/table-context-menu.spec.ts
@@ -0,0 +1,119 @@
+import { expect, test } from '@playwright/test'
+import type { ElectronApplication, Page } from 'playwright'
+import { getMarkdownContent, launchWithMarkdown, sendIpcToRenderer } from './helpers'
+
+/**
+ * End-to-end verification for the table context menu in the real app.
+ *
+ * The menu itself is an OS-level Electron menu and cannot be opened or read
+ * from the page, so this drives the exact channel a menu click sends
+ * (`mt::cm-table-operation`) and asserts the document changed — covering the
+ * main → renderer → engine path that the muya-only specs cannot reach.
+ *
+ * The wide-table case is the real-window counterpart of
+ * `packages/muya/e2e/tests/blocks/table-wide-scroll.spec.ts`: the muya host's
+ * viewport is not the Electron window's, and the theme that forces table
+ * sizing only loads here.
+ */
+const TABLE = '| h1 | h2 |\n| --- | --- |\n| a1 | a2 |\n| b1 | b2 |\n'
+
+// The desktop renderer keeps its Muya instance component-local, so read the
+// caret from the DOM selection instead of the engine. The click's selection
+// update lands through the editor's merged event stream, so poll rather than
+// assuming it has already arrived.
+async function placeCaretInFirstBodyCell(page: Page) {
+  await page.locator('.mu-table tr').nth(1).locator('td').first().click()
+  await expect
+    .poll(() =>
+      page.evaluate(() => {
+        const node = window.getSelection()?.anchorNode
+        const element = node?.nodeType === 1 ? (node as Element) : node?.parentElement
+        return element?.closest('.mu-table-cell-content') != null
+      })
+    )
+    .toBe(true)
+}
+
+test.describe('table context menu operations', () => {
+  let app: ElectronApplication
+  let page: Page
+
+  test.afterEach(async() => {
+    if (app) await app.close()
+  })
+
+  test('an insert-row command from the menu reaches the engine', async() => {
+    ;({ app, page } = await launchWithMarkdown(TABLE))
+    await placeCaretInFirstBodyCell(page)
+    await expect(page.locator('.mu-table tr')).toHaveCount(3)
+
+    await sendIpcToRenderer(app, 'mt::cm-table-operation', 'insertRowBelow')
+
+    await expect(page.locator('.mu-table tr')).toHaveCount(4)
+  })
+
+  test('a delete-column command from the menu reaches the engine', async() => {
+    ;({ app, page } = await launchWithMarkdown(TABLE))
+    await placeCaretInFirstBodyCell(page)
+
+    await sendIpcToRenderer(app, 'mt::cm-table-operation', 'removeColumn')
+
+    await expect(page.locator('.mu-table tr').first().locator('td')).toHaveCount(1)
+  })
+
+  // Asserted on the rendered cells rather than the markdown: the markdown
+  // round-trip is already covered in the muya suite, and what this spec is
+  // for is that the command crossed main → renderer → engine at all.
+  test('an alignment command reaches the whole column', async() => {
+    ;({ app, page } = await launchWithMarkdown(TABLE))
+    await placeCaretInFirstBodyCell(page)
+
+    await sendIpcToRenderer(app, 'mt::cm-table-operation', 'alignColumnCenter')
+
+    await expect
+      .poll(() =>
+        page.evaluate(() =>
+          [...document.querySelectorAll('.mu-table tr')].map(
+            (row) => (row.querySelectorAll('td')[0] as HTMLElement | undefined)?.dataset.align ?? ''
+          )
+        )
+      )
+      .toEqual(['center', 'center', 'center'])
+  })
+
+  // The renderer must not act on a table command fired with the caret
+  // elsewhere — the menu withholds the group, but the channel is still open.
+  test('a command with the caret outside a table changes nothing', async() => {
+    ;({ app, page } = await launchWithMarkdown('just a paragraph\n'))
+    await page.locator('.mu-paragraph').first().click()
+
+    await sendIpcToRenderer(app, 'mt::cm-table-operation', 'removeRow')
+
+    await expect.poll(async() => getMarkdownContent(page, app)).toContain('just a paragraph')
+    await expect(page.locator('.mu-table')).toHaveCount(0)
+  })
+
+  test('a wide table scrolls inside its figure, not the window', async() => {
+    const columns = 20
+    const header = `| ${Array.from({ length: columns }, (_, i) => `column-header-${i}`).join(' | ')} |`
+    const separator = `| ${Array.from({ length: columns }, () => '---').join(' | ')} |`
+    const body = `| ${Array.from({ length: columns }, (_, i) => `cell-value-${i}`).join(' | ')} |`
+    ;({ app, page } = await launchWithMarkdown(`${header}\n${separator}\n${body}\n`))
+
+    await expect(page.locator('.mu-table').first()).toBeVisible()
+    const geometry = await page.evaluate(() => {
+      const figure = document.querySelector('.mu-table') as HTMLElement
+      return {
+        overflowX: getComputedStyle(figure).overflowX,
+        figureScrollWidth: figure.scrollWidth,
+        figureClientWidth: figure.clientWidth,
+        documentScrollWidth: document.documentElement.scrollWidth,
+        documentClientWidth: document.documentElement.clientWidth
+      }
+    })
+
+    expect(geometry.overflowX).toBe('auto')
+    expect(geometry.figureScrollWidth).toBeGreaterThan(geometry.figureClientWidth)
+    expect(geometry.documentScrollWidth).toBeLessThanOrEqual(geometry.documentClientWidth + 1)
+  })
+})
