+    font-family: var(--editor-heading-font-family, var(--reading-font-heading)), var(--claude-font-heading) !important;
+    font-size: 1em !important;
+    font-weight: 650 !important;
+    color: var(--claude-text-muted) !important;
+  }
+
+  .mu-container a {
