@@ -0,0 +1,77 @@
+export type ReadingTypographyValue = number | 'theme'
+export type ReadingColumnWidth = number | 'theme' | 'window'
+
+export interface ReadingTypographyPreferences {
+  fontSize: ReadingTypographyValue
+  lineHeight: ReadingTypographyValue
+  paragraphSpacing: ReadingTypographyValue
+  columnWidth: ReadingColumnWidth
+}
+
+const clampNumber = (
+  value: unknown,
+  minimum: number,
+  maximum: number,
+  precision = 2
+): number | 'theme' => {
+  if (value === 'theme') return 'theme'
+  if (typeof value !== 'number' || !Number.isFinite(value)) return 'theme'
+  return Number(Math.min(maximum, Math.max(minimum, value)).toFixed(precision))
+}
+
+export const normalizeReadingTypography = (
+  preferences: Partial<ReadingTypographyPreferences>
+): ReadingTypographyPreferences => ({
+  fontSize: clampNumber(preferences.fontSize, 12, 24, 0),
+  lineHeight: clampNumber(preferences.lineHeight, 1.3, 2.2),
+  paragraphSpacing: clampNumber(preferences.paragraphSpacing, 0, 2),
+  columnWidth: preferences.columnWidth === 'window'
+    ? 'window'
+    : clampNumber(preferences.columnWidth, 600, 1200, 0)
+})
+
+export const createReadingTypographyOverrideCss = (
+  rawPreferences: ReadingTypographyPreferences
+): string => {
+  const preferences = normalizeReadingTypography(rawPreferences)
+  const declarations: string[] = []
+  if (preferences.fontSize !== 'theme') {
+    declarations.push(`  --reading-font-size: ${preferences.fontSize}px;`)
+  }
+  if (preferences.lineHeight !== 'theme') {
+    declarations.push(`  --reading-line-height: ${preferences.lineHeight};`)
+  }
+  if (preferences.paragraphSpacing !== 'theme') {
+    declarations.push(`  --reading-paragraph-spacing: ${preferences.paragraphSpacing}em;`)
+  }
+  if (preferences.columnWidth !== 'theme') {
+    declarations.push(`  --reading-column-width: ${preferences.columnWidth === 'window' ? '100%' : `${preferences.columnWidth}px`};`)
+  }
+  return declarations.join('\n')
+}
+
+export const createReadingTypographyCss = (
+  rawPreferences: ReadingTypographyPreferences,
+  cjkTypographyEnabled: boolean
+): string => {
+  const preferences = normalizeReadingTypography(rawPreferences)
+  const declarations = createReadingTypographyOverrideCss(preferences)
+  const rules: string[] = []
+  if (declarations) rules.push(`:root {\n${declarations}\n}`)
+  if (preferences.fontSize !== 'theme') {
+    rules.push('.mu-editor, .mu-container { font-size: var(--reading-font-size) !important; }')
+  }
+  if (preferences.lineHeight !== 'theme') {
+    rules.push('.mu-container, .mu-container p, .mu-container li, .mu-container td, .mu-container th { line-height: var(--reading-line-height) !important; }')
+  }
+  if (preferences.paragraphSpacing !== 'theme') {
+    rules.push('.mu-container > .mu-paragraph { margin-bottom: var(--reading-paragraph-spacing) !important; }')
+  }
+  if (preferences.columnWidth !== 'theme') {
+    rules.push('.mu-container { max-width: min(var(--reading-column-width), 100%) !important; }')
+  }
+  if (cjkTypographyEnabled) {
+    rules.push('html, body, .mu-container { text-autospace: normal; text-spacing-trim: space-first; }')
+  }
+  return rules.join('\n')
+}
