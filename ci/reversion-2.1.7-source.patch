@@ -0,0 +1,59 @@
+import type { Page } from '@playwright/test';
+import { expect, test } from '../fixtures/muya';
+import { getMarkdown } from '../helpers/api';
+import { editor } from '../helpers/selectors';
+
+/**
+ * Excel / Numbers / Sheets ship a `text/html` `<table>` alongside the plain
+ * text, so those already became tables through the HTML→Markdown path. Text
+ * copied out of a `.csv`/`.tsv` file, a terminal, or an editor has only the
+ * plain-text flavour and used to land verbatim.
+ */
+async function pastePlainText(page: Page, payload: string) {
+    await page.evaluate((text) => {
+        const dt = new DataTransfer();
+        dt.setData('text/plain', text);
+        document.activeElement?.dispatchEvent(
+            new ClipboardEvent('paste', { clipboardData: dt, bubbles: true, cancelable: true }),
+        );
+    }, payload);
+}
+
+async function pasteIntoEmptyDoc(page: Page, payload: string) {
+    await page.evaluate(() => window.muya!.setContent(''));
+    await page.locator(editor.paragraph).first().click();
+    await pastePlainText(page, payload);
+}
+
+test.describe('pasting delimited plain text', () => {
+    test('TSV becomes a table', async ({ page }) => {
+        await pasteIntoEmptyDoc(page, 'name\tqty\napple\t3');
+        await expect(page.locator(editor.table)).toHaveCount(1);
+        // The DOM mounts the table before `getMarkdown`'s state catches up.
+        await expect.poll(() => getMarkdown(page)).toContain('| name');
+        expect(await getMarkdown(page)).toContain('| apple');
+    });
+
+    test('unspaced CSV becomes a table', async ({ page }) => {
+        await pasteIntoEmptyDoc(page, 'name,qty\napple,3');
+        await expect(page.locator(editor.table)).toHaveCount(1);
+    });
+
+    // A false positive silently destroys the pasted text's shape.
+    test('comma-separated prose stays prose', async ({ page }) => {
+        await pasteIntoEmptyDoc(page, 'one, two\nthree, four');
+        // `applyPaste` is async, so wait for the text to land before asserting
+        // the absence of a table — an empty document trivially has none.
+        await expect.poll(() => getMarkdown(page)).toContain('one, two');
+        await expect(page.locator(editor.table)).toHaveCount(0);
+    });
+
+    // Inside a code fence the pasted characters are the point.
+    test('TSV pasted into a code block stays literal', async ({ page }) => {
+        await page.evaluate(() => window.muya!.setContent('```\n\n```\n'));
+        await page.locator(editor.codeContent).first().click();
+        await pastePlainText(page, 'a\tb\nc\td');
+        await expect.poll(() => getMarkdown(page)).toContain('a\tb');
+        await expect(page.locator(editor.table)).toHaveCount(0);
+    });
+});
