diff --git a/packages/desktop/test/unit/specs/typora-theme-store.spec.ts b/packages/desktop/test/unit/specs/typora-theme-store.spec.ts
new file mode 100644
index 00000000..57e9b066
--- /dev/null
+++ b/packages/desktop/test/unit/specs/typora-theme-store.spec.ts
@@ -0,0 +1,112 @@
+import fs from 'fs'
+import os from 'os'
+import path from 'path'
+import { afterEach, beforeEach, describe, expect, it, vi } from 'vitest'
+
+vi.mock('electron-log', () => ({ default: { error: vi.fn(), warn: vi.fn(), info: vi.fn() } }))
+
+import {
+  importTyporaTheme,
+  listImportedThemes,
+  readUserTheme,
+  userThemePath
+} from 'main_renderer/typoraThemeStore'
+
+// A minimal but representative Typora theme: :root variables, a `#write`
+// content root, a heading rule, and a Typora-only UI selector that must be
+// dropped rather than carried into the editor theme.
+const TYPORA_CSS = `
+:root {
+  --bg-color: #fdfdfd;
+  --text-color: #24292e;
+  --md-char-color: #b4b4b4;
+}
+#write {
+  max-width: 860px;
+  font-family: "Source Serif 4", serif;
+  color: var(--text-color);
+}
+#write h1 { font-size: 2em; }
+#write blockquote { border-left: 4px solid #dfe2e5; }
+#typora-sidebar { background: #f2f2f2; }
+.megamenu-content { display: none; }
+`
+
+let userData: string
+
+beforeEach(() => {
+  userData = fs.mkdtempSync(path.join(os.tmpdir(), 'reversion-themes-'))
+})
+
+afterEach(() => {
+  fs.rmSync(userData, { recursive: true, force: true })
+})
+
+const writeSource = (name: string, css = TYPORA_CSS): string => {
+  const p = path.join(userData, name)
+  fs.writeFileSync(p, css, 'utf8')
+  return p
+}
+
+describe('typoraThemeStore', () => {
+  it('writes editor, export and report artifacts for a valid theme', () => {
+    const result = importTyporaTheme(userData, writeSource('GitHub Night.css'))
+
+    expect(result.ok).toBe(true)
+    if (!result.ok) return
+
+    // The id is the value stored in preferences, so it must be a plain slug.
+    expect(result.id).toBe('github-night')
+    expect(result.themeName).toBe('GitHub Night')
+    expect(result.totalSelectors).toBeGreaterThan(0)
+
+    const editor = fs.readFileSync(userThemePath(userData, 'github-night'), 'utf8')
+    // The export half has to land where the PDF exporter already looks.
+    const exported = fs.readFileSync(
+      path.join(userData, 'themes', 'export', 'github-night.css'),
+      'utf8'
+    )
+    expect(fs.existsSync(result.reportPath)).toBe(true)
+
+    expect(editor).toContain('.mu-container')
+    expect(editor).not.toContain('#typora-sidebar')
+    expect(exported).toContain('.markdown-body')
+  })
+
+  it('lists an imported theme under its original display name', () => {
+    importTyporaTheme(userData, writeSource('GitHub Night.css'))
+
+    expect(listImportedThemes(userData)).toEqual([{ id: 'github-night', label: 'GitHub Night' }])
+  })
+
+  it('returns an empty list when nothing has been imported', () => {
+    expect(listImportedThemes(userData)).toEqual([])
+  })
+
+  it('reads back the CSS the renderer will inject', () => {
+    importTyporaTheme(userData, writeSource('Night.css'))
+
+    expect(readUserTheme(userData, 'night')).toContain('.mu-container')
+  })
+
+  // The id crosses an IPC boundary from the renderer, so path traversal and
+  // absolute paths must not reach the file system.
+  it.each(['../../etc/passwd', '/etc/passwd', 'foo/bar', 'Night.css'])(
+    'refuses to read the unsafe id %s',
+    (id) => {
+      expect(readUserTheme(userData, id)).toBeNull()
+    }
+  )
+
+  it('reports a source file that cannot be read', () => {
+    const result = importTyporaTheme(userData, path.join(userData, 'missing.css'))
+
+    expect(result).toMatchObject({ ok: false, reason: 'unreadable' })
+  })
+
+  it('reports a file name that cannot become a theme id', () => {
+    const result = importTyporaTheme(userData, writeSource('中文主题.css'))
+
+    expect(result).toMatchObject({ ok: false, reason: 'invalid-name' })
+  })
+})
