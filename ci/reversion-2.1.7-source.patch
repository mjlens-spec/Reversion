--- /dev/null
+++ b/packages/muya/src/utils/__tests__/delimitedTable.spec.ts
@@ -0,0 +1,73 @@
+// @vitest-environment happy-dom
+import { describe, expect, it } from 'vitest';
+import { delimitedTextToMarkdownTable } from '../paste';
+
+describe('delimitedTextToMarkdownTable', () => {
+    it('converts TSV, treating the first row as the header', () => {
+        expect(delimitedTextToMarkdownTable('a\tb\nc\td')).toBe(
+            '| a | b |\n| --- | --- |\n| c | d |',
+        );
+    });
+
+    it('converts unspaced CSV', () => {
+        expect(delimitedTextToMarkdownTable('name,qty\napple,3\npear,5')).toBe(
+            '| name | qty |\n| --- | --- |\n| apple | 3 |\n| pear | 5 |',
+        );
+    });
+
+    it('ignores a separator inside a quoted field', () => {
+        expect(delimitedTextToMarkdownTable('"Doe, Jane",42\n"Roe, Jo",7')).toBe(
+            '| Doe, Jane | 42 |\n| --- | --- |\n| Roe, Jo | 7 |',
+        );
+    });
+
+    it('unescapes a doubled quote inside a quoted field', () => {
+        expect(delimitedTextToMarkdownTable('"say ""hi""",1\nplain,2')).toBe(
+            '| say "hi" | 1 |\n| --- | --- |\n| plain | 2 |',
+        );
+    });
+
+    it('escapes a literal pipe so it does not end the cell', () => {
+        expect(delimitedTextToMarkdownTable('a|b\tc\nd\te')).toBe(
+            '| a\\|b | c |\n| --- | --- |\n| d | e |',
+        );
+    });
+
+    it('prefers tabs when a payload contains both separators', () => {
+        expect(delimitedTextToMarkdownTable('a,1\tb,2\nc,3\td,4')).toBe(
+            '| a,1 | b,2 |\n| --- | --- |\n| c,3 | d,4 |',
+        );
+    });
+
+    // A false positive silently destroys the pasted text's shape, so anything
+    // less than confidently tabular is left alone.
+    it('leaves a single line alone', () => {
+        expect(delimitedTextToMarkdownTable('a\tb\tc')).toBeNull();
+    });
+
+    it('leaves ragged rows alone', () => {
+        expect(delimitedTextToMarkdownTable('a\tb\nc\td\te')).toBeNull();
+    });
+
+    it('leaves a single column alone', () => {
+        expect(delimitedTextToMarkdownTable('alpha\nbeta')).toBeNull();
+    });
+
+    // Prose puts a space after its commas; CSV data does not. Without this,
+    // any two lines of comma-separated prose would become a table.
+    it('leaves comma-separated prose alone', () => {
+        expect(delimitedTextToMarkdownTable('one, two\nthree, four')).toBeNull();
+    });
+
+    it('still converts spaced CSV when a field is quoted', () => {
+        expect(delimitedTextToMarkdownTable('"a", b\n"c", d')).toBe(
+            '| a | b |\n| --- | --- |\n| c | d |',
+        );
+    });
+
+    it('ignores a trailing newline rather than emitting an empty row', () => {
+        expect(delimitedTextToMarkdownTable('a\tb\nc\td\n')).toBe(
+            '| a | b |\n| --- | --- |\n| c | d |',
+        );
+    });
+});
