@@ -0,0 +1,236 @@
+// Schema-aware coercion for preference values.
+//
+// `electron-store` validates the WHOLE store object on every write and throws
+// on the first violation. That makes a single out-of-range value — from any
+// `mt::set-user-preference` sender, or already sitting in an old
+// `preferences.json` — fatal: an uncaught main-process exception on write, and
+// a hard startup failure on read (the `Conf` constructor reads and validates
+// the file, and `clearInvalidConfig` is false).
+//
+// These helpers are deliberately pure and Electron-free so they can be unit
+// tested directly (see test/unit/specs/preference-validate.spec.ts) and reused
+// both at the IPC boundary and in the pre-flight repair pass that runs before
+// the store is constructed.
+
+export interface PreferenceSchemaEntry {
+  description?: string
+  type?: string
+  enum?: unknown[]
+  minimum?: number
+  maximum?: number
+  pattern?: string
+  items?: { type?: string }
+  default?: unknown
+  anyOf?: PreferenceSchemaEntry[]
+}
+
+export type PreferenceSchema = Record<string, PreferenceSchemaEntry>
+
+export type CoerceOutcome =
+  /** Value satisfies the schema as-is. */
+  | { status: 'ok'; value: unknown }
+  /** Numeric value was outside `minimum`/`maximum` and has been pulled to the bound. */
+  | { status: 'clamped'; value: unknown; reason: string }
+  /** Value cannot be represented under this key's schema at all. */
+  | { status: 'rejected'; reason: string }
+  /** Key is not described by the schema; callers decide what to do with it. */
+  | { status: 'unknown-key' }
+
+const isPlainObject = (value: unknown): boolean =>
+  typeof value === 'object' && value !== null && !Array.isArray(value)
+
+const describe = (value: unknown): string => {
+  if (typeof value === 'number') return String(value)
+  if (typeof value === 'string') return JSON.stringify(value)
+  if (value === null) return 'null'
+  if (Array.isArray(value)) return `array(${value.length})`
+  return `${typeof value} ${String(value)}`
+}
+
+const matchesType = (type: string | undefined, value: unknown): boolean => {
+  switch (type) {
+    case undefined:
+      return true
+    case 'number':
+      // JSON Schema's "number" excludes NaN/Infinity, and so does ajv — which
+      // is why `NaN` produces "must be number" rather than "must be >= 1000".
+      return typeof value === 'number' && Number.isFinite(value)
+    case 'boolean':
+      return typeof value === 'boolean'
+    case 'string':
+      return typeof value === 'string'
+    case 'array':
+      return Array.isArray(value)
+    case 'object':
+      return isPlainObject(value)
+    default:
+      return true
+  }
+}
+
+/**
+ * Checks one key/value pair against the preference schema, clamping numbers
+ * into their declared range instead of rejecting them outright.
+ */
+export const coercePreferenceValue = (
+  schema: PreferenceSchema,
+  key: string,
+  value: unknown
+): CoerceOutcome => {
+  const entry = schema[key]
+  if (!entry) return { status: 'unknown-key' }
+
+  if (value === undefined) {
+    // `Store.set(key, undefined)` throws "Use `delete()` to clear values".
+    return { status: 'rejected', reason: 'value is undefined' }
+  }
+
+  if (entry.anyOf) {
+    const outcomes = entry.anyOf.map((candidate) =>
+      coercePreferenceValue({ [key]: candidate }, key, value)
+    )
+    const accepted = outcomes.find((outcome) => outcome.status === 'ok') ??
+      outcomes.find((outcome) => outcome.status === 'clamped')
+    return accepted ?? {
+      status: 'rejected',
+      reason: outcomes
+        .filter((outcome): outcome is Extract<CoerceOutcome, { status: 'rejected' }> => outcome.status === 'rejected')
+        .map((outcome) => outcome.reason)
+        .join('; ')
+    }
+  }
+
+  if (entry.enum) {
+    return entry.enum.includes(value)
+      ? { status: 'ok', value }
+      : {
+        status: 'rejected',
+        reason: `${describe(value)} is not one of ${JSON.stringify(entry.enum)}`
+      }
+  }
+
+  if (!matchesType(entry.type, value)) {
+    return { status: 'rejected', reason: `expected ${entry.type}, got ${describe(value)}` }
+  }
+
+  if (entry.type === 'number') {
+    const numeric = value as number
+    if (typeof entry.minimum === 'number' && numeric < entry.minimum) {
+      return {
+        status: 'clamped',
+        value: entry.minimum,
+        reason: `${numeric} is below the minimum ${entry.minimum}`
+      }
+    }
+    if (typeof entry.maximum === 'number' && numeric > entry.maximum) {
+      return {
+        status: 'clamped',
+        value: entry.maximum,
+        reason: `${numeric} is above the maximum ${entry.maximum}`
+      }
+    }
+    return { status: 'ok', value: numeric }
+  }
+
+  if (entry.type === 'string' && entry.pattern) {
+    let pattern: RegExp
+    try {
+      pattern = new RegExp(entry.pattern)
+    } catch {
+      // An unusable pattern in our own schema must not brick the write path.
+      return { status: 'ok', value }
+    }
+    if (!pattern.test(value as string)) {
+      return {
+        status: 'rejected',
+        reason: `${describe(value)} does not match ${entry.pattern}`
+      }
+    }
+    return { status: 'ok', value }
+  }
+
+  if (entry.type === 'array' && entry.items?.type) {
+    const itemType = entry.items.type
+    const bad = (value as unknown[]).findIndex((item) => !matchesType(itemType, item))
+    if (bad !== -1) {
+      return {
+        status: 'rejected',
+        reason: `item ${bad} is not ${itemType}`
+      }
+    }
+    return { status: 'ok', value }
+  }
+
+  return { status: 'ok', value }
+}
+
+export interface PreferenceRepair {
+  key: string
+  action: 'clamped' | 'reset-to-default' | 'dropped' | 'kept-unknown'
+  reason: string
+  from: unknown
+  to?: unknown
+}
+
+export interface SanitizeResult {
+  /** A new object; the input is never mutated. */
+  data: Record<string, unknown>
+  repairs: PreferenceRepair[]
+}
+
+/**
+ * Makes a whole preferences object safe to hand to `electron-store`.
+ *
+ * - out-of-range numbers are clamped to the schema bound
+ * - values that cannot be coerced fall back to the schema default, or are
+ *   dropped when the schema declares none (the store fills defaults itself)
+ * - keys the schema does not describe are preserved (the schema sets no
+ *   `additionalProperties: false`, so they are valid); they are only reported
+ *   so a stale entry such as `treePathExcludePatterns` is visible in the log
+ */
+export const sanitizePreferences = (
+  schema: PreferenceSchema,
+  data: Record<string, unknown>
+): SanitizeResult => {
+  const out: Record<string, unknown> = {}
+  const repairs: PreferenceRepair[] = []
+
+  for (const [key, value] of Object.entries(data)) {
+    const outcome = coercePreferenceValue(schema, key, value)
+    switch (outcome.status) {
+      case 'ok':
+        out[key] = value
+        break
+      case 'clamped':
+        out[key] = outcome.value
+        repairs.push({ key, action: 'clamped', reason: outcome.reason, from: value, to: outcome.value })
+        break
+      case 'unknown-key':
+        out[key] = value
+        repairs.push({ key, action: 'kept-unknown', reason: 'not described by the schema', from: value })
+        break
+      case 'rejected': {
+        const entry = schema[key]
+        if (entry && 'default' in entry) {
+          out[key] = entry.default
+          repairs.push({
+            key,
+            action: 'reset-to-default',
+            reason: outcome.reason,
+            from: value,
+            to: entry.default
+          })
+        } else {
+          repairs.push({ key, action: 'dropped', reason: outcome.reason, from: value })
+        }
+        break
+      }
+    }
+  }
+
+  return { data: out, repairs }
+}
+
+/** True when `repairs` contains something that actually changed the data. */
+export const hasEffectiveRepairs = (repairs: PreferenceRepair[]): boolean =>
+  repairs.some((repair) => repair.action !== 'kept-unknown')
