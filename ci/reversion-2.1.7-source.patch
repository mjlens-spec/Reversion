+++ b/packages/desktop/test/e2e/sidebar-autofit.spec.ts
@@ -0,0 +1,82 @@
+import { expect, test } from '@playwright/test'
+import type { ElectronApplication, Page } from 'playwright'
+import { launchWithMarkdown } from './helpers'
+
+// Double-clicking the sidebar drag-bar fits the sidebar to the active panel's
+// natural content width: an over-widened sidebar shrinks back, and the result
+// never drops below the 220px minimum. Drives the real built app.
+
+const sideBarWidth = (page: Page) =>
+  page.evaluate(() => {
+    const el = document.querySelector('.side-bar') as HTMLElement | null
+    return el ? Math.round(el.getBoundingClientRect().width) : 0
+  })
+
+test.describe('sidebar drag-bar double-click auto-fit', () => {
+  let app: ElectronApplication
+  let page: Page
+
+  test.beforeAll(async() => {
+    const launched = await launchWithMarkdown('# Doc\n\n## A\n\n## B\n')
+    app = launched.app
+    page = launched.page
+    await page.waitForFunction(() => {
+      const el = document.querySelector('.side-bar') as HTMLElement | null
+      return !!(el && el.offsetParent !== null && el.getBoundingClientRect().width > 220)
+    }, null, { timeout: 5000 })
+  })
+
+  test.afterAll(async() => {
+    if (app) await app.close()
+  })
+
+  test('double-click shrinks an over-widened sidebar to fit its content', async() => {
+    // Drag far past what the files panel needs so the fit is observable.
+    const dragBar = page.locator('.side-bar .drag-bar')
+    const box = await dragBar.boundingBox()
+    expect(box).not.toBeNull()
+    await page.mouse.move(box!.x + box!.width / 2, box!.y + 80)
+    await page.mouse.down()
+    await page.mouse.move(box!.x + box!.width / 2 + 300, box!.y + 80, { steps: 8 })
+    await page.mouse.up()
+    await page.waitForFunction(() => {
+      const el = document.querySelector('.side-bar') as HTMLElement | null
+      return !!el && el.getBoundingClientRect().width >= 450
+    }, null, { timeout: 5000 })
+    const widened = await sideBarWidth(page)
+
+    const fitBox = await dragBar.boundingBox()
+    await page.mouse.dblclick(fitBox!.x + fitBox!.width / 2, fitBox!.y + 80)
+    await page.waitForFunction((prev) => {
+      const el = document.querySelector('.side-bar') as HTMLElement | null
+      return !!el && el.getBoundingClientRect().width < prev
+    }, widened, { timeout: 5000 })
+
+    const fitted = await sideBarWidth(page)
+    expect(fitted).toBeLessThan(widened)
+    expect(fitted).toBeGreaterThanOrEqual(220)
+  })
+
+  test('double-click at the clamped minimum stays at or above 220px', async() => {
+    // Drag hard left so the width clamps to the 220px floor first.
+    const dragBar = page.locator('.side-bar .drag-bar')
+    const box = await dragBar.boundingBox()
+    expect(box).not.toBeNull()
+    await page.mouse.move(box!.x + box!.width / 2, box!.y + 80)
+    await page.mouse.down()
+    await page.mouse.move(Math.max(box!.x - 600, 10), box!.y + 80, { steps: 8 })
+    await page.mouse.up()
+    await page.waitForFunction(() => {
+      const el = document.querySelector('.side-bar') as HTMLElement | null
+      return !!el && el.getBoundingClientRect().width <= 230
+    }, null, { timeout: 5000 })
+
+    const fitBox = await dragBar.boundingBox()
+    await page.mouse.dblclick(fitBox!.x + fitBox!.width / 2, fitBox!.y + 80)
+    // The fit may keep 220 (content already fits) or grow; it must not break
+    // the minimum clamp either way.
+    await page.waitForTimeout(300)
+    const fitted = await sideBarWidth(page)
+    expect(fitted).toBeGreaterThanOrEqual(220)
+  })
+})
