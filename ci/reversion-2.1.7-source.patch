new file mode 100644
index 00000000..2ac73fab
--- /dev/null
+++ b/packages/desktop/src/types/typora-import.d.ts
@@ -0,0 +1,44 @@
+/**
+ * Type surface for the vendored Typora theme transpiler
+ * (`src/main/typoraTheme/typora-import/index.mjs`).
+ *
+ * The pipeline is plain JS carried over verbatim from the Reversion tooling
+ * repo and `allowJs` is off, so the parts the app actually calls are declared
+ * here rather than by converting 2 000+ lines of upstream-owned source to TS.
+ * `stats` carries many more fields; only the ones the import flow reports back
+ * to the user are declared.
+ */
+declare module '*/typora-import/index.mjs' {
+  export interface TyporaTranslationStats {
+    sourceRules: number
+    distinctSelectors: number
+    strippedSelectors: number
+    eitherMapped: number
+    neitherMapped: number
+    sourceVariables: number
+    mappedVariables: number
+  }
+
+  export interface TyporaTranslation {
+    /** Editor theme CSS, scoped to the `.mu-*` DOM. */
+    editorCss: string
+    /** HTML/PDF export theme CSS, scoped to `.markdown-body`. */
+    exportCss: string
+    /** Markdown compatibility report: dropped rules, unmapped selectors, coverage. */
+    report: string
+    stats: TyporaTranslationStats
+  }
+
+  export function translateTyporaTheme(
+    css: string,
+    options: {
+      themeName: string
+      namespace?: string
+      sourcePath?: string
+      important?: boolean
+      now?: string
+    }
+  ): TyporaTranslation
+
+  export function normaliseNamespace(themeName: string): string
+}
