+      <button
+        class="button"
+        type="button"
+        @click="openFullRelease"
+      >
+        {{ t('update.fullReleaseNotes') }}
+      </button>
+      <button
+        ref="gotItButtonRef"
+        class="button-primary"
+        type="button"
+        @click="markReleaseNotesSeen"
+      >
+        {{ t('update.gotIt') }}
+      </button>
+    </footer>
+  </section>
+</template>
+
+<script setup lang="ts">
+import { computed, nextTick, ref, watch } from 'vue'
+import { storeToRefs } from 'pinia'
+import { useI18n } from 'vue-i18n'
+import { useAutoUpdatesStore } from '@/store/autoUpdates'
+import { useEditorStore } from '@/store/editor'
+import markdownToHtml from '@/util/markdownToHtml'
+
+const { t } = useI18n()
+const updateStore = useAutoUpdatesStore()
+const editorStore = useEditorStore()
+const {
+  phase,
+  version,
+  releaseNotes,
+  progress,
+  errorMessage,
+  collapsed,
+  releaseDialogOpen,
+  percentLabel,
+  transferLabel,
+  speedLabel,
+  remainingDuration,
+  visible
+} = storeToRefs(updateStore)
+const releaseNotesHtml = ref('')
+const gotItButtonRef = ref<HTMLButtonElement | null>(null)
+let releaseDialogPreviousFocus: HTMLElement | null = null
+const remainingLabel = computed(() =>
+  remainingDuration.value
+    .map(({ value, unit }) => t(`update.duration.${unit}`, { count: value }))
+    .join(' ')
+)
+
+const title = computed(() => {
+  if (phase.value === 'available') return t('update.available')
+  if (phase.value === 'downloaded') return t('update.ready')
+  if (phase.value === 'error') return t('update.failed')
+  if (phase.value === 'cancelled') return t('update.cancelled')
+  return t('update.downloading')
+})
+
+watch(
+  releaseNotes,
+  async (notes) => {
+    releaseNotesHtml.value = notes ? await markdownToHtml(notes) : ''
+  },
+  { immediate: true }
+)
+
+const install = (): void => {
+  updateStore.installUpdate(editorStore.GET_UNSAVED_FILES())
+}
+
+const openFullRelease = (): void => {
+  window.electron.ipcRenderer.invoke(
+    'mt::shell::open-external',
+    `https://github.com/mjlens-spec/Reversion/releases/tag/v${version.value}`
+  )
+}
+
+const {
+  startDownload,
+  declineDownload,
+  cancelDownload,
+  retryDownload,
+  markReleaseNotesSeen
+} = updateStore
+
+watch(releaseDialogOpen, async (isOpen) => {
+  if (isOpen) {
+    releaseDialogPreviousFocus = document.activeElement instanceof HTMLElement
+      ? document.activeElement
+      : null
+    await nextTick()
+    if (releaseDialogOpen.value) gotItButtonRef.value?.focus()
+    return
+  }
+
+  const previousFocus = releaseDialogPreviousFocus
+  releaseDialogPreviousFocus = null
+  await nextTick()
+  if (!releaseDialogOpen.value) previousFocus?.focus()
+})
