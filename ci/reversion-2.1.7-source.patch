diff --git a/packages/desktop/src/renderer/src/components/sideBar/contextTree.ts b/packages/desktop/src/renderer/src/components/sideBar/contextTree.ts
new file mode 100644
index 00000000..6aedfbbc
--- /dev/null
+++ b/packages/desktop/src/renderer/src/components/sideBar/contextTree.ts
@@ -0,0 +1,314 @@
+import type { TreeFileNode, TreeFolderNode } from './types'
+
+/** The small path surface needed by the renderer file explorer. */
+export interface ContextTreePathApi {
+  normalize(pathname: string): string
+  basename(pathname: string): string
+  dirname(pathname: string): string
+  join(...parts: string[]): string
+  isAbsolute(pathname: string): boolean
+  parse?: (pathname: string) => { root: string }
+}
+
+export interface ContextTreeStat {
+  isFile: boolean
+  isDirectory: boolean
+  isSymbolicLink?: boolean
+}
+
+/** The preload APIs are kept behind an injectable interface for unit tests. */
+export interface ContextTreeFs {
+  path: ContextTreePathApi
+  readdir(pathname: string): Promise<string[]>
+  readdirWithTypes?: (pathname: string) => Promise<ContextTreeDirectoryEntry[]>
+  stat(pathname: string): Promise<ContextTreeStat | undefined>
+  lstat?: (pathname: string) => Promise<ContextTreeStat | undefined>
+  isSamePath?: (pathA: string, pathB: string) => boolean
+  hasMarkdownExtension(filename: string): boolean
+}
+
+export interface ContextTreeDirectoryEntry {
+  name: string
+  isFile: boolean
+  isDirectory: boolean
+  isSymbolicLink: boolean
+  isMarkdown?: boolean
+  isOpenable?: boolean
+}
+
+/** A directory entry before it is grouped into a tree node. */
+export interface ContextTreeEntry {
+  name: string
+  pathname: string
+  isDirectory: boolean
+  isFile: boolean
+  isSymbolicLink?: boolean
+  isMarkdown?: boolean
+  isOpenable?: boolean
+  stat?: ContextTreeStat
+}
+
+export interface ContextTreeFileNode extends TreeFileNode {
+  id: string
+  context: true
+}
+
+export interface ContextTreeFolderNode extends TreeFolderNode {
+  id: string
+  context: true
+  folders: ContextTreeFolderNode[]
+  files: ContextTreeFileNode[]
+  loaded: boolean
+  loading: boolean
+  readError: boolean
+  loadPromise?: Promise<void>
+}
+
+export type ContextTreeNode = ContextTreeFolderNode
+
+const MARKDOWN_EXTENSIONS = /\.(?:markdown|mdown|mkdn|md|mkd|mdwn|mdtxt|mdtext|mdx|text|txt)$/i
+
+/** Keep this in sync with preload's MARKDOWN_EXTENSIONS without depending on window in tests. */
+export const isSupportedFileName = (filename: string): boolean =>
+  typeof filename === 'string' && MARKDOWN_EXTENSIONS.test(filename)
+
+/** Directories always precede files; names are stable and numeric-aware. */
+export const compareTreeEntries = (a: ContextTreeEntry, b: ContextTreeEntry): number => {
+  if (a.isDirectory !== b.isDirectory) return a.isDirectory ? -1 : 1
+  const byName = a.name.localeCompare(b.name, undefined, {
+    numeric: true,
+    sensitivity: 'base'
+  })
+  return byName || a.pathname.localeCompare(b.pathname)
+}
+
+export const getParentDirectory = (
+  pathname: string,
+  pathApi: ContextTreePathApi
+): string | null => {
+  const normalized = pathApi.normalize(pathname)
+  if (!normalized) return null
+  const parent = pathApi.normalize(pathApi.dirname(normalized))
+  if (parent === normalized) return null
+  const root = pathApi.parse?.(normalized).root
+  if (root && pathApi.normalize(root) === normalized) return null
+  // `pathe` normalizes Windows UNC paths to slash-separated strings and
+  // reports `/` as their parse root. Preserve the share root explicitly so
+  // navigating up from `//server/share` never escapes to `//server`.
+  if (/^\/\/[^/]+\/[^/]+\/?$/.test(normalized)) return null
+  return parent
+}
+
+const arePathsEqual = (
+  pathA: string,
+  pathB: string,
+  pathApi: ContextTreePathApi,
+  isSamePath?: (left: string, right: string) => boolean
+): boolean => {
+  if (isSamePath) return isSamePath(pathA, pathB)
+  return pathApi.normalize(pathA) === pathApi.normalize(pathB)
+}
+
+const makeFolderNode = (
+  pathname: string,
+  pathApi: ContextTreePathApi,
+  isSymbolicLink = false
+): ContextTreeFolderNode => ({
+  id: `context:${pathname}`,
+  context: true,
+  pathname,
+  name: pathApi.basename(pathname) || pathname,
+  isCollapsed: true,
+  isDirectory: true,
+  isFile: false,
+  isMarkdown: false,
+  ...(isSymbolicLink ? { isSymbolicLink: true } : {}),
+  folders: [],
+  files: [],
+  loaded: isSymbolicLink,
+  loading: false,
+  readError: false
+})
+
+const makeFileNode = (
+  pathname: string,
+  name: string,
+  isMarkdown: boolean,
+  isSymbolicLink = false,
+  isOpenable = isMarkdown
+): ContextTreeFileNode => ({
+  id: `context:${pathname}`,
+  context: true,
+  pathname,
+  name,
+  isDirectory: false,
+  isFile: true,
+  isMarkdown,
+  isOpenable,
+  ...(isSymbolicLink ? { isSymbolicLink: true } : {})
+})
+
+/**
+ * A lazily-read tree used only when no explicit project folder is open.
+ *
+ * It deliberately owns no Pinia state. A generation is incremented whenever
+ * the root changes, so a slow readdir/stat response from an old root cannot
+ * replace the current root.
+ */
+export class ContextTreeController {
+  readonly fs: ContextTreeFs
+  readonly currentFilePath: string | null
+  root: ContextTreeNode | null = null
+  private generation = 0
+
+  constructor(fs: ContextTreeFs, currentFilePath: string | null = null) {
+    this.fs = fs
+    this.currentFilePath = currentFilePath
+  }
+
+  async setRoot(pathname: string): Promise<ContextTreeNode | null> {
+    const normalized = this.fs.path.normalize(pathname)
+    if (!normalized || !this.fs.path.isAbsolute(normalized)) {
+      this.generation++
+      this.root = null
+      return null
+    }
+
+    if (this.root && arePathsEqual(this.root.pathname, normalized, this.fs.path, this.fs.isSamePath)) {
+      // A tab switch can arrive while the first tab's directory is still
+      // loading. Wait for that shared request so the second caller never
+      // renders the same root as a permanently empty tree.
+      if (this.root.loadPromise) await this.root.loadPromise
+      return this.root
+    }
+
+    const generation = ++this.generation
+    const nextRoot = makeFolderNode(normalized, this.fs.path)
+    this.root = nextRoot
+    await this.loadNode(nextRoot)
+
+    // A newer setRoot call owns the visible root. The stale node is returned
+    // for callers that need to finish their own bookkeeping, but is never
+    // assigned over the current root.
+    return this.generation === generation ? nextRoot : this.root
+  }
+
+  async setRootForFile(pathname: string | null): Promise<ContextTreeNode | null> {
+    if (!pathname) {
+      this.generation++
+      this.root = null
+      return null
+    }
+    return this.setRoot(this.fs.path.dirname(pathname))
+  }
+
+  async expand(node: ContextTreeFolderNode): Promise<ContextTreeFolderNode> {
+    if (node.isSymbolicLink) return node
+    await this.loadNode(node)
+    return node
+  }
+
+  async moveUp(): Promise<ContextTreeNode | null> {
+    const parent = this.root ? getParentDirectory(this.root.pathname, this.fs.path) : null
+    if (!parent) return this.root
+    return this.setRoot(parent)
+  }
+
+  private async loadNode(node: ContextTreeFolderNode): Promise<void> {
+    if (node.loaded && !node.readError) return
+    if (node.loadPromise) return node.loadPromise
+
+    node.loading = true
+    const request = (async() => {
+      try {
+        const entries: ContextTreeEntry[] = []
+        const batchedEntries = this.fs.readdirWithTypes
+          ? await this.fs.readdirWithTypes(node.pathname)
+          : null
+
+        if (batchedEntries) {
+          for (const entry of batchedEntries) {
+            const isDirectory = !!entry.isDirectory
+            const isFile = !!entry.isFile || (!isDirectory && entry.isSymbolicLink)
+            if (!isDirectory && !isFile && !entry.isSymbolicLink) continue
+            entries.push({
+              name: entry.name,
+              pathname: this.fs.path.join(node.pathname, entry.name),
+              isDirectory,
+              isFile,
+              isSymbolicLink: entry.isSymbolicLink,
+              isMarkdown: entry.isMarkdown,
+              isOpenable: entry.isOpenable
+            })
+          }
+        } else {
+          const names = await this.fs.readdir(node.pathname)
+          const stat = this.fs.lstat ?? this.fs.stat
+          const maxConcurrent = 32
+          for (let offset = 0; offset < names.length; offset += maxConcurrent) {
+            const batch = names.slice(offset, offset + maxConcurrent)
+            await Promise.all(batch.map(async(name) => {
+              const pathname = this.fs.path.join(node.pathname, name)
+              try {
+                const info = await stat(pathname)
+                const isSymbolicLink = !!info?.isSymbolicLink
+                const isDirectory = !!info?.isDirectory
+                const isFile = !!info?.isFile || (!isDirectory && isSymbolicLink) || (!info && !isDirectory)
+                if (!isDirectory && !isFile) return
+                const isMarkdown = this.fs.hasMarkdownExtension(name) || isSupportedFileName(name)
+                entries.push({
+                  name,
+                  pathname,
+                  isDirectory,
+                  isFile,
+                  isSymbolicLink,
+                  isMarkdown,
+                  isOpenable: isMarkdown,
+                  stat: info
+                })
+              } catch {
+                // A deleted or inaccessible child should not make its siblings
+                // disappear. The next explicit expansion can retry the directory.
+              }
+            }))
+          }
+        }
+
+        entries.sort(compareTreeEntries)
+        const folders: ContextTreeFolderNode[] = []
+        const files: ContextTreeFileNode[] = []
+        for (const entry of entries) {
+          if (entry.isDirectory) {
+            // Symbolic-link directories are visible, but expand() deliberately
+            // leaves them closed so a link cycle cannot recurse forever.
+            folders.push(makeFolderNode(entry.pathname, this.fs.path, entry.isSymbolicLink))
+          } else {
+            files.push(makeFileNode(
+              entry.pathname,
+              entry.name,
+              entry.isMarkdown ?? (this.fs.hasMarkdownExtension(entry.name) || isSupportedFileName(entry.name)),
+              entry.isSymbolicLink,
+              entry.isOpenable ?? entry.isMarkdown ?? (this.fs.hasMarkdownExtension(entry.name) || isSupportedFileName(entry.name))
+            ))
+          }
+        }
+
+        node.folders = folders
+        node.files = files
+        node.readError = false
+      } catch {
+        // Failure is a safe empty state, with an explicit marker for the UI.
+        node.folders = []
+        node.files = []
+        node.readError = true
+      } finally {
+        node.loaded = !node.readError
+        node.loading = false
+        node.loadPromise = undefined
+      }
+    })()
+
+    node.loadPromise = request
+    await request
+  }
+}
