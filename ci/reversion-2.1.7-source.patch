+import { describe, it, expect } from 'vitest'
+import path from 'path'
+import { buildDocxConversion } from '../../../src/main/utils/docxExport'
+import { EXTENSION_HASN } from '../../../src/main/config'
+
+describe('docx export', () => {
+  it('registers the .docx extension for the save dialog', () => {
+    expect((EXTENSION_HASN as Record<string, string>).docx).toBe('.docx')
+  })
+
+  it('passes the markdown through untouched when there is no TOC marker', () => {
+    const markdown = '# Title\n\nBody text with [a link](./other.md).\n'
+    const { input, extraArgs } = buildDocxConversion(markdown, undefined)
+
+    expect(input).toBe(markdown)
+    expect(extraArgs).toEqual(['--standalone'])
+  })
+
+  it('replaces a [TOC] marker with pandoc\'s own table of contents', () => {
+    const { input, extraArgs } = buildDocxConversion('# Title\n\n[TOC]\n\nBody\n', undefined)
+
+    expect(input).not.toContain('[TOC]')
+    expect(input).toContain('# Title')
+    expect(input).toContain('Body')
+    expect(extraArgs).toContain('--toc')
+  })
+
+  it('leaves an inline [TOC] alone — only a standalone line is the marker', () => {
+    const markdown = 'The [TOC] marker must sit on its own line.\n'
+    const { input, extraArgs } = buildDocxConversion(markdown, undefined)
+
+    expect(input).toBe(markdown)
+    expect(extraArgs).not.toContain('--toc')
+  })
+
+  it('resolves relative images against the document folder', () => {
+    const documentPath = path.join(path.sep, 'Users', 'someone', 'notes', 'article.md')
+    const { extraArgs } = buildDocxConversion('![img](./assets/a.png)\n', documentPath)
+
+    const flagIndex = extraArgs.indexOf('--resource-path')
+    expect(flagIndex).toBeGreaterThanOrEqual(0)
+    expect(extraArgs[flagIndex + 1]).toBe(path.dirname(documentPath))
+  })
+
+  it('omits --resource-path for a document that was never saved', () => {
+    const { extraArgs } = buildDocxConversion('# Untitled\n', undefined)
+
+    expect(extraArgs).not.toContain('--resource-path')
+  })
+})
diff --git a/packages/desktop/test/unit/specs/export-png-stream.spec.ts b/packages/desktop/test/unit/specs/export-png-stream.spec.ts
new file mode 100644
index 00000000..d0d45dac
--- /dev/null
+++ b/packages/desktop/test/unit/specs/export-png-stream.spec.ts
@@ -0,0 +1,174 @@
+import { describe, it, expect, beforeEach, afterEach } from 'vitest'
+import { promises as fs } from 'fs'
+import os from 'os'
+import path from 'path'
+import zlib from 'zlib'
+import { PngRowWriter, bgraToRgba } from '../../../src/main/exportImage/pngStream'
+
+const PNG_SIGNATURE = Buffer.from([0x89, 0x50, 0x4e, 0x47, 0x0d, 0x0a, 0x1a, 0x0a])
+
+interface DecodedPng {
+  width: number
+  height: number
+  /** Row-major RGBA, 4 bytes per pixel, no padding. */
+  pixels: Buffer
+}
+
+// Minimal decoder for the 8-bit RGBA, non-interlaced PNGs this writer emits —
+// enough to prove the bytes on disk really describe the intended image.
+const decodePng = (file: Buffer): DecodedPng => {
+  expect(file.subarray(0, 8)).toEqual(PNG_SIGNATURE)
+
+  let offset = 8
+  let width = 0
+  let height = 0
+  const idat: Buffer[] = []
+  let sawEnd = false
+
+  while (offset < file.length) {
+    const length = file.readUInt32BE(offset)
+    const type = file.toString('ascii', offset + 4, offset + 8)
+    const data = file.subarray(offset + 8, offset + 8 + length)
+    if (type === 'IHDR') {
+      width = data.readUInt32BE(0)
+      height = data.readUInt32BE(4)
+      expect(data[8]).toBe(8) // bit depth
+      expect(data[9]).toBe(6) // RGBA
+      expect(data[12]).toBe(0) // not interlaced
+    } else if (type === 'IDAT') {
+      idat.push(data)
+    } else if (type === 'IEND') {
+      sawEnd = true
+    }
+    offset += 12 + length
+  }
+  expect(sawEnd).toBe(true)
+
+  const raw = zlib.inflateSync(Buffer.concat(idat))
+  const stride = width * 4
+  const pixels = Buffer.alloc(stride * height)
+  for (let row = 0; row < height; row++) {
+    const filter = raw[row * (stride + 1)]
+    const src = row * (stride + 1) + 1
+    const dst = row * stride
+    for (let i = 0; i < stride; i++) {
+      const value = raw[src + i]!
+      // Only the two filters the writer uses are implemented.
+      if (filter === 0) {
+        pixels[dst + i] = value
+      } else if (filter === 2) {
+        pixels[dst + i] = (value + pixels[dst - stride + i]!) & 0xff
+      } else {
+        throw new Error(`Unexpected PNG filter ${filter} on row ${row}`)
+      }
+    }
+  }
+  return { width, height, pixels }
+}
+
+// A band whose every pixel encodes its own absolute row, so a swapped,
+// duplicated or dropped band shows up as a wrong pixel value rather than as a
+// merely plausible image.
+const band = (width: number, firstRow: number, rowCount: number): Buffer => {
+  const buf = Buffer.alloc(width * rowCount * 4)
+  for (let row = 0; row < rowCount; row++) {
+    for (let x = 0; x < width; x++) {
+      const at = (row * width + x) * 4
+      buf[at] = (firstRow + row) & 0xff
+      buf[at + 1] = x & 0xff
+      buf[at + 2] = 0x40
+      buf[at + 3] = 0xff
+    }
+  }
+  return buf
+}
+
+describe('PngRowWriter', () => {
+  let dir: string
+  let file: string
+
+  beforeEach(async() => {
+    dir = await fs.mkdtemp(path.join(os.tmpdir(), 'png-stream-test-'))
+    file = path.join(dir, 'out.png')
+  })
+
+  afterEach(async() => {
+    await fs.rm(dir, { recursive: true, force: true })
+  })
+
+  it('writes an image assembled from several bands', async() => {
+    const width = 7
+    const writer = new PngRowWriter({ width, height: 10, outputPath: file })
+    await writer.writeBand(band(width, 0, 4), 4)
+    await writer.writeBand(band(width, 4, 4), 4)
+    await writer.writeBand(band(width, 8, 2), 2)
+    await writer.finish()
+
+    const decoded = decodePng(await fs.readFile(file))
+    expect(decoded.width).toBe(width)
+    expect(decoded.height).toBe(10)
+
+    for (let row = 0; row < 10; row++) {
+      for (let x = 0; x < width; x++) {
+        const at = (row * width + x) * 4
+        expect([decoded.pixels[at], decoded.pixels[at + 1], decoded.pixels[at + 3]]).toEqual([
+          row,
+          x,
+          0xff
+        ])
+      }
+    }
+  })
+
+  it('produces the same image whether written in one band or many', async() => {
+    const width = 5
+    const single = new PngRowWriter({ width, height: 9, outputPath: file })
+    await single.writeBand(band(width, 0, 9), 9)
+    await single.finish()
+    const wholeImage = decodePng(await fs.readFile(file))
+
+    const splitPath = path.join(dir, 'split.png')
+    const split = new PngRowWriter({ width, height: 9, outputPath: splitPath })
+    await split.writeBand(band(width, 0, 1), 1)
+    await split.writeBand(band(width, 1, 5), 5)
+    await split.writeBand(band(width, 6, 3), 3)
+    await split.finish()
+
+    expect(decodePng(await fs.readFile(splitPath)).pixels).toEqual(wholeImage.pixels)
+  })
+
+  it('refuses to finish a short image rather than writing a truncated file', async() => {
+    const writer = new PngRowWriter({ width: 4, height: 6, outputPath: file })
+    await writer.writeBand(band(4, 0, 3), 3)
+
+    await expect(writer.finish()).rejects.toThrow(/wrote 3 of 6 rows/)
+  })
+
+  it('rejects a band that would run past the declared height', async() => {
+    const writer = new PngRowWriter({ width: 4, height: 3, outputPath: file })
+
+    await expect(writer.writeBand(band(4, 0, 4), 4)).rejects.toThrow(/exceed the declared height/)
+    writer.abort()
+  })
+
+  it('rejects a band that is smaller than the rows it claims to hold', async() => {
+    const writer = new PngRowWriter({ width: 8, height: 4, outputPath: file })
+
+    await expect(writer.writeBand(Buffer.alloc(8 * 4), 4)).rejects.toThrow(/expected at least/)
+    writer.abort()
+  })
+
+  it('rejects non-positive dimensions', () => {
+    expect(() => new PngRowWriter({ width: 0, height: 4, outputPath: file })).toThrow(
+      /Invalid PNG dimensions/
+    )
+  })
+})
+
+describe('bgraToRgba', () => {
+  it('swaps the blue and red channels a native bitmap arrives in', () => {
+    const bitmap = Buffer.from([10, 20, 30, 40, 50, 60, 70, 80])
+
+    expect([...bgraToRgba(bitmap)]).toEqual([30, 20, 10, 40, 70, 60, 50, 80])
+  })
+})
