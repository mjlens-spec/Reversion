+import { expect, test } from '@playwright/test'
+import type { ElectronApplication, Page } from 'playwright'
+import * as fs from 'node:fs'
+import * as os from 'node:os'
+import * as path from 'node:path'
+import { launchElectron, waitForEditor } from './helpers'
+
+test.describe('title bar file context', () => {
+  let app: ElectronApplication
+  let page: Page
+  let fixtureRoot = ''
+
+  test.beforeAll(async() => {
+    fixtureRoot = fs.mkdtempSync(path.join(os.tmpdir(), 'reversion-titlebar-'))
+    const directory = path.join(
+      fixtureRoot,
+      '联合利华',
+      '2607_OLLY_Y27_IMC',
+      '02_策略与创意'
+    )
+    fs.mkdirSync(directory, { recursive: true })
+    const filePath = path.join(directory, 'OLLY Y11代言人营销方案评审.md')
+    fs.writeFileSync(filePath, '# Title bar fixture\n', 'utf8')
+
+    const launched = await launchElectron([filePath], { singleFile: true })
+    app = launched.app
+    page = launched.page
+    await waitForEditor(page)
+  })
+
+  test.afterAll(async() => {
+    if (app) await app.close()
+    if (fixtureRoot) fs.rmSync(fixtureRoot, { recursive: true, force: true })
+  })
+
+  test('shows the bold extensionless filename before a muted three-level directory label', async() => {
+    const title = page.locator('.title-bar .document-title')
+    const filename = title.locator('.document-name')
+    const directory = title.locator('.directory-pill')
+
+    await expect(filename).toHaveText('OLLY Y11代言人营销方案评审')
+    await expect(directory.locator('.directory-name')).toHaveText([
+      '联合利华',
+      '2607_OLLY_Y27_IMC',
+      '02_策略与创意'
+    ])
+    await expect(title.locator('.save-dot')).toBeHidden()
+
+    const filenameBox = await filename.boundingBox()
+    const directoryBox = await directory.boundingBox()
+    expect(filenameBox).not.toBeNull()
+    expect(directoryBox).not.toBeNull()
+    if (!filenameBox || !directoryBox) throw new Error('Title bar elements are not laid out')
+    const titleGap = directoryBox.x - (filenameBox.x + filenameBox.width)
+    expect(titleGap).toBeGreaterThanOrEqual(7)
+    expect(titleGap).toBeLessThanOrEqual(9)
+
+    const styles = await page.evaluate(() => {
+      const name = document.querySelector('.title-bar .document-name')
+      const pill = document.querySelector('.title-bar .directory-pill')
+      if (!name || !pill) return null
+      const nameStyle = getComputedStyle(name)
+      const pillStyle = getComputedStyle(pill)
+      return {
+        filenameWeight: Number(nameStyle.fontWeight),
+        pillBackground: pillStyle.backgroundColor,
+        pillRadius: pillStyle.borderRadius
+      }
+    })
+
+    expect(styles).not.toBeNull()
+    expect(styles?.filenameWeight).toBeGreaterThanOrEqual(600)
+    expect(styles?.pillBackground).not.toBe('rgba(0, 0, 0, 0)')
+    expect(styles?.pillRadius).toBe('7px')
+  })
+})
