+import { expect, test } from '@playwright/test'
+import type { ElectronApplication, Page } from 'playwright'
+import { launchWithMarkdown } from './helpers'
+
+test.describe('approved workspace layout placement', () => {
+  let app: ElectronApplication
+  let page: Page
+
+  test.beforeAll(async() => {
+    const launched = await launchWithMarkdown('# Layout\n\n## Section\n\nBody.\n', {
+      singleFile: true
+    })
+    app = launched.app
+    page = launched.page
+    await page.waitForSelector('.editor-middle', { state: 'visible', timeout: 5000 })
+    await page.waitForSelector('.side-bar', { state: 'visible', timeout: 5000 })
+  })
+
+  test.afterAll(async() => {
+    if (app) await app.close()
+  })
+
+  test('aligns the header, title, sidebar control, and bottom tabs', async() => {
+    await expect(page.locator('.side-bar .workspace-sidebar-toggle')).toBeVisible()
+    await expect(page.locator('.title-bar .collapsed-sidebar-toggle')).toBeHidden()
+    await expect(page.locator('.workspace-bar .workspace-sidebar-toggle')).toHaveCount(0)
+    await expect(page.locator('.editor-bottom-tabs .editor-tabs')).toBeVisible()
+    await expect(page.locator('.workspace-bar .editor-tabs')).toHaveCount(0)
+
+    const metrics = await page.evaluate(() => {
+      const rect = (selector: string) => {
+        const element = document.querySelector(selector)
+        if (!element) throw new Error(`Missing layout element: ${selector}`)
+        return element.getBoundingClientRect()
+      }
+      const sidebarHeader = rect('.side-bar .left-column')
+      const editorHeader = rect('.editor-header')
+      const editorMiddle = rect('.editor-middle')
+      const workspaceBar = rect('.workspace-bar')
+      const title = rect('.title-bar .document-title')
+      const bottomTabs = rect('.editor-bottom-tabs')
+      const sidebarFooter = rect('.side-bar .sidebar-footer')
+      const tocTitle = document.querySelector('.side-bar-toc .title')
+
+      return {
+        topDividerDelta: Math.abs(sidebarHeader.bottom - editorHeader.bottom),
+        titleCenterXDelta: Math.abs(
+          title.left + title.width / 2 - (editorMiddle.left + editorMiddle.width / 2)
+        ),
+        titleCenterYDelta: Math.abs(
+          title.top + title.height / 2 - (workspaceBar.top + workspaceBar.height / 2)
+        ),
+        bottomEdgeDelta: Math.abs(bottomTabs.bottom - window.innerHeight),
+        bottomDividerDelta: Math.abs(bottomTabs.top - sidebarFooter.top),
+        tocTitleMarginTop: tocTitle ? getComputedStyle(tocTitle).marginTop : null
+      }
+    })
+
+    expect(metrics.topDividerDelta).toBeLessThanOrEqual(1)
+    expect(metrics.titleCenterXDelta).toBeLessThanOrEqual(1)
+    expect(metrics.titleCenterYDelta).toBeLessThanOrEqual(1)
+    expect(metrics.bottomEdgeDelta).toBeLessThanOrEqual(1)
+    expect(metrics.bottomDividerDelta).toBeLessThanOrEqual(1)
+    expect(metrics.tocTitleMarginTop).toBe('29px')
+  })
+})
diff --git a/packages/desktop/test/unit/setup.ts b/packages/desktop/test/unit/setup.ts
new file mode 100644
index 00000000..2806206d
--- /dev/null
+++ b/packages/desktop/test/unit/setup.ts
@@ -0,0 +1,59 @@
+// Restore `localStorage` for the jsdom environment.
+//
+// Node 24 ships its own `localStorage` global that stays `undefined` unless the
+// process is started with `--localstorage-file` (it warns as much on first
+// access). Vitest's jsdom environment sees the name already defined on
+// globalThis and leaves it alone, so neither `window.localStorage` nor the bare
+// global resolves — while `sessionStorage`, which Node does not define, comes
+// through from jsdom normally.
+//
+// Twelve spec files import renderer modules that read `localStorage` at module
+// scope (`store/layout.ts` is the common one), so they threw during import and
+// contributed no tests at all — the suite reported a smaller total rather than
+// a failure anyone would read as one. Install a spec-local Storage so those
+// files load again.
+//
+// Drop this once Vitest's jsdom environment overrides Node's placeholder.
+class MemoryStorage implements Storage {
+  private _entries = new Map<string, string>()
+
+  get length(): number {
+    return this._entries.size
+  }
+
+  key(index: number): string | null {
+    return [...this._entries.keys()][index] ?? null
+  }
+
+  getItem(key: string): string | null {
+    return this._entries.get(String(key)) ?? null
+  }
+
+  setItem(key: string, value: string): void {
+    this._entries.set(String(key), String(value))
+  }
+
+  removeItem(key: string): void {
+    this._entries.delete(String(key))
+  }
+
+  clear(): void {
+    this._entries.clear()
+  }
+}
+
+const target = globalThis as typeof globalThis & { localStorage?: Storage; window?: Window }
+
+if (!target.localStorage) {
+  const storage = new MemoryStorage()
+  Object.defineProperty(target, 'localStorage', {
+    configurable: true,
+    value: storage
+  })
+  if (target.window && !target.window.localStorage) {
+    Object.defineProperty(target.window, 'localStorage', {
+      configurable: true,
+      value: storage
+    })
+  }
+}
