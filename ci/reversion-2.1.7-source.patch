+  }
+
+  .mu-container em {
+    color: var(--claude-accent-dark) !important;
+  }
+
+  .mu-container blockquote {
+    margin: 1em 0 !important;
+    /* Single-line quote keeps roughly one line-height of air above and
+       below the text (margin + padding + inner paragraph margin). */
+    padding: 10px 22px !important;
+    border-left: 4px solid var(--claude-line-strong) !important;
+    border-radius: 0 6px 6px 0 !important;
+    background: var(--claude-surface-muted) !important;
+    color: var(--claude-text-muted) !important;
