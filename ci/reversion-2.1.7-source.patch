@@ -0,0 +1,51 @@
+export const formatBytes = (bytes: number): string => {
+  if (!Number.isFinite(bytes) || bytes <= 0) return '0 B'
+  const units = ['B', 'KB', 'MB', 'GB']
+  const unitIndex = Math.min(Math.floor(Math.log(bytes) / Math.log(1024)), units.length - 1)
+  const value = bytes / 1024 ** unitIndex
+  return `${value >= 10 || unitIndex === 0 ? value.toFixed(0) : value.toFixed(1)} ${units[unitIndex]}`
+}
+
+export type DurationUnit = 'second' | 'minute' | 'hour'
+
+export interface DurationPart {
+  value: number
+  unit: DurationUnit
+}
+
+export const durationParts = (seconds: number): DurationPart[] => {
+  if (!Number.isFinite(seconds) || seconds <= 0) return []
+  if (seconds < 60) return [{ value: Math.ceil(seconds), unit: 'second' }]
+  const minutes = Math.ceil(seconds / 60)
+  if (minutes < 60) return [{ value: minutes, unit: 'minute' }]
+  const hours = Math.floor(minutes / 60)
+  const remainder = minutes % 60
+  return [
+    { value: hours, unit: 'hour' },
+    ...(remainder ? [{ value: remainder, unit: 'minute' } as const] : [])
+  ]
+}
+
+export const estimateRemainingSeconds = (
+  total: number,
+  transferred: number,
+  bytesPerSecond: number
+): number => {
+  if (bytesPerSecond <= 0 || total <= transferred) return 0
+  return (total - transferred) / bytesPerSecond
+}
+
+export const normalizeReleaseNotes = (notes: unknown): string => {
+  if (typeof notes === 'string') return notes
+  if (Array.isArray(notes)) {
+    return notes
+      .map((entry) => {
+        if (typeof entry === 'string') return entry
+        if (entry && typeof entry === 'object' && 'note' in entry) return String(entry.note ?? '')
+        return ''
+      })
+      .filter(Boolean)
+      .join('\n\n')
+  }
+  return ''
+}
diff --git a/packages/desktop/src/renderer/src/util/readingFonts.ts b/packages/desktop/src/renderer/src/util/readingFonts.ts
new file mode 100644
index 00000000..a129333c
--- /dev/null
+++ b/packages/desktop/src/renderer/src/util/readingFonts.ts
@@ -0,0 +1,123 @@
+export type ReadingFontSlot = 'title' | 'heading' | 'body'
+
+export interface ReadingFontStacks {
+  title: string
+  heading: string
+  body: string
+}
+
+export interface ReadingFontPreferences {
+  westernBodyFont: string
+  cjkFont: string
+}
+
+export type FontCoverageCheck = (family: string) => boolean | Promise<boolean>
+
+const THEME_SENTINEL = 'theme'
+const GENERIC_FAMILIES = new Set([
+  'serif',
+  'sans-serif',
+  'monospace',
+  'cursive',
+  'fantasy',
+  'system-ui',
+  'ui-serif',
+  'ui-sans-serif',
+  'ui-monospace',
+  'ui-rounded',
+  'emoji',
+  'math',
+  'fangsong'
+])
+
+const stripFamilyQuotes = (family: string): string => {
+  const trimmed = family.trim()
+  if (
+    trimmed.length >= 2 &&
+    ((trimmed.startsWith('"') && trimmed.endsWith('"')) ||
+      (trimmed.startsWith("'") && trimmed.endsWith("'")))
+  ) {
+    return trimmed.slice(1, -1)
+  }
+  return trimmed
+}
+
+export const quoteUserFontFamily = (family: string): string => {
+  const normalized = stripFamilyQuotes(family).replace(/"/g, '\\"')
+  return /\s|[^\p{ASCII}]/u.test(normalized) ? `"${normalized}"` : normalized
+}
+
+const prependFamily = (stack: string, family: string): string =>
+  stack ? `${quoteUserFontFamily(family)}, ${stack}` : quoteUserFontFamily(family)
+
+const appendFamily = (stack: string, family: string): string =>
+  stack ? `${stack}, ${quoteUserFontFamily(family)}` : quoteUserFontFamily(family)
+
+export const composeReadingFontStacks = (
+  themeStacks: ReadingFontStacks,
+  preferences: ReadingFontPreferences
+): ReadingFontStacks => {
+  if (
+    preferences.westernBodyFont === THEME_SENTINEL &&
+    preferences.cjkFont === THEME_SENTINEL
+  ) {
+    return { ...themeStacks }
+  }
+
+  const result: ReadingFontStacks = { ...themeStacks }
+  if (preferences.westernBodyFont !== THEME_SENTINEL) {
+    result.body = prependFamily(result.body, preferences.westernBodyFont)
+  }
+  if (preferences.cjkFont !== THEME_SENTINEL) {
+    result.title = appendFamily(result.title, preferences.cjkFont)
+    result.heading = appendFamily(result.heading, preferences.cjkFont)
+    result.body = appendFamily(result.body, preferences.cjkFont)
+  }
+  return result
+}
+
+export const createReadingFontOverrideCss = (stacks: ReadingFontStacks): string =>
+  ':root {\n' +
+  `  --editor-title-font-family: ${stacks.title};\n` +
+  `  --editor-heading-font-family: ${stacks.heading};\n` +
+  `  --editor-body-font-family: ${stacks.body};\n` +
+  '}'
+
+export const parseFontFamilyStack = (stack: string): string[] => {
+  const families: string[] = []
+  let current = ''
+  let quote = ''
+
+  for (const char of stack) {
+    if ((char === '"' || char === "'") && (!quote || quote === char)) {
+      quote = quote ? '' : char
+      current += char
+      continue
+    }
+    if (char === ',' && !quote) {
+      const family = stripFamilyQuotes(current)
+      if (family) families.push(family)
+      current = ''
+      continue
+    }
+    current += char
+  }
+
+  const family = stripFamilyQuotes(current)
+  if (family) families.push(family)
+  return families
+}
+
+export const resolveEffectiveCjkFont = async(
+  stack: string,
+  check: FontCoverageCheck
+): Promise<string | null> => {
+  for (const family of parseFontFamilyStack(stack)) {
+    if (GENERIC_FAMILIES.has(family.toLowerCase())) continue
+    if (await check(family)) return family
+  }
+  return null
+}
+
+export const browserCjkFontCheck: FontCoverageCheck = (family) =>
+  document.fonts.check(`16px ${quoteUserFontFamily(family)}`, '中')
