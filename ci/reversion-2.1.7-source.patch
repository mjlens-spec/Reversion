@@ -0,0 +1,51 @@
+import { expect, test } from '../fixtures/muya';
+import { getMarkdown } from '../helpers/api';
+import { editor } from '../helpers/selectors';
+
+/**
+ * Alt+Up / Alt+Down reorders the row holding the caret. The drag handle
+ * already did this, but only with a mouse and only for whoever found it.
+ */
+const TABLE = '| h1 | h2 |\n| --- | --- |\n| a1 | a2 |\n| b1 | b2 |\n';
+
+test.describe('Alt+Arrow moves a table row', () => {
+    test('Alt+Down swaps the row with the one below it', async ({ page }) => {
+        await page.evaluate(md => window.muya!.setContent(md), TABLE);
+        await page.locator(`${editor.table} tr`).nth(1).locator('td').first().click();
+        await page.keyboard.press('Alt+ArrowDown');
+
+        await expect.poll(() => getMarkdown(page)).toMatch(/\| b1[\s\S]*\| a1/);
+    });
+
+    test('Alt+Up swaps the row with the one above it', async ({ page }) => {
+        await page.evaluate(md => window.muya!.setContent(md), TABLE);
+        await page.locator(`${editor.table} tr`).nth(2).locator('td').first().click();
+        await page.keyboard.press('Alt+ArrowUp');
+
+        await expect.poll(() => getMarkdown(page)).toMatch(/\| b1[\s\S]*\| a1/);
+    });
+
+    // GFM has no header-less table, so displacing row 0 would relabel the
+    // columns. The chord is still swallowed rather than moving the caret.
+    test('the header row does not move, and nothing is displaced into it', async ({ page }) => {
+        await page.evaluate(md => window.muya!.setContent(md), TABLE);
+
+        await page.locator(`${editor.table} tr`).first().locator('td').first().click();
+        await page.keyboard.press('Alt+ArrowDown');
+        expect(await getMarkdown(page)).toMatch(/\| h1[\s\S]*\| a1[\s\S]*\| b1/);
+
+        await page.locator(`${editor.table} tr`).nth(1).locator('td').first().click();
+        await page.keyboard.press('Alt+ArrowUp');
+        expect(await getMarkdown(page)).toMatch(/\| h1[\s\S]*\| a1[\s\S]*\| b1/);
+    });
+
+    test('the caret follows the moved row', async ({ page }) => {
+        await page.evaluate(md => window.muya!.setContent(md), TABLE);
+        await page.locator(`${editor.table} tr`).nth(1).locator('td').nth(1).click();
+        await page.keyboard.press('Alt+ArrowDown');
+        await page.keyboard.type('!');
+
+        // The caret stayed in the moved row's second cell, which is now row 2.
+        await expect.poll(() => getMarkdown(page)).toContain('a2!');
+    });
+});
