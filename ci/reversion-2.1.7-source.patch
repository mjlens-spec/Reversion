diff --git a/packages/muya/e2e/tests/inline/live-render-contract.spec.ts b/packages/muya/e2e/tests/inline/live-render-contract.spec.ts
new file mode 100644
index 00000000..1bdfdf87
--- /dev/null
+++ b/packages/muya/e2e/tests/inline/live-render-contract.spec.ts
@@ -0,0 +1,124 @@
+import type { Page } from '@playwright/test';
+import { expect, test } from '../fixtures/muya';
+import { editor } from '../helpers/selectors';
+
+/**
+ * Inline live-render behaviours that Reversion depends on and did not build.
+ *
+ * The 1.3.0 engine migration to `@muyajs/core` brought these along for free,
+ * which is exactly why they need pinning: nothing in Reversion's own gate
+ * would notice if an upstream rebase regressed them, and they are the core of
+ * what the editor is supposed to feel like. Measured, not assumed — see
+ * `outputs/M2现状实测与1.4.0范围重估_AC_260729.md`.
+ *
+ * Marker collapse itself is already covered by `inline/format-toolbar.spec.ts`
+ * and `inline/marker-arrow-hold.spec.ts`; what those don't pin is that only
+ * ONE token opens at a time, that clicks land on the right character, and that
+ * inline code/math swap by CSS instead of being torn down and rebuilt.
+ */
+
+async function setContent(page: Page, md: string) {
+    await page.evaluate(m => window.muya!.setContent(m), md);
+    await page.locator(editor.paragraph).first().click();
+}
+
+async function setCursor(page: Page, offset: number) {
+    await page.evaluate((o) => {
+        const block = window.muya!.editor.scrollPage!.firstContentInDescendant();
+        block.setCursor(o, o, true);
+    }, offset);
+}
+
+/** Marker spans in the first paragraph, paired with their reveal state. */
+async function markers(page: Page) {
+    return page.evaluate((sel) => {
+        const p = document.querySelector(sel)!;
+        return [...p.querySelectorAll('span[class*="mu-"]')]
+            .filter(n => /mu-hide|mu-gray/.test(n.className))
+            .map(n => ({ text: n.textContent, revealed: /mu-gray/.test(n.className) }));
+    }, editor.paragraph);
+}
+
+async function caretOffset(page: Page): Promise<number | null> {
+    return page.evaluate(() => {
+        const sel = window.muya!.editor.selection.getSelection();
+        return sel ? sel.anchor.offset : null;
+    });
+}
+
+test.describe('inline live render contract', () => {
+    // Reveal is per token, not per paragraph: putting the caret in one inline
+    // run must not strip the rendering off its siblings.
+    test('only the token holding the caret reveals its markers', async ({ page }) => {
+        // `a **bold** c *em* d` — strong spans [2,10], em spans [13,17].
+        await setContent(page, 'a **bold** c *em* d');
+
+        await setCursor(page, 5);
+        expect(await markers(page)).toEqual([
+            { text: '**', revealed: true },
+            { text: '**', revealed: true },
+            { text: '*', revealed: false },
+            { text: '*', revealed: false },
+        ]);
+
+        await setCursor(page, 15);
+        expect(await markers(page)).toEqual([
+            { text: '**', revealed: false },
+            { text: '**', revealed: false },
+            { text: '*', revealed: true },
+            { text: '*', revealed: true },
+        ]);
+
+        await setCursor(page, 0);
+        expect((await markers(page)).every(m => !m.revealed)).toBe(true);
+    });
+
+    // Clicking rendered text has to land on the character under the pointer.
+    // The collapsed markers sit in the same text flow, so an off-by-one here
+    // would put the caret inside a zero-width marker span instead.
+    test('clicking rendered text maps to the right source offset', async ({ page }) => {
+        // `a **bold** c` — the rendered word `bold` covers source offsets 4..8.
+        await setContent(page, 'a **bold** c');
+        const strong = page.locator(`${editor.paragraph} strong.mu-inline-rule`);
+        const box = (await strong.boundingBox())!;
+
+        const observed: number[] = [];
+        for (const fraction of [0.05, 0.3, 0.5, 0.7, 0.95]) {
+            await setCursor(page, 0); // collapse the markers before each click
+            await page.mouse.click(box.x + box.width * fraction, box.y + box.height / 2);
+            observed.push((await caretOffset(page))!);
+        }
+
+        expect(observed).toEqual([4, 5, 6, 7, 8]);
+    });
+
+    // Entering inline code or math must reveal the source WITHOUT tearing the
+    // rendered output down — the KaTeX subtree stays mounted and only its
+    // visibility flips. A rebuild on every caret move is what makes formulas
+    // flicker while editing around them.
+    test('inline code and math swap by visibility, not by rebuild', async ({ page }) => {
+        // `a \`code\` b $x^2$ c` — backticks at 2 and 7, `$` at 10 and 15.
+        await setContent(page, 'a `code` b $x^2$ c');
+        const katex = page.locator(`${editor.paragraph} .katex`);
+        const mathSource = page.locator(`${editor.paragraph} .mu-math > .mu-math-text`);
+
+        await setCursor(page, 0);
+        await expect(katex).toHaveCount(1);
+        await expect(mathSource).toBeHidden();
+        expect((await markers(page)).every(m => !m.revealed)).toBe(true);
+
+        await setCursor(page, 5); // inside the inline code
+        await expect(katex).toHaveCount(1);
+        expect(
+            (await markers(page)).filter(m => m.text === '`').every(m => m.revealed),
+        ).toBe(true);
+        await expect(mathSource).toBeHidden();
+
+        await setCursor(page, 13); // inside the inline math
+        await expect(katex).toHaveCount(1);
+        await expect(mathSource).toBeVisible();
+        expect(
+            (await markers(page)).filter(m => m.text === '$').every(m => m.revealed),
+        ).toBe(true);
+    });
+});
diff --git a/packages/muya/e2e/tests/typing/table-row-move.spec.ts b/packages/muya/e2e/tests/typing/table-row-move.spec.ts
