diff --git a/packages/desktop/src/renderer/src/prefComponents/common/range/normalize.ts b/packages/desktop/src/renderer/src/prefComponents/common/range/normalize.ts
new file mode 100644
index 00000000..3b37e72d
--- /dev/null
+++ b/packages/desktop/src/renderer/src/prefComponents/common/range/normalize.ts
@@ -0,0 +1,36 @@
+// Bound handling for the preferences range control.
+//
+// Every numeric preference this control drives declares a
+// `minimum`/`maximum` in src/main/preferences/schema.json, and the main process
+// refuses writes outside them. Keeping the same bounds authoritative on the
+// renderer side means a value that escapes the declared range can never reach
+// `mt::set-user-preference` — regardless of what el-slider emits, or of what an
+// out-of-range persisted value seeds the control with.
+//
+// Extracted from index.vue so it can be unit tested directly.
+
+export const clampToBounds = (value: number, min?: number, max?: number): number => {
+  let next = value
+  if (typeof min === 'number' && Number.isFinite(min) && next < min) {
+    next = min
+  }
+  if (typeof max === 'number' && Number.isFinite(max) && next > max) {
+    next = max
+  }
+  return next
+}
+
+/**
+ * Returns the in-range number `value` represents, or `undefined` when it cannot
+ * represent one at all.
+ *
+ * `NaN`/`Infinity` are `typeof 'number'` but are not valid JSON Schema numbers,
+ * so finiteness is tested rather than the type alone. el-slider emits an array
+ * in range mode, which this single-value control never wants either.
+ */
+export const normalizeRangeValue = (
+  value: unknown,
+  min?: number,
+  max?: number
+): number | undefined =>
+  typeof value === 'number' && Number.isFinite(value) ? clampToBounds(value, min, max) : undefined
