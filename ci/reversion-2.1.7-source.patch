diff --git a/packages/desktop/test/unit/specs/table-context-menu.spec.ts b/packages/desktop/test/unit/specs/table-context-menu.spec.ts
new file mode 100644
index 00000000..5550e514
--- /dev/null
+++ b/packages/desktop/test/unit/specs/table-context-menu.spec.ts
@@ -0,0 +1,72 @@
+import { describe, expect, it, vi } from 'vitest'
+
+// The editor context menu is assembled in the main process, which has no view
+// of the document. The table group therefore rides on the `isTable` flag the
+// renderer already pushes with every selection change, and the whole group is
+// withheld when the caret is not in a table — a permanently present submenu
+// whose every item no-ops reads as broken.
+//
+// `getContextItems` is module-private, so this drives the exported submenu
+// builder plus a reimplementation-free check that the copy-family items are
+// still found by id once the table group shifts their positions.
+
+vi.mock('electron', () => ({}))
+vi.mock('main_renderer/i18n', () => ({ t: (key: string) => key }))
+
+interface Item {
+  id?: string
+  label?: string
+  type?: string
+  submenu?: Item[]
+}
+
+const EXPECTED_OPERATIONS = [
+  'insertRowAbove',
+  'insertRowBelow',
+  'insertColumnLeft',
+  'insertColumnRight',
+  'removeRow',
+  'removeColumn',
+  'alignColumnLeft',
+  'alignColumnCenter',
+  'alignColumnRight',
+  'copyTableAsMarkdown',
+  'copyTableAsHtml',
+  'removeTable'
+]
+
+async function loadMenuItems() {
+  vi.resetModules()
+  return import('main_renderer/contextMenu/editor/menuItems')
+}
+
+describe('table context menu', () => {
+  it('offers every table operation, in menu order', async() => {
+    const { getTableSubmenu } = await loadMenuItems()
+    const submenu = (getTableSubmenu() as Item).submenu as Item[]
+    const operations = submenu.filter((i) => i.type !== 'separator').map((i) => i.id)
+
+    expect(operations).toEqual(EXPECTED_OPERATIONS.map((op) => `${op}MenuItem`))
+  })
+
+  it('groups the operations without doubling a separator', async() => {
+    const { getTableSubmenu } = await loadMenuItems()
+    const submenu = (getTableSubmenu() as Item).submenu as Item[]
+
+    expect(submenu.some((item, i) =>
+      item.type === 'separator' && submenu[i + 1]?.type === 'separator'
+    )).toBe(false)
+    // A trailing separator would draw a divider under the last item.
+    expect(submenu[submenu.length - 1]?.type).not.toBe('separator')
+  })
+
+  it('labels every item through i18n rather than hard-coded English', async() => {
+    const { getTableSubmenu } = await loadMenuItems()
+    const entry = getTableSubmenu() as Item
+
+    expect(entry.label).toBe('contextMenu.table')
+    for (const item of (entry.submenu as Item[]).filter((i) => i.type !== 'separator')) {
+      expect(item.label).toMatch(/^contextMenu\./)
+    }
+  })
+})
