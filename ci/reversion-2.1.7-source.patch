diff --git a/packages/muya/src/utils/paste.ts b/packages/muya/src/utils/paste.ts
index c71febe8..096d9c16 100644
--- a/packages/muya/src/utils/paste.ts
+++ b/packages/muya/src/utils/paste.ts
@@ -322,3 +322,104 @@ export function getCopyTextType(html: string, text: string, pasteType: PasteType
     else
         return getTextType(text);
 }
+
+/**
+ * Turn a tab- or comma-delimited plain-text clipboard payload into a GFM
+ * table.
+ *
+ * Excel, Numbers and Sheets all put a `text/html` `<table>` in the clipboard
+ * alongside the plain text, so those already arrive as tables via the
+ * HTML→Markdown path. What does not is text copied out of a `.csv`/`.tsv`
+ * file, a terminal, or any editor — that lands verbatim, and rebuilding the
+ * table by hand is exactly the chore the editor should absorb.
+ *
+ * Returns `null` when the payload is not confidently tabular, since a false
+ * positive silently destroys the pasted text's shape.
+ */
+export function delimitedTextToMarkdownTable(text: string): string | null {
+    const lines = text.replace(/\n+$/, '').split('\n');
+    if (lines.length < 2)
+        return null;
+
+    for (const delimiter of ['\t', ','] as const) {
+        const rows = lines.map(line => splitDelimitedLine(line, delimiter));
+        const columns = rows[0].length;
+        if (columns < 2 || rows.some(row => row.length !== columns))
+            continue;
+
+        // A comma is ordinary punctuation, so prose with the right shape
+        // ("one, two\nthree, four") would otherwise become a table. Real CSV
+        // either quotes a field or packs its columns without a space after the
+        // separator; prose does the opposite. Tabs need no such test — they do
+        // not occur in running prose.
+        if (delimiter === ',' && !/"/.test(text) && lines.some(line => line.includes(', ')))
+            continue;
+
+        return renderMarkdownTable(rows);
+    }
+
+    return null;
+}
+
+/**
+ * Split one delimited line, honouring RFC 4180 double-quote quoting so a
+ * separator inside a quoted field does not open a new column. `""` inside a
+ * quoted field is one literal quote.
+ */
+function splitDelimitedLine(line: string, delimiter: string): string[] {
+    const fields: string[] = [];
+    let field = '';
+    let quoted = false;
+
+    for (let i = 0; i < line.length; i++) {
+        const char = line[i];
+
+        if (quoted) {
+            if (char !== '"') {
+                field += char;
+            }
+            else if (line[i + 1] === '"') {
+                field += '"';
+                i++;
+            }
+            else {
+                quoted = false;
+            }
+            continue;
+        }
+
+        if (char === '"') {
+            quoted = true;
+        }
+        else if (char === delimiter) {
+            fields.push(field);
+            field = '';
+        }
+        else {
+            field += char;
+        }
+    }
+
+    fields.push(field);
+
+    return fields.map(f => f.trim());
+}
+
+/**
+ * Render rows as GFM, treating the first row as the header — the format has no
+ * header-less form, and a leading data row reads better as a header than as a
+ * row of empty header cells.
+ */
+function renderMarkdownTable(rows: string[][]): string {
+    // A literal `|` would end the cell, and a newline inside a quoted CSV field
+    // would end the row.
+    const cell = (value: string) => value.replace(/\|/g, '\\|').replace(/\n/g, ' ');
+    const row = (values: string[]) => `| ${values.map(cell).join(' | ')} |`;
+    const [header, ...body] = rows;
+
+    return [
+        row(header),
+        `| ${header.map(() => '---').join(' | ')} |`,
+        ...body.map(row),
+    ].join('\n');
+}
