+import { expect, test } from '../fixtures/muya';
+import { getMarkdown } from '../helpers/api';
+import { editor } from '../helpers/selectors';
+
+/**
+ * Tab past the last cell appends a row, matching Typora 1.13.8 (measured, see
+ * `outputs/M3现状实测与1.5.0范围_AC_260729.md`). It used to stop there, so
+ * filling a table in meant reaching for the mouse or `Cmd+Enter` every row.
+ */
+test.describe('Tab at the end of a table', () => {
+    test('appends a row and puts the caret in its first cell', async ({ page }) => {
+        await page.evaluate(() => {
+            window.muya!.setContent('| h1 | h2 |\n| --- | --- |\n| a | b |\n');
+        });
+        const table = page.locator(editor.table).first();
+        await expect(table.locator('tr')).toHaveCount(2);
+
+        await table.locator('tr').nth(1).locator('td').nth(1).click();
+        await page.keyboard.press('Tab');
+
+        await expect(table.locator('tr')).toHaveCount(3);
+        await page.keyboard.type('c');
+        await expect.poll(() => getMarkdown(page)).toContain('| c ');
+    });
+
+    // There is no row before the header to grow into.
+    test('Shift+Tab at the first cell stays put', async ({ page }) => {
+        await page.evaluate(() => {
+            window.muya!.setContent('| h1 | h2 |\n| --- | --- |\n| a | b |\n');
+        });
+        const table = page.locator(editor.table).first();
+
+        await table.locator('tr').first().locator('td').first().click();
+        await page.keyboard.press('Shift+Tab');
+
+        await expect(table.locator('tr')).toHaveCount(2);
+    });
+});
