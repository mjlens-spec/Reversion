+import { describe, expect, it } from 'vitest'
+
+import {
+  createMinimapDrawCommands,
+  createMagnifierPosition,
+  createViewportCommand,
+  documentOffsetFromPointer,
+  type SemanticBlockSummary
+} from '@/util/semanticMinimap'
+
+const blocks: SemanticBlockSummary[] = [
+  { type: 'heading', level: 1, depth: 0, top: 0, height: 48 },
+  { type: 'paragraph', depth: 0, top: 64, height: 64 },
+  { type: 'heading', level: 3, depth: 0, top: 160, height: 36 },
+  { type: 'list', depth: 2, top: 224, height: 72 },
+  { type: 'quote', depth: 0, top: 320, height: 88 }
+]
+
+describe('semantic minimap draw mapping', () => {
+  it('makes higher-level headings more prominent', () => {
+    const commands = createMinimapDrawCommands(blocks, {
+      documentHeight: 1000,
+      viewportHeight: 500,
+      canvasHeight: 500,
+      canvasWidth: 16
+    })
+    const h1 = commands[0]!
+    const h3 = commands[2]!
+    expect(h1.width).toBeGreaterThan(h3.width)
+    expect(h1.x).toBeLessThan(h3.x)
+  })
+
+  it('offsets nested lists without changing their document position', () => {
+    const commands = createMinimapDrawCommands(blocks, {
+      documentHeight: 1000,
+      viewportHeight: 500,
+      canvasHeight: 500,
+      canvasWidth: 16
+    })
+    expect(commands[3]!.x).toBeGreaterThan(commands[1]!.x)
+    expect(commands[3]!.top).toBeCloseTo(112)
+  })
+
+  it('does not stretch a short document to fill the minimap', () => {
+    const commands = createMinimapDrawCommands(blocks.slice(0, 2), {
+      documentHeight: 220,
+      viewportHeight: 500,
+      canvasHeight: 500,
+      canvasWidth: 16
+    })
+    expect(commands[1]!.top).toBe(64)
+  })
+
+  it('maps the live viewport independently from block collection', () => {
+    expect(createViewportCommand({
+      scrollTop: 250,
+      documentHeight: 1000,
+      viewportHeight: 500,
+      canvasHeight: 500,
+      canvasWidth: 16
+    })).toEqual({ top: 125, height: 250, left: 0.5, width: 15 })
+  })
+})
+
+describe('semantic minimap magnifier geometry', () => {
+  it('maps the pointer to a document offset and clamps it to the document', () => {
+    expect(documentOffsetFromPointer(250, 100, 600, 2400)).toBe(600)
+    expect(documentOffsetFromPointer(20, 100, 600, 2400)).toBe(0)
+    expect(documentOffsetFromPointer(800, 100, 600, 2400)).toBe(2400)
+  })
+
+  it('places the magnifier left of the minimap and flips above near the bottom edge', () => {
+    expect(createMagnifierPosition(1180, 360, 1200, 800)).toEqual({
+      left: 862,
+      top: 374,
+      placement: 'below'
+    })
+    expect(createMagnifierPosition(1180, 760, 1200, 800)).toEqual({
+      left: 862,
+      top: 538,
+      placement: 'above'
+    })
+  })
+
+  it('keeps the magnifier inside small viewports', () => {
+    expect(createMagnifierPosition(12, 12, 320, 240)).toEqual({
+      left: 8,
+      top: 8,
+      placement: 'above'
+    })
+  })
+})
