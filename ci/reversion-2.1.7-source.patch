+    ]
+    const white: CssColor = { r: 1, g: 1, b: 1, a: 1 }
+    const ratios = new Map<string, number>()
+
+    for (const [filename, path] of themeEntries) {
+      const variables = parseThemeVariables(readFileSync(path, 'utf8'))
+      const editorColor = parseCssColor(variables['--editorColor'] ?? '', variables)
+      const editorColor80 = parseCssColor(variables['--editorColor80'] ?? '', variables)
+      const editorBackground = parseCssColor(variables['--editorBgColor'] ?? '', variables)
+      if (!editorColor || !editorColor80 || !editorBackground) continue
+
+      const opaqueBackground = composite(editorBackground, white)
+      const idleColor = composite(mixIdleColor(editorColor80, editorColor), opaqueBackground)
+      ratios.set(filename, contrastRatio(idleColor, opaqueBackground))
