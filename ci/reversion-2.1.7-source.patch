+import { describe, expect, it } from 'vitest'
+import {
+  durationParts,
+  estimateRemainingSeconds,
+  formatBytes,
+  normalizeReleaseNotes
+} from '@/store/updateUtils'
+
+describe('update progress formatting', () => {
+  it('formats byte counts and transfer speeds for the progress card', () => {
+    expect(formatBytes(0)).toBe('0 B')
+    expect(formatBytes(1536)).toBe('1.5 KB')
+    expect(formatBytes(12 * 1024 * 1024)).toBe('12 MB')
+  })
+
+  it('estimates and formats remaining time', () => {
+    expect(estimateRemainingSeconds(1000, 400, 100)).toBe(6)
+    expect(estimateRemainingSeconds(1000, 400, 0)).toBe(0)
+    expect(durationParts(6)).toEqual([{ value: 6, unit: 'second' }])
+    expect(durationParts(61)).toEqual([{ value: 2, unit: 'minute' }])
+    expect(durationParts(3660)).toEqual([
+      { value: 1, unit: 'hour' },
+      { value: 1, unit: 'minute' }
+    ])
+  })
+
+  it('normalizes GitHub and electron-updater release note shapes', () => {
+    expect(normalizeReleaseNotes('hello')).toBe('hello')
+    expect(normalizeReleaseNotes([{ version: '1.3.0', note: 'first' }, { note: 'second' }])).toBe(
+      'first\n\nsecond'
+    )
+    expect(normalizeReleaseNotes(null)).toBe('')
+  })
+})
