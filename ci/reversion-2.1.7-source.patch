+
+  figure.mu-diagram-block .mu-diagram-preview svg {
+    display: block;
+    max-width: 100%;
+    margin: 0 auto;
+  }
+
+  .mu-container table {
+    display: table;
+    /* `min-width` keeps a narrow table filling the column, `max-content` lets
+       a wide one exceed it and scroll inside `.mu-table`. This replaces the
+       13px compression that used to be the only way to fit wide tables. */
+    width: max-content;
