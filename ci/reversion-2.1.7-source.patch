+import { describe, expect, it } from 'vitest'
+
+import { shouldCenterTypewriter, typewriterScrollTarget } from '@/util/typewriterMode'
+
+describe('typewriter mode behavior', () => {
+  it('uses the live viewport midpoint instead of a fixed pixel anchor', () => {
+    expect(typewriterScrollTarget(500, 620, 20, 800)).toBe(700)
+    expect(typewriterScrollTarget(500, 420, 20, 400)).toBe(700)
+  })
+
+  it('centers every caret move when input-only mode is disabled', () => {
+    expect(shouldCenterTypewriter({
+      enabled: true,
+      sourceCode: false,
+      inputOnly: false,
+      inputPending: false,
+      composing: false
+    })).toBe(true)
+  })
+
+  it('centers only committed input by default and pauses for IME/source mode', () => {
+    const base = { enabled: true, sourceCode: false, inputOnly: true, inputPending: true, composing: false }
+    expect(shouldCenterTypewriter(base)).toBe(true)
+    expect(shouldCenterTypewriter({ ...base, inputPending: false })).toBe(false)
+    expect(shouldCenterTypewriter({ ...base, composing: true })).toBe(false)
+    expect(shouldCenterTypewriter({ ...base, sourceCode: true })).toBe(false)
+  })
+})
