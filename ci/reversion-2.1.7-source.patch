@@ -0,0 +1,179 @@
+// @vitest-environment happy-dom
+
+import { afterEach, beforeEach, describe, expect, it, vi } from 'vitest';
+import { Muya } from '../../../muya';
+import { InlineFormatToolbar } from '../index';
+
+const hosts: HTMLElement[] = [];
+const toolbars: InlineFormatToolbar[] = [];
+
+beforeEach(() => {
+    window.MUYA_VERSION = 'test';
+    if (typeof globalThis.ResizeObserver === 'undefined') {
+        globalThis.ResizeObserver = class {
+            observe() {}
+            unobserve() {}
+            disconnect() {}
+        } as never;
+    }
+});
+
+afterEach(() => {
+    while (toolbars.length) toolbars.pop()!.destroy();
+    while (hosts.length) hosts.pop()!.remove();
+});
+
+function boot(markdown: string): Muya {
+    const host = document.createElement('div');
+    document.body.appendChild(host);
+    const muya = new Muya(host, { markdown } as ConstructorParameters<typeof Muya>[1]);
+    muya.init();
+    hosts.push(muya.domNode);
+    return muya;
+}
+
+function click(element: Element): void {
+    element.dispatchEvent(new MouseEvent('click', { bubbles: true, cancelable: true }));
+}
+
+describe('inline format toolbar grouped submenus', () => {
+    it('renders paragraph choices and More image action as independent menus', () => {
+        const muya = boot('hello world\n');
+        const toolbar = new InlineFormatToolbar(muya);
+        toolbars.push(toolbar);
+        toolbar.status = true;
+
+        muya.eventCenter.emit('selection-change', {
+            formats: [],
+            isCollapsed: false,
+            isSelectionInSameBlock: true,
+        });
+
+        const paragraphTrigger = toolbar.container!.querySelector('.paragraph-trigger')!;
+        const paragraphLabel = paragraphTrigger.querySelector('.paragraph-trigger-label')!;
+        expect(paragraphTrigger.getAttribute('aria-haspopup')).toBe('menu');
+        expect(paragraphTrigger.parentElement?.classList.contains('toolbar-row-paragraph')).toBe(true);
+        expect(paragraphLabel.querySelector('span')?.textContent).toBe('Plain Text');
+        expect(paragraphTrigger.querySelectorAll(':scope > svg')).toHaveLength(1);
+        expect(paragraphTrigger.querySelectorAll('.paragraph-trigger-label > svg')).toHaveLength(1);
+        expect(window.getComputedStyle(paragraphTrigger).flex).toBe('1 1 auto');
+        expect(window.getComputedStyle(paragraphLabel).whiteSpace).toBe('nowrap');
+
+        const secondaryTypes = Array.from(
+            toolbar.container!.querySelectorAll<HTMLElement>('.toolbar-row-secondary > .item'),
+        ).map(item => ['link', 'del', 'inline_code', 'inline_math', 'more']
+            .find(type => item.classList.contains(type)));
+        expect(secondaryTypes).toEqual(['link', 'del', 'inline_code', 'inline_math', 'more']);
+
+        click(paragraphTrigger);
+
+        const submenu = toolbar.container!.querySelector<HTMLElement>('.mu-format-picker-submenu')!;
+        expect(submenu.hidden).toBe(false);
+        expect(submenu.querySelectorAll('[role="menuitemradio"]')).toHaveLength(11);
+        expect(submenu.querySelector('.submenu-label')!.textContent).toBe('Plain Text');
+        const quoteItem = Array.from(submenu.querySelectorAll<HTMLElement>('[role="menuitemradio"]'))
+            .find(item => item.textContent?.includes('Quote Block'))!;
+        expect(quoteItem.querySelector('.submenu-symbol svg')).toBeTruthy();
+        expect(quoteItem.querySelector('.submenu-symbol')?.textContent).toBe('');
+
+        // Escape closes only the independent submenu, leaving the toolbar
+        // available for a second action and updating the trigger ARIA state.
+        document.dispatchEvent(new KeyboardEvent('keydown', { key: 'Escape', bubbles: true, cancelable: true }));
+        expect(toolbar.status).toBe(true);
+        expect(submenu.hidden).toBe(true);
+        expect(paragraphTrigger.getAttribute('aria-expanded')).toBe('false');
+        document.dispatchEvent(new KeyboardEvent('keydown', { key: 'Escape', bubbles: true, cancelable: true }));
+        expect(toolbar.status).toBe(false);
+
+        toolbar.status = true;
+        click(toolbar.container!.querySelector('.more')!);
+        const imageAction = toolbar.container!.querySelector('.mu-format-picker-submenu .image')!;
+        expect(imageAction.getAttribute('aria-disabled')).toBe('false');
+    });
+
+    it('disables link/image actions for a cross-block selection', () => {
+        const muya = boot('one\ntwo\n');
+        const toolbar = new InlineFormatToolbar(muya);
+        toolbars.push(toolbar);
+        toolbar.status = true;
+
+        muya.eventCenter.emit('selection-change', {
+            formats: [],
+            isCollapsed: false,
+            isSelectionInSameBlock: false,
+            cursorCoords: { top: 0, left: 0, right: 1, bottom: 1, width: 1, height: 1 } as DOMRect,
+        });
+
+        expect(toolbar.container!.querySelector('.link')!.getAttribute('aria-disabled')).toBe('true');
+        click(toolbar.container!.querySelector('.more')!);
+        expect(toolbar.container!.querySelector('.mu-format-picker-submenu .image')!.getAttribute('aria-disabled')).toBe('true');
+    });
+
+    it('routes paragraph choices through Muya.updateParagraph after restoring selection', () => {
+        const muya = boot('hello world\n');
+        const toolbar = new InlineFormatToolbar(muya);
+        toolbars.push(toolbar);
+        const block = muya.editor.scrollPage!.firstContentInDescendant()!;
+        muya.editor.selection.setSelection(
+            { offset: 0, block, path: block.path },
+            { offset: block.text.length, block, path: block.path },
+        );
+        const updateParagraph = vi.spyOn(muya, 'updateParagraph').mockImplementation(() => {})
+        ;(toolbar as unknown as { _block: unknown; _render: () => void })._block = block
+        ;(toolbar as unknown as { _render: () => void })._render();
+
+        click(toolbar.container!.querySelector('.paragraph-trigger')!);
+        const headingOne = Array.from(toolbar.container!.querySelectorAll('[role="menuitemradio"]'))
+            .find(item => item.textContent?.includes('Heading 1'))!;
+        click(headingOne);
+        expect(updateParagraph).toHaveBeenCalledWith('heading 1');
+    });
+
+    it('reflects the active heading level in the trigger and radio state', () => {
+        const muya = boot('## heading\n');
+        const toolbar = new InlineFormatToolbar(muya);
+        toolbars.push(toolbar);
+        const block = muya.editor.scrollPage!.firstContentInDescendant()!;
+        muya.editor.selection.setSelection(
+            { offset: 0, block, path: block.path },
+            { offset: block.text.length, block, path: block.path },
+        );
+        toolbar.status = true;
+        (toolbar as unknown as { _block: typeof block; _render: () => void })._block = block;
+        (toolbar as unknown as { _render: () => void })._render();
+
+        const trigger = toolbar.container!.querySelector<HTMLElement>('.paragraph-trigger')!;
+        expect(trigger.getAttribute('aria-label')).toBe('Heading 2');
+        click(trigger);
+        const active = toolbar.container!.querySelector('[role="menuitemradio"][aria-checked="true"]');
+        expect(active?.textContent).toContain('Heading 2');
+        const headingThree = Array.from(toolbar.container!.querySelectorAll('[role="menuitemradio"]'))
+            .find(item => item.textContent?.includes('Heading 3'))!;
+        click(headingThree);
+        expect(toolbar.container!.querySelector('.paragraph-trigger')?.getAttribute('aria-label')).toBe('Heading 3');
+    });
+
+    it('hides on collapsed or composition-start selection changes and exposes keyboard triggers', () => {
+        const muya = boot('hello\n');
+        const toolbar = new InlineFormatToolbar(muya);
+        toolbars.push(toolbar);
+        toolbar.status = true;
+        (toolbar as unknown as { _render: () => void })._render();
+        const trigger = toolbar.container!.querySelector<HTMLElement>('.paragraph-trigger')!;
+        expect(trigger.getAttribute('role')).toBe('button');
+        expect(trigger.getAttribute('tabindex')).toBe('0');
+        trigger.dispatchEvent(new KeyboardEvent('keydown', { key: 'Enter', bubbles: true, cancelable: true }));
+        expect(toolbar.container!.querySelector<HTMLElement>('.mu-format-picker-submenu')?.hidden).toBe(false);
+
+        muya.eventCenter.emit('selection-change', {
+            formats: [],
+            isCollapsed: true,
+            isSelectionInSameBlock: true,
+        });
+        expect(toolbar.status).toBe(false);
+
+        toolbar.status = true;
+        muya.domNode.dispatchEvent(new Event('compositionstart', { bubbles: true }));
+        expect(toolbar.status).toBe(false);
+    });
+});
