diff --git a/packages/desktop/test/e2e/export-docx-png.spec.ts b/packages/desktop/test/e2e/export-docx-png.spec.ts
new file mode 100644
index 00000000..1f02192a
--- /dev/null
+++ b/packages/desktop/test/e2e/export-docx-png.spec.ts
@@ -0,0 +1,159 @@
+import { expect, test } from '@playwright/test'
+import type { ElectronApplication, Page } from 'playwright'
+import * as fs from 'node:fs'
+import { execFileSync } from 'node:child_process'
+import { launchWithMarkdown, waitForMenuReady, sendIpcToRenderer } from './helpers'
+
+// DOCX and long-image (PNG) export to a real file via the renderer pipeline.
+//
+// Same seam as export-pdf.spec.ts: the native save dialog is stubbed in the
+// MAIN process and everything else — export-settings dialog, renderer render,
+// `mt::response-export`, `handleResponseForExport` — runs for real. Assertions
+// stay at the container level (ZIP/PNG magic bytes, declared dimensions);
+// typography and layout fidelity remain a manual check.
+
+const DOC =
+  '# Export Smoke\n\n' +
+  'First paragraph with **bold** and *italic* text.\n\n' +
+  '| Column A | Column B |\n| --- | --- |\n| 中文单元格 | latin cell |\n\n' +
+  '- list item one\n- list item two\n\n' +
+  'A closing paragraph so the document is taller than one line.\n'
+
+const hasPandoc = ((): boolean => {
+  try {
+    execFileSync('pandoc', ['--version'], { stdio: 'ignore' })
+    return true
+  } catch {
+    return false
+  }
+})()
+
+const stubSaveDialog = async(app: ElectronApplication, targetPath: string): Promise<void> => {
+  await app.evaluate(async({ dialog }, savePath) => {
+    const g = global as unknown as { __mt_orig_showSaveDialog__?: typeof dialog.showSaveDialog }
+    if (!g.__mt_orig_showSaveDialog__) {
+      g.__mt_orig_showSaveDialog__ = dialog.showSaveDialog.bind(dialog)
+    }
+    ;(dialog as unknown as { showSaveDialog: unknown }).showSaveDialog = async() => ({
+      canceled: false,
+      filePath: savePath
+    })
+  }, targetPath)
+}
+
+const restoreSaveDialog = async(app: ElectronApplication): Promise<void> => {
+  await app.evaluate(({ dialog }) => {
+    const g = global as unknown as { __mt_orig_showSaveDialog__?: typeof dialog.showSaveDialog }
+    if (g.__mt_orig_showSaveDialog__) {
+      ;(dialog as unknown as { showSaveDialog: unknown }).showSaveDialog =
+        g.__mt_orig_showSaveDialog__
+    }
+  })
+}
+
+const triggerExport = async(
+  app: ElectronApplication,
+  page: Page,
+  type: string
+): Promise<void> => {
+  await sendIpcToRenderer(app, 'mt::show-export-dialog', type)
+  const confirm = page.locator('.print-settings-dialog .button-primary')
+  await confirm.waitFor({ state: 'visible', timeout: 10000 })
+  await confirm.click()
+}
+
+const pollForFile = async(filePath: string, timeoutMs = 30000): Promise<Buffer> => {
+  const deadline = Date.now() + timeoutMs
+  let lastSize = -1
+  while (Date.now() < deadline) {
+    if (fs.existsSync(filePath)) {
+      const data = fs.readFileSync(filePath)
+      // The PNG is streamed to disk, so wait for the size to stop growing
+      // before reading it as a finished file.
+      if (data.length > 0 && data.length === lastSize) return data
+      lastSize = data.length
+    }
+    await new Promise((resolve) => setTimeout(resolve, 150))
+  }
+  throw new Error(`File was not written within ${timeoutMs}ms: ${filePath}`)
+}
+
+// Width and height live in the IHDR chunk, which always comes first.
+const readPngSize = (data: Buffer): { width: number; height: number } => ({
+  width: data.readUInt32BE(16),
+  height: data.readUInt32BE(20)
+})
+
+test.describe('DOCX and long-image export', () => {
+  let app: ElectronApplication
+  let page: Page
+
+  test.beforeAll(async() => {
+    const launched = await launchWithMarkdown(DOC)
+    app = launched.app
+    page = launched.page
+    await waitForMenuReady(app)
+  })
+
+  test.afterAll(async() => {
+    if (app) {
+      await restoreSaveDialog(app)
+      await app.close()
+    }
+  })
+
+  test('writes a DOCX package that Word can open', async() => {
+    test.skip(!hasPandoc, 'pandoc is not installed on this machine')
+
+    const out = `/tmp/reversion-e2e-export-${Date.now()}.docx`
+    fs.rmSync(out, { force: true })
+    await stubSaveDialog(app, out)
+
+    await triggerExport(app, page, 'docx')
+
+    const data = await pollForFile(out)
+    // docx is a ZIP container: "PK\x03\x04".
+    expect(data.subarray(0, 4)).toEqual(Buffer.from([0x50, 0x4b, 0x03, 0x04]))
+    expect(data.includes(Buffer.from('word/document.xml'))).toBe(true)
+
+    fs.rmSync(out, { force: true })
+  })
+
+  test('writes a single tall PNG covering the whole document', async() => {
+    const out = `/tmp/reversion-e2e-export-${Date.now()}.png`
+    fs.rmSync(out, { force: true })
+    await stubSaveDialog(app, out)
+
+    await triggerExport(app, page, 'png')
+
+    const data = await pollForFile(out)
+    expect(data.subarray(0, 8)).toEqual(
+      Buffer.from([0x89, 0x50, 0x4e, 0x47, 0x0d, 0x0a, 0x1a, 0x0a])
+    )
+    expect(data.subarray(12, 16).toString('ascii')).toBe('IHDR')
+
+    const { width, height } = readPngSize(data)
+    // Defaults are 800 CSS px at 2x; the document is taller than it is wide.
+    expect(width).toBe(1600)
+    expect(height).toBeGreaterThan(200)
+    expect(data.subarray(data.length - 8, data.length - 4).toString('ascii')).toBe('IEND')
+
+    fs.rmSync(out, { force: true })
+  })
+
+  test('canceling the save dialog writes no file', async() => {
+    const out = `/tmp/reversion-e2e-export-${Date.now()}-cancel.png`
+    fs.rmSync(out, { force: true })
+    await app.evaluate(({ dialog }) => {
+      ;(dialog as unknown as { showSaveDialog: unknown }).showSaveDialog = async() => ({
+        canceled: true,
+        filePath: undefined
+      })
+    })
+
+    await triggerExport(app, page, 'png')
+    await page.waitForTimeout(2000)
+
+    expect(fs.existsSync(out)).toBe(false)
+  })
+})
