diff --git a/packages/desktop/src/main/exportImage/index.ts b/packages/desktop/src/main/exportImage/index.ts
new file mode 100644
index 00000000..7fb653de
--- /dev/null
+++ b/packages/desktop/src/main/exportImage/index.ts
@@ -0,0 +1,215 @@
+// Long-image (PNG) export.
+//
+// The document is rendered in an off-screen window at a fixed content width and
+// captured in vertical slices. A single `capturePage` cannot cover a whole
+// article: Chromium fails with `UnknownVizError` once the captured surface
+// passes roughly 16384 device pixels (measured on a 2x display: 7700 CSS px
+// captured fine, 9625 CSS px did not). Slices are re-assembled by a streaming
+// PNG writer so the finished image never has to exist in memory at once.
+
+import { BrowserWindow } from 'electron'
+import { promises as fs } from 'fs'
+import os from 'os'
+import path from 'path'
+import { PngRowWriter, bgraToRgba } from './pngStream'
+
+/** CSS-pixel height of one capture slice; stays far below the capture ceiling. */
+const SLICE_HEIGHT = 3000
+
+/** Refuse absurd documents rather than spending minutes producing an unopenable file. */
+const MAX_OUTPUT_HEIGHT = 200000
+
+const LOAD_TIMEOUT_MS = 30000
+
+export interface LongImageOptions {
+  /** Standalone HTML document (styles already inlined). */
+  html: string
+  outputPath: string
+  /** Layout width of the rendered page, in CSS pixels. */
+  width: number
+  /** Output pixels per CSS pixel: 1 for a compact file, 2 for a HiDPI image. */
+  scale: number
+  /** Painted behind the document; also fills the padding around it. */
+  background: string
+  /** Blank margin kept around the article, in CSS pixels. */
+  padding: number
+}
+
+export interface LongImageResult {
+  width: number
+  height: number
+}
+
+// Overrides applied on top of the exported document's own stylesheet: strip the
+// page framing so the capture is edge-to-edge, and pin anything sticky in place
+// so it is not repeated in every slice.
+const captureCss = (background: string, padding: number): string => `
+  html {
+    /* The document is scrolled programmatically between slices; leaving the
+       scrollbar visible would paint a grey strip down the right edge of every
+       slice and steal width from the content. */
+    scrollbar-width: none !important;
+  }
+  html::-webkit-scrollbar, body::-webkit-scrollbar {
+    width: 0 !important;
+    height: 0 !important;
+    display: none !important;
+  }
+  html, body {
+    margin: 0 !important;
+    padding: 0 !important;
+    background: ${background} !important;
+    overflow-x: hidden !important;
+  }
+  body > .markdown-body, body > article.markdown-body {
+    box-sizing: border-box !important;
+    width: 100% !important;
+    max-width: none !important;
+    margin: 0 !important;
+    padding: ${padding}px !important;
+    background: ${background} !important;
+  }
+  .page-footer, [style*="position: fixed"], [style*="position:fixed"] {
+    position: static !important;
+  }
+`
+
+// Resolved once the document has finished laying out: web fonts are ready and
+// every <img> has either decoded or failed. A slice captured before then can
+// show reflowed text or empty image boxes.
+const WAIT_FOR_ASSETS = `
+  (async () => {
+    try { await document.fonts.ready } catch (e) {}
+    await Promise.all(
+      Array.from(document.images).map((img) =>
+        img.complete ? Promise.resolve() : new Promise((resolve) => {
+          img.addEventListener('load', resolve, { once: true })
+          img.addEventListener('error', resolve, { once: true })
+        })
+      )
+    )
+    await new Promise((resolve) => requestAnimationFrame(() => requestAnimationFrame(resolve)))
+    // Measured from the article's own box, not documentElement.scrollHeight:
+    // the latter never reports less than the viewport, so a short document
+    // would be padded out to a full slice of blank background.
+    const root = document.querySelector('.markdown-body') || document.body
+    const bottom = root.getBoundingClientRect().bottom + window.scrollY
+    return Math.max(1, Math.ceil(bottom))
+  })()
+`
+
+const settleFrame = (win: BrowserWindow): Promise<unknown> =>
+  win.webContents.executeJavaScript(
+    'new Promise((resolve) => requestAnimationFrame(() => requestAnimationFrame(() => resolve(0))))'
+  )
+
+const withTimeout = async <T>(promise: Promise<T>, ms: number, label: string): Promise<T> => {
+  let timer: NodeJS.Timeout | undefined
+  try {
+    return await Promise.race([
+      promise,
+      new Promise<never>((_resolve, reject) => {
+        timer = setTimeout(() => reject(new Error(`${label} timed out after ${ms}ms`)), ms)
+      })
+    ])
+  } finally {
+    if (timer) clearTimeout(timer)
+  }
+}
+
+/**
+ * Render `html` off-screen and write it to `outputPath` as a single tall PNG.
+ */
+export const exportLongImage = async(options: LongImageOptions): Promise<LongImageResult> => {
+  const { html, outputPath, width, scale, background, padding } = options
+  if (!Number.isInteger(width) || width < 200 || width > 4000) {
+    throw new Error(`Unsupported image width: ${width}`)
+  }
+  if (scale !== 1 && scale !== 2) {
+    throw new Error(`Unsupported image scale: ${scale}`)
+  }
+
+  // Loaded from disk rather than a data: URL — a long document easily exceeds
+  // the URL length Chromium accepts, and a real file path also lets relative
+  // resources inside the document resolve.
+  const tempFile = path.join(
+    await fs.mkdtemp(path.join(os.tmpdir(), 'reversion-image-')),
+    'export.html'
+  )
+  await fs.writeFile(tempFile, html, 'utf8')
+
+  const win = new BrowserWindow({
+    show: false,
+    width,
+    height: SLICE_HEIGHT,
+    useContentSize: true,
+    webPreferences: {
+      sandbox: true,
+      contextIsolation: true,
+      nodeIntegration: false,
+      // The document is inert markup with no scripts of its own; JavaScript is
+      // only needed for the measure/scroll calls made from here.
+      javascript: true
+    }
+  })
+
+  let writer: PngRowWriter | null = null
+  try {
+    await withTimeout(win.loadFile(tempFile), LOAD_TIMEOUT_MS, 'Loading the document')
+    await win.webContents.insertCSS(captureCss(background, padding))
+    const documentHeight = (await withTimeout(
+      win.webContents.executeJavaScript(WAIT_FOR_ASSETS),
+      LOAD_TIMEOUT_MS,
+      'Laying out the document'
+    )) as number
+
+    const totalHeight = Math.max(1, documentHeight) * scale
+    if (totalHeight > MAX_OUTPUT_HEIGHT) {
+      throw new Error(
+        `The document renders ${totalHeight}px tall, above the ${MAX_OUTPUT_HEIGHT}px limit for a single image.`
+      )
+    }
+
+    const viewportHeight = Math.min(SLICE_HEIGHT, Math.max(1, documentHeight))
+    win.setContentSize(width, viewportHeight)
+    await settleFrame(win)
+
+    const maxScroll = Math.max(0, documentHeight - viewportHeight)
+    writer = new PngRowWriter({ width: width * scale, height: totalHeight, outputPath })
+
+    for (let top = 0; top < documentHeight; top += viewportHeight) {
+      const sliceHeight = Math.min(viewportHeight, documentHeight - top)
+      const scrollTop = Math.min(top, maxScroll)
+      await win.webContents.executeJavaScript(`window.scrollTo(0, ${scrollTop})`)
+      await settleFrame(win)
+
+      let image = await win.webContents.capturePage({
+        x: 0,
+        y: top - scrollTop,
+        width,
+        height: sliceHeight
+      })
+      const captured = image.getSize()
+      const targetWidth = width * scale
+      const targetHeight = sliceHeight * scale
+      if (captured.width !== targetWidth || captured.height !== targetHeight) {
+        // The display's own scale factor decides what `capturePage` returns, so
+        // normalise every slice to the scale the user asked for.
+        image = image.resize({ width: targetWidth, height: targetHeight, quality: 'best' })
+      }
+      await writer.writeBand(bgraToRgba(image.toBitmap()), targetHeight)
+    }
+
+    await writer.finish()
+    writer = null
+    return { width: width * scale, height: totalHeight }
+  } catch (err) {
+    writer?.abort()
+    throw err
+  } finally {
+    if (!win.isDestroyed()) {
+      win.destroy()
+    }
+    await fs.rm(path.dirname(tempFile), { recursive: true, force: true }).catch(() => {})
+  }
+}
diff --git a/packages/desktop/src/main/exportImage/pngStream.ts b/packages/desktop/src/main/exportImage/pngStream.ts
new file mode 100644
index 00000000..aab52185
--- /dev/null
+++ b/packages/desktop/src/main/exportImage/pngStream.ts
@@ -0,0 +1,195 @@
+// Streaming PNG writer used by the long-image export.
+//
+// A long-image export is assembled from several viewport captures, and the
+// finished image can be tens of thousands of pixels tall. Encoding it with a
+// whole-image library would mean holding the full RGBA raster in memory
+// (1600 x 60000 px is ~384 MB), so rows are filtered and deflated as each
+// capture arrives and only one tile is ever resident.
+
+import { createDeflate } from 'zlib'
+import { createWriteStream } from 'fs'
+import type { Deflate } from 'zlib'
+import type { WriteStream } from 'fs'
+
+const PNG_SIGNATURE = Buffer.from([0x89, 0x50, 0x4e, 0x47, 0x0d, 0x0a, 0x1a, 0x0a])
+const BYTES_PER_PIXEL = 4
+
+const CRC_TABLE = ((): Uint32Array => {
+  const table = new Uint32Array(256)
+  for (let n = 0; n < 256; n++) {
+    let c = n
+    for (let k = 0; k < 8; k++) {
+      c = c & 1 ? 0xedb88320 ^ (c >>> 1) : c >>> 1
+    }
+    table[n] = c >>> 0
+  }
+  return table
+})()
+
+const crc32 = (buffer: Buffer): number => {
+  let c = 0xffffffff
+  for (let i = 0; i < buffer.length; i++) {
+    c = CRC_TABLE[(c ^ buffer[i]!) & 0xff]! ^ (c >>> 8)
+  }
+  return (c ^ 0xffffffff) >>> 0
+}
+
+const chunk = (type: string, data: Buffer): Buffer => {
+  const length = Buffer.alloc(4)
+  length.writeUInt32BE(data.length, 0)
+  const typeAndData = Buffer.concat([Buffer.from(type, 'ascii'), data])
+  const crc = Buffer.alloc(4)
+  crc.writeUInt32BE(crc32(typeAndData), 0)
+  return Buffer.concat([length, typeAndData, crc])
+}
+
+const ihdr = (width: number, height: number): Buffer => {
+  const data = Buffer.alloc(13)
+  data.writeUInt32BE(width, 0)
+  data.writeUInt32BE(height, 4)
+  data[8] = 8 // bit depth
+  data[9] = 6 // colour type: truecolour with alpha
+  data[10] = 0 // deflate
+  data[11] = 0 // adaptive filtering
+  data[12] = 0 // no interlace
+  return data
+}
+
+export interface PngRowWriterOptions {
+  width: number
+  height: number
+  outputPath: string
+  /** zlib compression level; 6 keeps long text pages small without a long stall. */
+  level?: number
+}
+
+/**
+ * Writes an 8-bit RGBA PNG one horizontal band at a time.
+ *
+ * Rows are filtered with `Up` (except the very first, which has no row above
+ * it) — cheap to compute and highly effective on document screenshots, where
+ * most vertical neighbours are identical.
+ */
+export class PngRowWriter {
+  private readonly width: number
+  private readonly height: number
+  private readonly deflate: Deflate
+  private readonly file: WriteStream
+  private readonly done: Promise<void>
+  private prevRow: Buffer
+  private rowsWritten = 0
+  private failure: Error | null = null
+
+  constructor({ width, height, outputPath, level = 6 }: PngRowWriterOptions) {
+    if (!Number.isInteger(width) || width <= 0 || !Number.isInteger(height) || height <= 0) {
+      throw new Error(`Invalid PNG dimensions: ${width}x${height}`)
+    }
+    this.width = width
+    this.height = height
+    this.prevRow = Buffer.alloc(width * BYTES_PER_PIXEL)
+
+    this.file = createWriteStream(outputPath)
+    this.deflate = createDeflate({ level })
+
+    this.file.write(PNG_SIGNATURE)
+    this.file.write(chunk('IHDR', ihdr(width, height)))
+
+    // The deflate output is the IDAT payload; emit it as a chunk per flush so
+    // the raster never has to be buffered whole.
+    this.deflate.on('data', (compressed: Buffer) => {
+      this.file.write(chunk('IDAT', compressed))
+    })
+
+    this.done = new Promise<void>((resolve, reject) => {
+      const fail = (err: Error): void => {
+        this.failure = this.failure ?? err
+        reject(err)
+      }
+      this.deflate.on('error', fail)
+      this.file.on('error', fail)
+      this.deflate.on('end', () => {
+        this.file.end(chunk('IEND', Buffer.alloc(0)), () => resolve())
+      })
+    })
+    // `finish()` is the only caller that awaits `done`, and an aborted writer
+    // never gets there — keep the rejection from surfacing as an unhandled one.
+    this.done.catch(() => {})
+  }
+
+  /**
+   * Append a horizontal band of RGBA pixels. `band` must hold
+   * `width * rowCount * 4` bytes with no padding between rows.
+   *
+   * Resolves once the deflate stream is ready for more, so a caller that awaits
+   * it never queues more than one band's worth of filtered rows.
+   */
+  async writeBand(band: Buffer, rowCount: number): Promise<void> {
+    if (this.failure) {
+      throw this.failure
+    }
+    const stride = this.width * BYTES_PER_PIXEL
+    if (band.length < stride * rowCount) {
+      throw new Error(`Band is ${band.length} bytes, expected at least ${stride * rowCount}`)
+    }
+    if (this.rowsWritten + rowCount > this.height) {
+      throw new Error(`Writing ${rowCount} rows would exceed the declared height of ${this.height}`)
+    }
+
+    // Each scanline is prefixed by its filter-type byte. Filter the whole band
+    // into one buffer and hand it to zlib in a single write: the buffer stays
+    // owned by the stream until it is consumed, so it must not be reused.
+    const out = Buffer.alloc((stride + 1) * rowCount)
+    for (let row = 0; row < rowCount; row++) {
+      const src = row * stride
+      const dst = row * (stride + 1)
+      if (this.rowsWritten === 0) {
+        out[dst] = 0 // None — there is no row above the first one.
+        band.copy(out, dst + 1, src, src + stride)
+      } else {
+        out[dst] = 2 // Up
+        for (let i = 0; i < stride; i++) {
+          out[dst + 1 + i] = (band[src + i]! - this.prevRow[i]!) & 0xff
+        }
+      }
+      band.copy(this.prevRow, 0, src, src + stride)
+      this.rowsWritten++
+    }
+
+    if (!this.deflate.write(out)) {
+      await new Promise<void>((resolve) => this.deflate.once('drain', resolve))
+    }
+  }
