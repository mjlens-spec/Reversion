+import { describe, expect, it } from 'vitest'
+
+import {
+  flattenCommandDescriptors,
+  rankPaletteEntries,
+  type PaletteCommandDescriptor
+} from '@/commands/catalog'
+
+const sample: PaletteCommandDescriptor[] = [
+  {
+    id: 'file.export',
+    title: { en: 'Export file', zh: '导出文件' },
+    scope: 'document',
+    subcommands: [
+      {
+        id: 'file.export.pdf',
+        title: { en: 'Export as PDF', zh: '导出为 PDF' },
+        scope: 'document',
+        accelerator: 'Command+Shift+E'
+      }
+    ]
+  },
+  {
+    id: 'view.toggle-minimap',
+    title: { en: 'Toggle semantic minimap', zh: '切换语义缩略图' },
+    scope: 'document'
+  }
+]
+
+describe('2.0 command catalog', () => {
+  it('flattens executable nested commands while preserving stable ids', () => {
+    expect(flattenCommandDescriptors(sample).map(({ id }) => id)).toEqual([
+      'file.export.pdf',
+      'view.toggle-minimap'
+    ])
+  })
+
+  it('matches Chinese independently of the active interface language', () => {
+    expect(rankPaletteEntries(flattenCommandDescriptors(sample), '导出').map(({ id }) => id))
+      .toEqual(['file.export.pdf'])
+  })
+
+  it('matches English, command id and accelerator text', () => {
+    const flattened = flattenCommandDescriptors(sample)
+    expect(rankPaletteEntries(flattened, 'export').map(({ id }) => id)).toEqual(['file.export.pdf'])
+    expect(rankPaletteEntries(flattened, 'toggle-minimap').map(({ id }) => id)).toEqual([
