index 00000000..f71f58e8
--- /dev/null
+++ b/packages/desktop/test/e2e/long-document-perf.spec.ts
@@ -0,0 +1,114 @@
+import { expect, test } from '@playwright/test'
+import type { ElectronApplication, Page } from 'playwright'
+import { launchWithMarkdown } from './helpers'
+
+const buildTenThousandLineDocument = (): string => {
+  const lines: string[] = []
+  for (let index = 0; index < 100; index += 1) {
+    lines.push(
+      `## 第 ${index + 1} 节`,
+      '',
+      `这是第 ${index + 1} 节的长文档性能测试段落，包含中文、Latin text 与数字 ${index}.`,
+      '',
+      '| 指标 | 数值 |',
+      '| --- | ---: |',
+      `| section | ${index + 1} |`,
+      '',
+      `$x_${index} = ${index}^2$`,
+      '',
+      '![本地图像占位](data:image/gif;base64,R0lGODlhAQABAAD/ACwAAAAAAQABAAACADs=)',
+      '',
+      '```text'
+    )
+    for (let codeLine = 0; codeLine < 85; codeLine += 1) {
+      lines.push(`section ${index + 1}, code line ${codeLine + 1}`)
+    }
+    lines.push('```', '')
+  }
+  if (lines.length !== 10_000) throw new Error(`expected 10,000 lines, got ${lines.length}`)
+  return lines.join('\n')
+}
+
+const percentile95 = (values: number[]): number => {
+  const sorted = values.slice().sort((a, b) => a - b)
+  return sorted[Math.ceil(sorted.length * 0.95) - 1] ?? 0
+}
+
+test.describe('10k-line production renderer benchmark @perf', () => {
+  test.setTimeout(120_000)
+
+  let app: ElectronApplication
+  let page: Page
+  let processColdOpenMs = 0
+  let rendererReadyMs = 0
+
+  test.beforeAll(async() => {
+    const startedAt = performance.now()
+    const launched = await launchWithMarkdown(buildTenThousandLineDocument())
+    processColdOpenMs = performance.now() - startedAt
+    app = launched.app
+    page = launched.page
+    rendererReadyMs = await page.evaluate(() => performance.now())
+  })
+
+  test.afterAll(async() => {
+    if (app) await app.close()
+  })
+
+  test('opens, accepts input within the P95 budget, and scrolls without stalling', async() => {
+    const blockCount = await page.locator('.mu-editor .mu-paragraph').count()
+    expect(blockCount).toBeGreaterThanOrEqual(300)
+
+    const editor = page.locator('.mu-editor').first()
+    await editor.click()
+    await page.keyboard.press('Meta+End')
+
+    const samples: number[] = []
+    for (let index = 0; index < 30; index += 1) {
+      const startedAt = performance.now()
+      await page.keyboard.insertText(index % 2 === 0 ? '文' : 'a')
+      samples.push(performance.now() - startedAt)
+    }
+    const inputP95Ms = percentile95(samples)
+
+    const scroll = await page.evaluate(async() => {
+      const container = document.querySelector('.editor-component') as HTMLElement | null
+      if (!container) throw new Error('editor scroll container not found')
+      let frames = 0
+      let startedAt = 0
+      await new Promise<void>((resolve) => {
+        const frame = (time: number): void => {
+          if (!startedAt) startedAt = time
+          frames += 1
+          const elapsed = time - startedAt
+          container.scrollTop = (container.scrollHeight - container.clientHeight) * Math.min(1, elapsed / 1000)
+          if (elapsed < 1000) requestAnimationFrame(frame)
+          else resolve()
+        }
+        requestAnimationFrame(frame)
+      })
+      return { frames, scrollTop: container.scrollTop, scrollHeight: container.scrollHeight }
+    })
+
+    console.log(
+      JSON.stringify({
+        processColdOpenMs: Math.round(processColdOpenMs),
+        rendererReadyMs: Math.round(rendererReadyMs),
+        inputP95Ms: Number(inputP95Ms.toFixed(1)),
+        scrollFrames: scroll.frames,
+        blockCount
+      })
+    )
+    expect(inputP95Ms, `10k-line input P95 was ${inputP95Ms.toFixed(1)}ms`).toBeLessThan(50)
+    expect(
+      processColdOpenMs,
+      `10k-line process cold open was ${processColdOpenMs.toFixed(0)}ms`
+    ).toBeLessThan(2_000)
+    expect(
+      rendererReadyMs,
+      `10k-line renderer cold open was ${rendererReadyMs.toFixed(0)}ms`
+    ).toBeLessThan(2_000)
+    expect(scroll.frames).toBeGreaterThanOrEqual(30)
+    expect(scroll.scrollTop).toBeGreaterThan(0)
+  })
+})
