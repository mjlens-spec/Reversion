+        hasHorizontalOverflow: element.scrollWidth > element.clientWidth
+      }
+    })
+    expect(responsiveLayout.containerWidth).toBeLessThan(responsiveLayout.editorWidth)
+    expect(responsiveLayout.textShare).toBeCloseTo(0.76, 2)
+    expect(responsiveLayout.leftShare).toBeCloseTo(0.12, 2)
+    expect(responsiveLayout.rightShare).toBeCloseTo(0.12, 2)
+    expect(responsiveLayout.leftFits).toBe(true)
+    expect(responsiveLayout.rightFits).toBe(true)
+    expect(responsiveLayout.hasHorizontalOverflow).toBe(false)
+
+    const narrowScreenshotPath = process.env.REVERSION_LAYOUT_NARROW_SCREENSHOT
+    if (narrowScreenshotPath) {
+      await page.locator('.editor-component').evaluate((element) => {
+        element.scrollTop = 0
+      })
+      await page.waitForTimeout(100)
+      await page.screenshot({ path: narrowScreenshotPath })
+    }
+
+    await clickMenuById(app, 'typewriterModeMenuItem')
+    await expect
+      .poll(() =>
+        page
+          .locator('.editor-component .mu-container')
+          .evaluate((element) => Number.parseFloat(getComputedStyle(element).paddingBottom))
+      )
+      .toBeGreaterThan(200)
+    await clickMenuById(app, 'typewriterModeMenuItem')
+    await expect
+      .poll(() =>
+        page
+          .locator('.editor-component .mu-container')
+          .evaluate((element) => Number.parseFloat(getComputedStyle(element).paddingBottom))
+      )
+      .toBe(64)
+
+    await app.close()
+    const relaunched = await launchElectron([filePath], { userDataDir })
+    app = relaunched.app
+    page = relaunched.page
+    await waitForEditor(page)
+    await waitForMenuReady(app)
+    await app.evaluate(({ BrowserWindow }) => {
+      BrowserWindow.getAllWindows()[0]?.setSize(1800, 1200)
+    })
+    await page.waitForTimeout(150)
+  })
+
+  test('keeps the magnifier frame while shrinking its thumbnail text by three pixels', async() => {
+    await page.evaluate(() => {
+      window.electron.ipcRenderer.send('mt::set-user-preference', { readingFontSize: 20 })
+    })
+    const editorContent = page.locator('.editor-component .mu-container')
+    await expect
+      .poll(() =>
+        editorContent.evaluate((element) =>
+          getComputedStyle(element).getPropertyValue('--reading-font-size').trim()
