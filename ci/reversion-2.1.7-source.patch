index 00000000..fe808600
--- /dev/null
+++ b/packages/desktop/src/renderer/src/util/semanticMinimap.ts
@@ -0,0 +1,118 @@
+export type SemanticBlockType =
+  | 'heading'
+  | 'code'
+  | 'quote'
+  | 'table'
+  | 'paragraph'
+  | 'list'
+  | 'divider'
+  | 'diagram'
+
+export interface SemanticBlockSummary {
+  type: SemanticBlockType
+  level?: number
+  depth: number
+  top: number
+  height: number
+}
+
+export interface MinimapMetrics {
+  documentHeight: number
+  viewportHeight: number
+  canvasHeight: number
+  canvasWidth: number
+}
+
+export interface MinimapDrawCommand {
+  type: SemanticBlockType
+  top: number
+  height: number
+  x: number
+  width: number
+}
+
+export interface MagnifierPosition {
+  left: number
+  top: number
+  placement: 'above' | 'below'
+}
+
+const clamp = (value: number, minimum: number, maximum: number): number =>
+  Math.min(Math.max(value, minimum), Math.max(minimum, maximum))
+
+export const documentOffsetFromPointer = (
+  pointerY: number,
+  minimapTop: number,
+  minimapHeight: number,
+  documentHeight: number
+): number => {
+  const ratio = clamp((pointerY - minimapTop) / Math.max(minimapHeight, 1), 0, 1)
+  return ratio * Math.max(documentHeight, 0)
+}
+
+export const createMagnifierPosition = (
+  pointerX: number,
+  pointerY: number,
+  viewportWidth: number,
+  viewportHeight: number,
+  magnifierWidth = 304,
+  magnifierHeight = 208,
+  gap = 14,
+  edge = 8
+): MagnifierPosition => {
+  const left = clamp(pointerX - magnifierWidth - gap, edge, viewportWidth - magnifierWidth - edge)
+  const fitsBelow = pointerY + gap + magnifierHeight <= viewportHeight - edge
+  const placement = fitsBelow ? 'below' : 'above'
+  const desiredTop = fitsBelow
+    ? pointerY + gap
+    : pointerY - magnifierHeight - gap
+  return {
+    left,
+    top: clamp(desiredTop, edge, viewportHeight - magnifierHeight - edge),
+    placement
+  }
+}
+
+const documentScale = ({ documentHeight, viewportHeight, canvasHeight }: MinimapMetrics): number =>
+  documentHeight <= viewportHeight ? 1 : canvasHeight / Math.max(documentHeight, 1)
+
+const blockWidth = (block: SemanticBlockSummary, canvasWidth: number): number => {
+  if (block.type === 'heading') {
+    const level = Math.min(Math.max(block.level ?? 6, 1), 6)
+    return Math.max(5, canvasWidth - (level - 1) * 2 - 1)
+  }
+  if (block.type === 'paragraph') return Math.max(4, canvasWidth * 0.48)
+  if (block.type === 'divider') return canvasWidth - 2
+  return Math.max(4, canvasWidth - 4)
+}
+
+export const createMinimapDrawCommands = (
+  blocks: SemanticBlockSummary[],
+  metrics: MinimapMetrics
+): MinimapDrawCommand[] => {
+  const scale = documentScale(metrics)
+  return blocks.map((block) => {
+    const depthOffset = block.type === 'list' ? Math.min(block.depth * 2, metrics.canvasWidth / 2) : 0
+    const width = Math.min(blockWidth(block, metrics.canvasWidth), metrics.canvasWidth - depthOffset - 1)
+    const headingOffset = block.type === 'heading' ? metrics.canvasWidth - width - 1 : 1
+    return {
+      type: block.type,
+      top: block.top * scale,
+      height: Math.max(block.type === 'divider' ? 1 : 2, block.height * scale),
+      x: Math.max(0.5, depthOffset || headingOffset),
+      width
+    }
+  })
+}
+
+export const createViewportCommand = (
+  metrics: MinimapMetrics & { scrollTop: number }
+): { top: number; height: number; left: number; width: number } => {
+  const scale = documentScale(metrics)
+  return {
+    top: metrics.scrollTop * scale,
+    height: Math.min(metrics.canvasHeight, Math.max(8, metrics.viewportHeight * scale)),
+    left: 0.5,
+    width: metrics.canvasWidth - 1
+  }
+}
