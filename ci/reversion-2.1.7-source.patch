@@ -0,0 +1,163 @@
+<template>
+  <section class="reading-font-picker">
+    <div class="description">
+      <span>{{ description }}</span>
+      <small v-if="effectiveFont">{{ t('preferences.editor.textEditor.effectiveCjkFont') }}: {{ effectiveFont }}</small>
+    </div>
+    <el-autocomplete
+      v-model="selectedValue"
+      class="font-autocomplete"
+      popper-class="font-autocomplete-popper"
+      :fetch-suggestions="queryFonts"
+      :placeholder="t('preferences.selectFont')"
+      @select="handleSelect"
+      @change="handleChange"
+    >
+      <template #suffix>
+        <ArrowDown class="el-input__icon" />
+      </template>
+      <template #default="{ item }">
+        <span :style="previewStyle(item.value)">{{ labelFor(item.value) }}</span>
+      </template>
+    </el-autocomplete>
+    <p class="preview" :style="previewStyle(value)">{{ previewText }}</p>
+  </section>
+</template>
+
+<script setup lang="ts">
+import { computed, onMounted, ref, watch } from 'vue'
+import { ArrowDown } from '@element-plus/icons-vue'
+import { useI18n } from 'vue-i18n'
+import {
+  browserCjkFontCheck,
+  quoteUserFontFamily,
+  resolveEffectiveCjkFont
+} from '@/util/readingFonts'
+
+interface FontOption {
+  value: string
+}
+
+interface ReadingFontPickerProps {
+  description: string
+  value: string
+  previewText: string
+  cjkOnly?: boolean
+  effectiveStack?: string
+  onChange: (value: string) => void
+}
+
+const props = withDefaults(defineProps<ReadingFontPickerProps>(), {
+  cjkOnly: false,
+  effectiveStack: ''
+})
+
+const { t } = useI18n()
+const selectedValue = ref(props.value)
+const fontOptions = ref<FontOption[]>([{ value: 'theme' }])
+const effectiveFont = ref('')
+
+const previewFamily = computed(() =>
+  props.value === 'theme' ? 'inherit' : quoteUserFontFamily(props.value)
+)
+
+watch(
+  () => props.value,
+  (value) => {
+    selectedValue.value = labelFor(value)
+  }
+)
+
+watch(
+  () => t('preferences.editor.textEditor.followTheme'),
+  () => {
+    if (props.value === 'theme') selectedValue.value = labelFor('theme')
+  }
+)
+
+watch(
+  () => props.effectiveStack,
+  async (stack) => {
+    effectiveFont.value = stack ? (await resolveEffectiveCjkFont(stack, browserCjkFontCheck)) ?? '' : ''
+  },
+  { immediate: true }
+)
+
+const labelFor = (value: string): string =>
+  value === 'theme' ? t('preferences.editor.textEditor.followTheme') : value
+
+const previewStyle = (value: string): Record<string, string> => ({
+  fontFamily: value === 'theme' ? 'inherit' : quoteUserFontFamily(value)
+})
+
+const queryFonts = (query: string, callback: (items: FontOption[]) => void): void => {
+  const normalized = query.trim().toLocaleLowerCase()
+  callback(
+    normalized
+      ? fontOptions.value.filter((item) => labelFor(item.value).toLocaleLowerCase().includes(normalized))
+      : fontOptions.value
+  )
+}
+
+const commitValue = (value: string): void => {
+  const option = fontOptions.value.find(
+    (item) => item.value === value || labelFor(item.value) === value
+  )
+  if (option) {
+    selectedValue.value = labelFor(option.value)
+    props.onChange(option.value)
+  } else {
+    selectedValue.value = labelFor(props.value)
+  }
+}
+
+const handleSelect = (item: FontOption): void => commitValue(item.value)
+const handleChange = (value: string): void => commitValue(value)
+
+onMounted(async () => {
+  selectedValue.value = labelFor(props.value)
+  const fonts = ((await window.fonts.list()) || [])
+    .map((font) => font.replace(/"/g, '').trim())
+    .filter(Boolean)
+  const uniqueFonts = [...new Set(fonts)].sort((a, b) => a.localeCompare(b))
+  const visibleFonts = props.cjkOnly
+    ? (
+        await Promise.all(
+          uniqueFonts.map(async (font) => ((await browserCjkFontCheck(font)) ? font : null))
+        )
+      ).filter((font): font is string => Boolean(font))
+    : uniqueFonts
+  fontOptions.value = [{ value: 'theme' }, ...visibleFonts.map((value) => ({ value }))]
+})
+</script>
+
+<style scoped>
+.reading-font-picker {
+  margin: 12px 0;
+  color: var(--editorColor);
+  font-size: 14px;
+}
+
+.description {
+  display: flex;
+  justify-content: space-between;
+  gap: 12px;
+  margin-bottom: 10px;
+}
+
+.description small {
+  color: var(--editorColor50);
+  font-size: 11px;
+}
+
+.font-autocomplete {
+  width: 100%;
+}
+
+.preview {
+  margin: 8px 0 0;
+  color: var(--editorColor70);
+  font-family: v-bind(previewFamily);
+  font-size: 15px;
+}
+</style>
