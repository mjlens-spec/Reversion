+    if (!(await page.locator('.side-bar-toc').isVisible())) {
+      await clickMenuById(app, 'tocMenuItem')
+    }
     await page.waitForSelector('.side-bar-toc .el-tree', { state: 'visible', timeout: 10000 })
     // The tree is seeded from `editor.getTOC()` on mount. Wait until every
     // initial heading has rendered a node before asserting.
diff --git a/packages/desktop/test/e2e/toc-word-wrap.spec.ts b/packages/desktop/test/e2e/toc-word-wrap.spec.ts
new file mode 100644
index 00000000..b7703f8c
--- /dev/null
+++ b/packages/desktop/test/e2e/toc-word-wrap.spec.ts
@@ -0,0 +1,97 @@
+import { expect, test } from '@playwright/test'
+import type { ElectronApplication, Page } from 'playwright'
+import { clickMenuById, launchWithMarkdown } from './helpers'
+
+const LONG_HEADING =
+  '何以至此 · 选题库 | 2026 年 7 月 30 日选题综述与证据边界以及后续研究方向'
+
+const ensureTocVisible = async(app: ElectronApplication, page: Page): Promise<void> => {
+  const sideBar = page.locator('.side-bar')
+  if (!(await sideBar.isVisible())) {
+    await clickMenuById(app, 'sideBarMenuItem')
+  }
+  if (!(await page.locator('.side-bar-toc').isVisible())) {
+    await clickMenuById(app, 'tocMenuItem')
+  }
+  await page.waitForSelector('.side-bar-toc .el-tree-node__label', {
+    state: 'visible',
+    timeout: 10000
+  })
+}
+
+const readSplitRatio = (page: Page): Promise<number> =>
+  page.evaluate(() => {
+    const sideBar = document.querySelector('.side-bar') as HTMLElement | null
+    const editor = document.querySelector('.editor-with-tabs') as HTMLElement | null
+    const sideBarWidth = sideBar?.getBoundingClientRect().width ?? 0
+    const editorWidth = editor?.getBoundingClientRect().width ?? 0
+    return editorWidth / sideBarWidth
+  })
+
+test('TOC headings wrap and an app restart restores the 1:3 split', async() => {
+  test.setTimeout(60000)
+  const launched = await launchWithMarkdown(`# ${LONG_HEADING}\n\n正文\n`)
+  let app: ElectronApplication | null = launched.app
+  let page = launched.page
+
+  try {
+    await ensureTocVisible(app, page)
+
+    expect(await readSplitRatio(page)).toBeCloseTo(3, 2)
+
+    // Exercise the real pointer path: a manual drag must take effect now, but
+    // the custom width is intentionally discarded on the next app launch.
+    const sideBar = page.locator('.side-bar')
+    const initialWidth = await sideBar.evaluate((element) => element.getBoundingClientRect().width)
+    const dragBarBox = await page.locator('.side-bar .drag-bar').boundingBox()
+    if (!dragBarBox) throw new Error('Sidebar drag bar not found')
+    await page.mouse.move(dragBarBox.x + dragBarBox.width / 2, dragBarBox.y + 80)
+    await page.mouse.down()
+    await page.mouse.move(dragBarBox.x + 100, dragBarBox.y + 80, { steps: 8 })
+    await page.mouse.up()
+    await page.waitForFunction((previousWidth) => {
+      const sideBar = document.querySelector('.side-bar') as HTMLElement | null
+      return !!sideBar && sideBar.getBoundingClientRect().width >= previousWidth + 80
+    }, initialWidth, { timeout: 5000 })
+
+    const metrics = await page.locator('.side-bar-toc .el-tree-node__label').first().evaluate(
+      (label) => {
+        const el = label as HTMLElement
+        const style = window.getComputedStyle(el)
+        const lineHeight = Number.parseFloat(style.lineHeight)
+        return {
+          height: el.getBoundingClientRect().height,
+          lineHeight,
+          whiteSpace: style.whiteSpace,
+          overflowWrap: style.overflowWrap,
+          scrollWidth: el.scrollWidth,
+          clientWidth: el.clientWidth
+        }
+      }
+    )
+
+    expect(metrics.whiteSpace).toBe('normal')
+    expect(metrics.height).toBeGreaterThan(metrics.lineHeight * 1.5)
+    expect(metrics.scrollWidth).toBeLessThanOrEqual(metrics.clientWidth + 1)
+
+    // Restart the actual app with the same profile after the drag stored a
+    // custom width. It must be discarded in favour of the current viewport's
+    // 1:3 split.
+    await app.close()
+    app = null
+    const reopened = await launchWithMarkdown(`# ${LONG_HEADING}\n\n正文\n`, {
+      userDataDir: launched.userDataDir
+    })
+    app = reopened.app
+    page = reopened.page
+    await ensureTocVisible(app, page)
+    expect(await readSplitRatio(page)).toBeCloseTo(3, 2)
+
+    const sidebarScreenshotPath = process.env.REVERSION_SIDEBAR_SCREENSHOT
+    if (sidebarScreenshotPath) {
+      await page.screenshot({ path: sidebarScreenshotPath })
+    }
+  } finally {
+    if (app) await app.close()
+  }
+})
