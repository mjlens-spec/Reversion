diff --git a/packages/desktop/src/main/app/dockIcon.ts b/packages/desktop/src/main/app/dockIcon.ts
new file mode 100644
index 00000000..99d5bdd8
--- /dev/null
+++ b/packages/desktop/src/main/app/dockIcon.ts
@@ -0,0 +1,27 @@
+import fs from 'fs'
+import path from 'path'
+import { app } from 'electron'
+import log from 'electron-log'
+import { isOsx } from '../config'
+
+/**
+ * Apply the user-selected Dock icon. macOS only; the bundle (Finder) icon is
+ * fixed at build time, so this covers the Dock, Cmd+Tab and Mission Control.
+ * Icons ship as static/appIcons/<id>.png; an unknown id keeps the current
+ * icon untouched.
+ */
+export const applyDockIcon = (iconId: unknown): void => {
+  if (!isOsx || typeof iconId !== 'string' || !/^[\w-]+$/.test(iconId)) {
+    return
+  }
+  const iconPath = path.join(global.__static, 'appIcons', `${iconId}.png`)
+  if (!fs.existsSync(iconPath)) {
+    log.warn(`Dock icon "${iconId}" not found at ${iconPath}.`)
+    return
+  }
+  try {
+    app.dock?.setIcon(iconPath)
+  } catch (err) {
+    log.error(`Failed to set Dock icon "${iconId}":`, err)
+  }
+}
