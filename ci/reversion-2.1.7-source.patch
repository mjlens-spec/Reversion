diff --git a/packages/desktop/test/e2e/export-dialog-overlay.spec.ts b/packages/desktop/test/e2e/export-dialog-overlay.spec.ts
new file mode 100644
index 00000000..f4d8d4ef
--- /dev/null
+++ b/packages/desktop/test/e2e/export-dialog-overlay.spec.ts
@@ -0,0 +1,193 @@
+import { expect, test } from '@playwright/test'
+import type { ElectronApplication, Page } from 'playwright'
+import sharp from 'sharp'
+import { launchWithMarkdown, waitForMenuReady, sendIpcToRenderer } from './helpers'
+
+// The engine's float tools are appended to <body> at z-index 10000 and driven by
+// `document.elementsFromPoint`, which ignores stacking order. Before the fix,
+// moving the pointer across the open export dialog found the table cell painted
+// behind it and popped the table column toolbar on top of the dialog.
+
+const TABLE_DOC =
+  '# Table\n\n| Column A | Column B |\n| --- | --- |\n' +
+  Array.from({ length: 40 }, (_, i) => `| row ${i} | value ${i} |`).join('\n') +
+  '\n'
+
+const openExportDialog = async(app: ElectronApplication, page: Page): Promise<void> => {
+  await sendIpcToRenderer(app, 'mt::show-export-dialog', 'png')
+  await page
+    .locator('.print-settings-dialog .button-primary')
+    .waitFor({ state: 'visible', timeout: 10000 })
+}
+
+const expectDialogToBePainted = async(page: Page): Promise<void> => {
+  const primaryButton = page.locator('.print-settings-dialog .button-primary')
+  const paintState = await primaryButton.evaluate((button) => {
+    const rect = button.getBoundingClientRect()
+    const hit = document.elementFromPoint(rect.left + rect.width / 2, rect.top + rect.height / 2)
+    const describe = (element: Element | null): string => {
+      if (!element) return 'null'
+      const className =
+        typeof element.className === 'string'
+          ? `.${element.className.trim().replace(/\s+/g, '.')}`
+          : ''
+      return `${element.tagName.toLowerCase()}${className}`
+    }
+
+    return {
+      hitWithinButton: hit === button || button.contains(hit),
+      hit: describe(hit),
+      button: describe(button),
+      rect: { x: rect.x, y: rect.y, width: rect.width, height: rect.height },
+      ancestors: Array.from(
+        document.querySelectorAll('.print-settings-dialog, .el-overlay, .el-dialog')
+      ).map((element) => {
+        const style = getComputedStyle(element)
+        const elementRect = element.getBoundingClientRect()
+        return {
+          element: describe(element),
+          display: style.display,
+          pointerEvents: style.pointerEvents,
+          position: style.position,
+          zIndex: style.zIndex,
+          rect: {
+            x: elementRect.x,
+            y: elementRect.y,
+            width: elementRect.width,
+            height: elementRect.height
+          }
+        }
+      })
+    }
+  })
+
+  expect(
+    paintState.hitWithinButton,
+    `the visible export button must be the topmost painted element at its center: ${JSON.stringify(paintState)}`
+  ).toBe(true)
+
+  const screenshot = await page.screenshot()
+  const stats = await sharp(screenshot).stats()
+  expect(
+    Math.max(...stats.channels.slice(0, 3).map((channel) => channel.stdev)),
+    'opening export must not turn the renderer into a flat white frame'
+  ).toBeGreaterThan(2)
+}
+
+// A point that sits over the dialog and, 27px lower (the toolbar's own probe
+// offset), over a table cell painted behind it — the exact geometry that used
+// to trigger the leak.
+const findProbePoint = async(page: Page): Promise<{ x: number; y: number } | null> =>
+  await page.evaluate(() => {
+    const dialog = document.querySelector('.print-settings-dialog .el-dialog')
+    if (!dialog) return null
+    const dRect = dialog.getBoundingClientRect()
+    const cells = Array.from(document.querySelectorAll('.mu-editor table td, .mu-editor table th'))
+    for (const cell of cells) {
+      const r = cell.getBoundingClientRect()
+      const x = r.left + r.width / 2
+      const y = r.top - 12
+      if (x > dRect.left + 10 && x < dRect.right - 10 && y > dRect.top + 10 && y < dRect.bottom - 10) {
+        return { x, y }
+      }
+    }
+    return null
+  })
+
+// A hidden float keeps its wrapper in the DOM — `BaseFloat.hide()` parks it at
+// -9999px with opacity 0 — so visibility has to be read off those properties
+// rather than from `display` or the mere presence of the node.
+const visibleFloats = async(page: Page): Promise<string[]> =>
+  await page.evaluate(() =>
+    Array.from(document.querySelectorAll('.mu-float-wrapper'))
+      .filter((el) => {
+        const style = getComputedStyle(el)
+        if (style.display === 'none' || style.visibility === 'hidden') return false
+        if (Number.parseFloat(style.opacity) === 0) return false
+        const rect = el.getBoundingClientRect()
+        return rect.width > 0 && rect.right > 0 && rect.bottom > 0
+      })
+      .map((el) => el.className)
+  )
+
+test.describe('export dialog does not let engine floats paint over it', () => {
+  let app: ElectronApplication
+  let page: Page
+
+  test.beforeAll(async() => {
+    const launched = await launchWithMarkdown(TABLE_DOC)
+    app = launched.app
+    page = launched.page
+    await waitForMenuReady(app)
+  })
+
+  test.afterAll(async() => {
+    if (app) await app.close()
+  })
+
+  // The guard that keeps float tools off the dialog works by dropping the
+  // editor from hit-testing. Keyed on the wrong signal it stays on forever and
+  // the editor silently stops accepting clicks, so pin down the closed state.
+  test('the editor still takes clicks while no dialog is open', async() => {
+    await expect(page.locator('.print-settings-dialog .el-dialog')).toBeHidden()
+    expect(
+      await page.evaluate(
+        () => getComputedStyle(document.querySelector('.editor-wrapper')!).pointerEvents
+      )
+    ).not.toBe('none')
+
+    await page.locator('.editor-component.mu-editor').getByText('row 3').first().click()
+    expect(await page.evaluate(() => document.getSelection()?.rangeCount ?? 0)).toBeGreaterThan(0)
+  })
+
+  test('the PDF export dialog is painted and receives pointer input', async() => {
+    await sendIpcToRenderer(app, 'mt::show-export-dialog', 'pdf')
+    await page
+      .locator('.print-settings-dialog .button-primary')
+      .waitFor({ state: 'visible', timeout: 10000 })
+
+    await expectDialogToBePainted(page)
+    await page.locator('.print-settings-dialog .button-cancel').click()
+    await expect(page.locator('.print-settings-dialog .el-dialog')).toBeHidden({ timeout: 5000 })
+  })
+
+  test('hovering the open dialog over a table does not pop a float tool', async() => {
+    await openExportDialog(app, page)
+    const probe = await findProbePoint(page)
+    expect(probe, 'the dialog should overlap the table').not.toBeNull()
+
+    // The toolbar handler is throttled at 300ms; sweep a few offsets around the
+    // row edge so a near-miss cannot pass the test by accident.
+    for (const dy of [0, -8, -4, 4, 8, 12]) {
+      await page.mouse.move(probe!.x, probe!.y + dy)
+      await page.waitForTimeout(360)
+      expect(await visibleFloats(page), `float shown at dy=${dy}`).toEqual([])
+    }
+
+    await page.keyboard.press('Escape')
+    await expect(page.locator('.print-settings-dialog .el-dialog')).toBeHidden({ timeout: 5000 })
+  })
+
+  test('the cancel button closes the dialog without exporting', async() => {
+    await openExportDialog(app, page)
+
+    let exported = false
+    await app.evaluate(({ ipcMain }) => {
