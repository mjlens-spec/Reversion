+import type { Page } from '@playwright/test';
+import { expect, test } from '../fixtures/muya';
+import { getMarkdown } from '../helpers/api';
+import { editor } from '../helpers/selectors';
+
+/**
+ * `Muya.tableOperation` is the entry point a host menu drives — the desktop
+ * table context menu. The same operations exist behind the floating table
+ * tools, which are only reachable by hovering the right few pixels.
+ */
+const TABLE = '| h1 | h2 |\n| --- | --- |\n| a1 | a2 |\n| b1 | b2 |\n';
+
+async function seed(page: Page) {
+    await page.evaluate(md => window.muya!.setContent(md), TABLE);
+    await expect(page.locator(editor.table).first()).toBeVisible();
+}
+
+/** Put the caret in the (row, column) cell, then run `operation`. */
+async function runAt(page: Page, row: number, column: number, operation: string) {
+    await page.locator(`${editor.table} tr`).nth(row).locator('td').nth(column).click();
+    // The click's selection update lands through the editor's merged event
+    // stream, so `tableOperation` can otherwise read a caret that has not moved
+    // into the cell yet and report "not in a table".
+    await expect
+        .poll(() => page.evaluate(() => {
+            const anchor = window.muya!.editor.selection.anchorBlock;
+            return anchor?.blockName ?? null;
+        }))
+        .toBe('table.cell.content');
+
+    return page.evaluate(
+        op => (window.muya as unknown as { tableOperation: (o: string) => boolean }).tableOperation(op),
+        operation,
+    );
+}
+
+test.describe('Muya.tableOperation', () => {
+    test('inserts and removes rows relative to the caret', async ({ page }) => {
+        await seed(page);
+        expect(await runAt(page, 1, 0, 'insertRowBelow')).toBe(true);
+        await expect(page.locator(`${editor.table} tr`)).toHaveCount(4);
+
+        expect(await runAt(page, 1, 0, 'removeRow')).toBe(true);
+        await expect(page.locator(`${editor.table} tr`)).toHaveCount(3);
+        await expect.poll(() => getMarkdown(page)).toMatch(/\| b1/);
+    });
+
+    test('inserts and removes columns relative to the caret', async ({ page }) => {
+        await seed(page);
+        expect(await runAt(page, 1, 0, 'insertColumnRight')).toBe(true);
+        await expect(page.locator(`${editor.table} tr`).first().locator('td')).toHaveCount(3);
+
+        expect(await runAt(page, 1, 1, 'removeColumn')).toBe(true);
+        await expect(page.locator(`${editor.table} tr`).first().locator('td')).toHaveCount(2);
+    });
+
+    test('alignment writes through to the markdown separator row', async ({ page }) => {
+        await seed(page);
+        expect(await runAt(page, 1, 1, 'alignColumnCenter')).toBe(true);
+        await expect.poll(() => getMarkdown(page)).toContain(':-');
+    });
+
+    test('removeTable leaves an empty paragraph behind', async ({ page }) => {
+        await seed(page);
+        expect(await runAt(page, 1, 0, 'removeTable')).toBe(true);
+        await expect(page.locator(editor.table)).toHaveCount(0);
+        await expect(page.locator(editor.paragraph)).toHaveCount(1);
+    });
+
+    // A host menu can fire without knowing where the caret is; saying so
+    // beats mutating whatever block happens to be focused.
+    test('returns false when the caret is not in a table', async ({ page }) => {
+        await page.evaluate(() => window.muya!.setContent('just a paragraph'));
+        await page.locator(editor.paragraph).first().click();
+        const handled = await page.evaluate(() =>
+            (window.muya as unknown as { tableOperation: (o: string) => boolean }).tableOperation('removeRow'));
+        expect(handled).toBe(false);
+        expect(await getMarkdown(page)).toContain('just a paragraph');
+    });
+});
diff --git a/packages/muya/e2e/tests/blocks/table-wide-scroll.spec.ts b/packages/muya/e2e/tests/blocks/table-wide-scroll.spec.ts
new file mode 100644
index 00000000..c4d3b9a8
--- /dev/null
+++ b/packages/muya/e2e/tests/blocks/table-wide-scroll.spec.ts
@@ -0,0 +1,85 @@
+import { expect, test } from '../fixtures/muya';
+import { editor, floats } from '../helpers/selectors';
+
+/**
+ * A table wider than the editor column used to push the whole document into a
+ * horizontal scroll — the Reversion themes worked around it by shrinking table
+ * text to 13px, which only moved the threshold. The figure is its own scroll
+ * container now.
+ */
+const COLUMNS = 20;
+
+function wideTable(): string {
+    const header = `| ${Array.from({ length: COLUMNS }, (_, i) => `column-header-${i}`).join(' | ')} |`;
+    const separator = `| ${Array.from({ length: COLUMNS }, () => '---').join(' | ')} |`;
+    const body = `| ${Array.from({ length: COLUMNS }, (_, i) => `cell-value-${i}`).join(' | ')} |`;
+    return `${header}\n${separator}\n${body}\n`;
+}
+
+test.describe('wide table', () => {
+    test('scrolls inside its own figure, not the document', async ({ page }) => {
+        await page.evaluate(md => window.muya!.setContent(md), wideTable());
+        await expect(page.locator(editor.table).first()).toBeVisible();
+
+        const geometry = await page.evaluate(() => {
+            const figure = document.querySelector('.mu-table') as HTMLElement;
+            return {
+                overflowX: getComputedStyle(figure).overflowX,
+                figureScrollWidth: figure.scrollWidth,
+                figureClientWidth: figure.clientWidth,
+                bodyScrollWidth: document.body.scrollWidth,
+                bodyClientWidth: document.body.clientWidth,
+            };
+        });
+
+        expect(geometry.overflowX).toBe('auto');
+        // The content really is wider than the figure — otherwise the scroll
+        // container proves nothing.
+        expect(geometry.figureScrollWidth).toBeGreaterThan(geometry.figureClientWidth);
+        // …and that overflow stays inside the figure.
+        expect(geometry.bodyScrollWidth).toBeLessThanOrEqual(geometry.bodyClientWidth + 1);
+    });
+
+    // The table tools are BaseFloat instances anchored in document.body and
+    // positioned by floating-ui against a cell. Scrolling the figure moves that
+    // cell, and the float has to follow it rather than stay behind.
+    test('the column toolbar follows a cell scrolled inside the figure', async ({ page }) => {
+        await page.evaluate(md => window.muya!.setContent(md), wideTable());
+        const table = page.locator(editor.table).first();
+        await expect(table).toBeVisible();
+
+        // Hover just above the second column's header — the toolbar's handler
+        // wants the cursor outside every cell with `(x, y + 27)` inside one.
+        // It is throttled at 300ms, so keep nudging until it reveals rather
+        // than assuming one pair of moves lands inside the window.
+        const headerCell = table.locator('tr').first().locator('td').nth(1);
+        const box = (await headerCell.boundingBox())!;
+        const toolbar = page.locator(floats.tableColumnTools).first();
+        // A parked baseFloat still reports a bounding box, so read the
+        // wrapper's opacity to tell shown from parked.
+        const opacity = () =>
+            toolbar.evaluate((el) => {
+                const wrapper = el.closest('.mu-float-wrapper') as HTMLElement | null;
+                return Number.parseFloat(wrapper?.style.opacity || '0');
+            });
+
+        await expect
+            .poll(async () => {
+                await page.mouse.move(box.x + box.width / 2, box.y - 10);
+                await page.mouse.move(box.x + box.width / 2, box.y - 9);
+
+                return opacity();
+            }, { timeout: 10_000, intervals: [100, 200, 400] })
+            .toBeGreaterThan(0);
+
+        const before = (await toolbar.boundingBox())!;
+        await page.evaluate(() => {
+            (document.querySelector('.mu-table') as HTMLElement).scrollLeft = 300;
+        });
+        // floating-ui's autoUpdate reacts to the ancestor scroll on a later
+        // frame, so poll rather than sampling once.
+        await expect
+            .poll(async () => (await toolbar.boundingBox())!.x)
+            .toBeLessThan(before.x - 250);
+    });
+});
