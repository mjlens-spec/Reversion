@@ -0,0 +1,470 @@
+import { expect, test } from '@playwright/test'
+import type { ElectronApplication, Page } from 'playwright'
+import {
+  clickMenuById,
+  launchElectron,
+  launchWithMarkdown,
+  sendIpcToRenderer,
+  waitForEditor,
+  waitForMenuReady
+} from './helpers'
+
+const DOCUMENT = `# Reversion 2.0
+
+This page combines **clear writing** with <mark data-color="green">colorful highlights</mark>.
+
+> A calm interface keeps the document in focus while structure remains visible.
+
+## Document state
+
+\`\`\`mermaid
+stateDiagram-v2
+  [*] --> Draft
+  Draft --> Review
+  Review --> Published
+\`\`\`
+
+## Notes
+
+- Search commands in English or Chinese
+- Drag the semantic minimap to navigate
+
+| Item | Decision | Result |
+| --- | --- | --- |
+| D1 | **Compact table type** | Body text stays larger than \`inline code\` in cells |
+
+${Array.from({ length: 48 }, (_, index) => `Long-document paragraph ${index + 1}: Reversion keeps Chinese and English writing readable while the document grows.`).join('\n\n')}
+`
+
+test.describe('Reversion 2.0 experience', () => {
+  let app: ElectronApplication
+  let page: Page
+  let userDataDir: string
+  let filePath: string
+
+  test.beforeAll(async() => {
+    const launched = await launchWithMarkdown(DOCUMENT, { suppressErrorDialog: true })
+    app = launched.app
+    page = launched.page
+    userDataDir = launched.userDataDir
+    filePath = launched.filePath
+  })
+
+  test.afterAll(async() => {
+    if (app) await app.close()
+  })
+
+  test('starts a fresh profile with the Claude-like theme', async() => {
+    const theme = await page.evaluate(() => {
+      const style = getComputedStyle(document.documentElement)
+      return {
+        accent: style.getPropertyValue('--claude-accent').trim().toLowerCase(),
+        background: style.getPropertyValue('--claude-bg').trim().toLowerCase()
+      }
+    })
+    expect(theme.accent).toBe('#bc6a3a')
+    expect(theme.background).toBe('#f7f6f3')
+  })
+
+  test('keeps Claude like and Lens Design unchanged in dark appearance', async() => {
+    for (const [theme, token, expected] of [
+      ['claude-like', '--claude-bg', '#f7f6f3'],
+      ['lens-design', '--lens-paper', '#f4f6f8']
+    ] as const) {
+      await page.evaluate(({ theme }) => {
+        window.electron.ipcRenderer.send('mt::set-user-preference', {
+          appearance: 'dark',
+          theme
+        })
+      }, { theme })
+
+      await expect
+        .poll(() => page.evaluate(() => document.documentElement.dataset.reversionAppearance))
+        .toBe('light')
+      await expect
+        .poll(() => page.evaluate((token) =>
+          getComputedStyle(document.documentElement).getPropertyValue(token).trim().toLowerCase(), token
+        ))
+        .toBe(expected)
+      expect(await page.evaluate(() => document.body.classList.contains('dark'))).toBe(false)
+      expect(await app.evaluate(({ nativeTheme }) => nativeTheme.themeSource)).toBe('light')
+
+      const screenshotPath = theme === 'claude-like'
+        ? process.env.REVERSION_CLAUDE_FIXED_LIGHT_SCREENSHOT
+        : process.env.REVERSION_LENS_FIXED_LIGHT_SCREENSHOT
+      if (screenshotPath) await page.screenshot({ path: screenshotPath })
+    }
+
+    await page.evaluate(() => {
+      window.electron.ipcRenderer.send('mt::set-user-preference', {
+        appearance: 'system',
+        theme: 'claude-like'
+      })
+    })
+  })
+
+  test('opens a visible About Reversion dialog from the application menu', async() => {
+    await clickMenuById(app, 'aboutMenuItem')
+
+    const overlay = page.locator('.about-dialog')
+    const panel = page.locator('.about-dialog__panel')
+    await expect(overlay).toBeVisible()
+    await expect(panel).toBeVisible()
+    await expect(panel).toContainText('Reversion · 反文')
+    await expect(panel).toContainText('Based on MarkText (MIT License)')
+
+    const visual = await panel.evaluate((element) => {
+      const panelStyle = getComputedStyle(element)
+      const overlayStyle = getComputedStyle(element.parentElement as HTMLElement)
+      const rect = element.getBoundingClientRect()
+      return {
+        width: rect.width,
+        height: rect.height,
+        background: panelStyle.backgroundColor,
+        color: panelStyle.color,
+        overlay: overlayStyle.backgroundColor,
+        opacity: panelStyle.opacity,
+        visibility: panelStyle.visibility
+      }
+    })
+    expect(visual.width).toBeGreaterThanOrEqual(360)
+    expect(visual.height).toBeGreaterThan(250)
+    expect(visual.background).not.toBe('rgba(0, 0, 0, 0)')
+    expect(visual.overlay).not.toBe('rgba(0, 0, 0, 0)')
+    expect(visual.color).not.toBe(visual.background)
+    expect(visual.opacity).toBe('1')
+    expect(visual.visibility).toBe('visible')
+
+    const aboutScreenshotPath = process.env.REVERSION_ABOUT_SCREENSHOT
+    if (aboutScreenshotPath) {
+      await page.screenshot({ path: aboutScreenshotPath })
+    }
+
+    await panel.locator('.about-dialog__close').click()
+    await expect(overlay).toBeHidden()
+  })
+
+  test('renders the attached sidebar, visual document blocks and semantic minimap', async() => {
+    const sidebar = page.locator('#reversion-sidebar')
+    if (!(await sidebar.isVisible())) await clickMenuById(app, 'sideBarMenuItem')
+    await expect(sidebar).toBeVisible()
+
+    const sidebarStyle = await sidebar.evaluate((element) => {
+      const style = getComputedStyle(element)
+      return {
+        radius: style.borderRadius,
+        borderRight: style.borderRightWidth,
+        backdrop: style.backdropFilter
+      }
+    })
+    expect(sidebarStyle.radius).toBe('0px')
+    expect(sidebarStyle.borderRight).toBe('1px')
+    expect(sidebarStyle.backdrop).toContain('blur')
+
+    const minimap = page.locator('.semantic-minimap')
+    await expect(minimap).toBeVisible()
+    expect(
+      await minimap.locator('canvas').evaluate((canvas) => (canvas as HTMLCanvasElement).width)
+    ).toBeGreaterThan(0)
+
+    const quote = page.locator('.mu-container blockquote').first()
+    await expect(quote).toBeVisible()
+    expect(await quote.evaluate((element) => getComputedStyle(element).borderLeftWidth)).toBe('4px')
+
+    const highlight = page.locator('.mu-container mark').first()
+    await expect(highlight).toBeVisible()
+    const highlightStyle = await highlight.evaluate((element) => {
+      const style = getComputedStyle(element)
+      return { image: style.backgroundImage, color: style.backgroundColor }
+    })
+    expect(highlightStyle.image).toBe('none')
+    expect(highlightStyle.color).not.toBe('rgba(0, 0, 0, 0)')
+
+    const diagram = page.locator('figure.mu-diagram-block .mu-diagram-preview').first()
+    await expect(diagram).toBeVisible({ timeout: 10000 })
+    expect(await diagram.evaluate((element) => getComputedStyle(element).borderRadius)).toBe('16px')
+
+    const screenshotPath = process.env.REVERSION_QA_SCREENSHOT
+    if (screenshotPath) {
+      await app.evaluate(({ BrowserWindow }) => {
+        BrowserWindow.getAllWindows()[0]?.setSize(1972, 1126)
+      })
+      await page.waitForTimeout(250)
+      await page.screenshot({ path: screenshotPath })
+    }
+  })
+
+  test('searches the command catalog in Chinese and English', async() => {
+    await sendIpcToRenderer(app, 'mt::show-command-palette')
+    const input = page.locator('input.search').first()
+    await expect(input).toBeVisible()
+    await input.fill('切换侧边栏')
+    await expect(page.locator('[data-section="commands"] .result-item').first()).toContainText(
+      '切换侧边栏'
+    )
+    await page.keyboard.press('Escape')
+
+    await sendIpcToRenderer(app, 'mt::show-command-palette')
+    await input.fill('toggle sidebar')
+    await expect(page.locator('[data-section="commands"] .result-item').first()).toContainText(
+      'Toggle Sidebar'
+    )
+    await page.keyboard.press('Escape')
+  })
+
+  test('hides the minimap in source mode and restores it afterwards', async() => {
+    const minimap = page.locator('.semantic-minimap')
+    await clickMenuById(app, 'sourceCodeModeMenuItem')
+    await expect(minimap).toBeHidden()
+    await clickMenuById(app, 'sourceCodeModeMenuItem')
+    await expect(minimap).toBeVisible()
+  })
+
+  test('uses a 76% live reading measure, compact table type and a short document tail', async() => {
+    await app.evaluate(({ BrowserWindow }) => {
+      BrowserWindow.getAllWindows()[0]?.setSize(1800, 1200)
+    })
+    await page.waitForTimeout(200)
+
+    const editor = page.locator('.editor-component')
+    const container = editor.locator('.mu-container')
+    const readingMeasure = await container.evaluate((element) => {
+      const style = getComputedStyle(element)
+      const editor = element.closest('.editor-component') as HTMLElement
+      const editorRect = editor.getBoundingClientRect()
+      const editorWidth = editor.clientWidth
+      const containerRect = element.getBoundingClientRect()
+      const paddingLeft = Number.parseFloat(style.paddingLeft)
+      const paddingRight = Number.parseFloat(style.paddingRight)
+      const textLeft = containerRect.left + paddingLeft
+      const textRight = containerRect.right - paddingRight
+      return {
+        textShare: (textRight - textLeft) / editorWidth,
+        leftShare: (textLeft - editorRect.left) / editorWidth,
+        rightShare: (editorRect.left + editorWidth - textRight) / editorWidth
+      }
+    })
+    expect(readingMeasure.textShare).toBeCloseTo(0.76, 2)
+    expect(readingMeasure.leftShare).toBeCloseTo(0.12, 2)
+    expect(readingMeasure.rightShare).toBeCloseTo(0.12, 2)
+
+    const bodyFontSize = await container.evaluate((element) =>
+      Number.parseFloat(getComputedStyle(element).fontSize)
+    )
+    const tableFontSizes = await container
+      .locator('table :is(td, th), table :is(td, th) *')
+      .evaluateAll((elements) =>
+        elements
+          .filter((element) => element.textContent?.trim())
+          .map((element) => Number.parseFloat(getComputedStyle(element).fontSize))
+      )
+    expect(tableFontSizes.length).toBeGreaterThan(0)
+    for (const fontSize of tableFontSizes) {
+      expect(fontSize).toBeCloseTo(bodyFontSize - 2, 1)
+    }
+
+    const layoutScreenshotPath = process.env.REVERSION_LAYOUT_SCREENSHOT
+    if (layoutScreenshotPath) {
+      await container.locator('table').scrollIntoViewIfNeeded()
+      await page.waitForTimeout(150)
+      await page.screenshot({ path: layoutScreenshotPath })
+    }
+
+    const tail = await editor.evaluate((element) => {
+      element.scrollTop = element.scrollHeight
+      const containerElement = element.querySelector('.mu-container') as HTMLElement
+      const lastBlock = containerElement.lastElementChild as HTMLElement
+      const editorRect = element.getBoundingClientRect()
+      const lastBlockRect = lastBlock.getBoundingClientRect()
+      return {
+        paddingBottom: Number.parseFloat(getComputedStyle(containerElement).paddingBottom),
+        visibleGapAfterLastBlock: editorRect.bottom - lastBlockRect.bottom
+      }
+    })
+    expect(tail.paddingBottom).toBe(64)
+    expect(tail.visibleGapAfterLastBlock).toBeGreaterThanOrEqual(64)
+    expect(tail.visibleGapAfterLastBlock).toBeLessThan(96)
+
+    const tailScreenshotPath = process.env.REVERSION_TAIL_SCREENSHOT
+    if (tailScreenshotPath) {
