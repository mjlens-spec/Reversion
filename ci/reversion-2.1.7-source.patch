@@ -0,0 +1,20 @@
+export interface TypewriterCenterState {
+  enabled: boolean
+  sourceCode: boolean
+  inputOnly: boolean
+  inputPending: boolean
+  composing: boolean
+}
+
+export const shouldCenterTypewriter = (state: TypewriterCenterState): boolean =>
+  state.enabled &&
+  !state.sourceCode &&
+  !state.composing &&
+  (!state.inputOnly || state.inputPending)
+
+export const typewriterScrollTarget = (
+  scrollTop: number,
+  cursorViewportY: number,
+  containerViewportTop: number,
+  containerHeight: number
+): number => scrollTop + cursorViewportY - (containerViewportTop + containerHeight / 2)
