+      const containerRect = container.getBoundingClientRect()
+      const style = getComputedStyle(container)
+      const textLeft = containerRect.left + Number.parseFloat(style.paddingLeft)
+      const textRight = containerRect.right - Number.parseFloat(style.paddingRight)
+      return {
+        editorWidth,
