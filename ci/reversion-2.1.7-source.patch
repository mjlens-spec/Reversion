+import { expect, test } from '@playwright/test'
+import type { ElectronApplication, Page } from 'playwright'
+import { launchWithMarkdown } from './helpers'
+
+const sidebarTabs = (page: Page) =>
+  page.locator('.side-bar .left-column nav[role="tablist"] [role="tab"]')
+
+const computedFontSize = (page: Page, selector: string) =>
+  page.locator(selector).evaluate((element) => getComputedStyle(element).fontSize)
+
+test.describe('sidebar spacing and type scale', () => {
+  let app: ElectronApplication
+  let page: Page
+
+  test.beforeAll(async() => {
+    const launched = await launchWithMarkdown('# Document\n\n## Section\n\nBody text.\n', {
+      singleFile: true
+    })
+    app = launched.app
+    page = launched.page
+    await page.waitForSelector('.side-bar .right-column', { state: 'visible', timeout: 5000 })
+  })
+
+  test.afterAll(async() => {
+    if (app) await app.close()
+  })
+
+  test('uses an 8px content inset and the reduced type scale in every view', async() => {
+    const contentStyles = await page.locator('.side-bar .right-column').evaluate((element) => {
+      const style = getComputedStyle(element)
+      return {
+        paddingTop: style.paddingTop,
+        paddingRight: style.paddingRight,
+        paddingBottom: style.paddingBottom,
+        paddingLeft: style.paddingLeft,
+        fontSize: style.fontSize,
+        elementFontSize: style.getPropertyValue('--el-font-size-base').trim()
+      }
+    })
+    expect(contentStyles).toEqual({
+      paddingTop: '8px',
+      paddingRight: '8px',
+      paddingBottom: '8px',
+      paddingLeft: '8px',
+      fontSize: '13px',
+      elementFontSize: '13px'
+    })
+
+    await sidebarTabs(page).nth(0).click()
+    await expect(page.locator('.side-bar .tree-view')).toBeVisible()
+    expect(await computedFontSize(page, '.side-bar .tree-view')).toBe('13px')
+
+    await sidebarTabs(page).nth(1).click()
+    await expect(page.locator('.side-bar .side-bar-search')).toBeVisible()
+    expect(await computedFontSize(page, '.side-bar .search-input')).toBe('12px')
+    expect(await computedFontSize(page, '.side-bar .side-bar-search .empty .el-button')).toBe('13px')
+
+    await sidebarTabs(page).nth(2).click()
+    await expect(page.locator('.side-bar .side-bar-toc .el-tree')).toBeVisible()
+    expect(await computedFontSize(page, '.side-bar .side-bar-toc .title')).toBe('14px')
+    expect(await computedFontSize(page, '.side-bar .side-bar-toc .el-tree')).toBe('13px')
+  })
+})
