new file mode 100644
index 00000000..eb033f7a
--- /dev/null
+++ b/packages/desktop/src/main/ipc/updates.ts
@@ -0,0 +1,41 @@
+import { ipcMain, net } from 'electron'
+
+const normalizeVersion = (version: string): string => version.trim().replace(/^v/i, '')
+
+// The app version this profile last ran, captured by Preference from
+// `preferences.json` BEFORE electron-store's migrations overwrite it with the
+// current version. `null` means a fresh profile (no preferences file), which
+// is how the renderer tells a first install apart from an upgrade when
+// deciding whether to show the release-notes dialog.
+let previousRunVersion: string | null = null
+
+export const recordPreviousRunVersion = (version: string | null): void => {
+  previousRunVersion = version
+}
+
+export const registerUpdateHandlers = (): void => {
+  ipcMain.handle('mt::update::previous-run-version', () => previousRunVersion)
+
+  ipcMain.handle('mt::update::release-notes', async(_event, version: string) => {
+    const normalizedVersion = normalizeVersion(version)
+    if (!normalizedVersion) return ''
+
+    try {
+      const response = await net.fetch(
+        `https://api.github.com/repos/mjlens-spec/Reversion/releases/tags/v${encodeURIComponent(normalizedVersion)}`,
+        {
+          headers: {
+            Accept: 'application/vnd.github+json',
+            'X-GitHub-Api-Version': '2022-11-28'
+          }
+        }
+      )
+      if (!response.ok) return ''
+
+      const release = (await response.json()) as { body?: unknown }
+      return typeof release.body === 'string' ? release.body : ''
+    } catch {
+      return ''
+    }
+  })
+}
