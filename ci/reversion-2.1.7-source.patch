diff --git a/packages/desktop/test/unit/specs/pref-range-normalize.spec.ts b/packages/desktop/test/unit/specs/pref-range-normalize.spec.ts
new file mode 100644
index 00000000..6c0302a1
--- /dev/null
+++ b/packages/desktop/test/unit/specs/pref-range-normalize.spec.ts
@@ -0,0 +1,56 @@
+import { describe, it, expect } from 'vitest'
+import { clampToBounds, normalizeRangeValue } from '@/prefComponents/common/range/normalize'
+import schema from 'main_renderer/preferences/schema.json'
+
+// The autoSaveDelay row in prefComponents/general/index.vue.
+const AUTO_SAVE_DELAY_MIN = 1000
+const AUTO_SAVE_DELAY_MAX = 10000
+
+describe('range control bounds', () => {
+  it('keeps an in-range value', () => {
+    expect(normalizeRangeValue(5000, AUTO_SAVE_DELAY_MIN, AUTO_SAVE_DELAY_MAX)).to.equal(5000)
+  })
+
+  it('clamps below the minimum, so a sub-minimum value is never emitted', () => {
+    expect(normalizeRangeValue(350, AUTO_SAVE_DELAY_MIN, AUTO_SAVE_DELAY_MAX)).to.equal(1000)
+    expect(normalizeRangeValue(0, AUTO_SAVE_DELAY_MIN, AUTO_SAVE_DELAY_MAX)).to.equal(1000)
+    expect(normalizeRangeValue(-1, AUTO_SAVE_DELAY_MIN, AUTO_SAVE_DELAY_MAX)).to.equal(1000)
+  })
+
+  it('clamps above the maximum', () => {
+    expect(normalizeRangeValue(99999, AUTO_SAVE_DELAY_MIN, AUTO_SAVE_DELAY_MAX)).to.equal(10000)
+  })
+
+  it('drops values that cannot be a JSON Schema number', () => {
+    for (const value of [Number.NaN, Number.POSITIVE_INFINITY, Number.NEGATIVE_INFINITY]) {
+      expect(normalizeRangeValue(value, AUTO_SAVE_DELAY_MIN, AUTO_SAVE_DELAY_MAX)).to.equal(
+        undefined
+      )
+    }
+  })
+
+  it('drops the array el-slider emits in range mode, and other non-numbers', () => {
+    for (const value of [[1000, 2000], '5000', null, undefined, {}]) {
+      expect(normalizeRangeValue(value, AUTO_SAVE_DELAY_MIN, AUTO_SAVE_DELAY_MAX)).to.equal(
+        undefined
+      )
+    }
+  })
+
+  it('passes the value through when no bounds are declared', () => {
+    expect(normalizeRangeValue(42)).to.equal(42)
+    expect(clampToBounds(42, undefined, undefined)).to.equal(42)
+  })
+
+  // Guards against a control whose min/max drift away from the schema, which is
+  // what makes an out-of-range write reach the main process in the first place.
+  it('matches the schema bounds the main process enforces', () => {
+    const entry = (schema as unknown as Record<string, { minimum?: number; maximum?: number }>)
+      .autoSaveDelay
+    const minimum = Number(entry.minimum)
+    expect(minimum).to.equal(AUTO_SAVE_DELAY_MIN)
+    expect(
+      normalizeRangeValue(minimum - 1, AUTO_SAVE_DELAY_MIN, AUTO_SAVE_DELAY_MAX)
+    ).to.be.at.least(minimum)
+  })
+})
diff --git a/packages/desktop/test/unit/specs/preference-seed-schema-sync.spec.ts b/packages/desktop/test/unit/specs/preference-seed-schema-sync.spec.ts
new file mode 100644
index 00000000..65bf4296
--- /dev/null
+++ b/packages/desktop/test/unit/specs/preference-seed-schema-sync.spec.ts
@@ -0,0 +1,77 @@
+// Guards `static/preference.json` (the first-run seed) and
+// `src/main/preferences/schema.json` (the electron-store validation schema)
+// against drifting apart.
+//
+// The two files describe the same key set from different angles, and each
+// direction of divergence has its own failure mode:
+//
+//   * A key in the SCHEMA but not the SEED used to be destructive:
+//     `Preference.init()` treated the seed as the key authority and deleted
+//     any stored key missing from it, after which ajv's `useDefaults` refilled
+//     the key with the schema default — silently reverting the user's value on
+//     every launch. That is exactly how editorTitleFontFamily /
+//     editorHeadingFontFamily / editorBodyFontFamily kept resetting in
+//     1.2.0-beta.2. init() now consults both key sets before pruning, but the
+//     seed should still ship every schema key so first-run files are complete.
+//
+//   * A key in the SEED but not the SCHEMA is merely unvalidated: the store
+//     accepts it (no `additionalProperties: false`) and the pre-flight repair
+//     pass reports it as `kept-unknown` on every start.
+//
+// Any intentional divergence must be listed in the whitelists below so it is
+// explicit rather than an accident waiting to become a bug.
+import fs from 'node:fs'
+import path from 'node:path'
+import { fileURLToPath } from 'node:url'
+import { describe, expect, it } from 'vitest'
+import {
+  hasEffectiveRepairs,
+  sanitizePreferences,
+  type PreferenceSchema
+} from 'main_renderer/preferences/validate'
+
+const specDir = path.dirname(fileURLToPath(import.meta.url))
+const desktopRoot = path.resolve(specDir, '..', '..', '..')
+
+const seed = JSON.parse(
+  fs.readFileSync(path.join(desktopRoot, 'static', 'preference.json'), 'utf8')
+) as Record<string, unknown>
+const schema = JSON.parse(
+  fs.readFileSync(path.join(desktopRoot, 'src', 'main', 'preferences', 'schema.json'), 'utf8')
+) as PreferenceSchema
+
+// Keys that intentionally exist only in the seed file. They are stored and
+// used by the app (e.g. the file watcher reads treePathExcludePatterns) but
+// have no schema entry, so electron-store never validates them.
+const SEED_ONLY_KEYS = ['treePathExcludePatterns'].sort()
+
+// Keys that intentionally exist only in the schema. This list must stay empty
+// unless a key genuinely has no sensible first-run value: every schema key
+// missing from the seed leaves first-run preference files incomplete and, on
+// builds without the union-aware init() pruning, reverts the user's value to
+// the schema default on every launch.
+const SCHEMA_ONLY_KEYS: string[] = []
+
+describe('static/preference.json <-> preferences/schema.json sync', () => {
+  it('seeds every schema-described key', () => {
+    const missingFromSeed = Object.keys(schema)
+      .filter((key) => !(key in seed))
+      .sort()
+    expect(missingFromSeed).to.deep.equal(SCHEMA_ONLY_KEYS)
+  })
+
+  it('describes every seeded key in the schema, minus the whitelist', () => {
+    const missingFromSchema = Object.keys(seed)
+      .filter((key) => !(key in schema))
+      .sort()
+    expect(missingFromSchema).to.deep.equal(SEED_ONLY_KEYS)
+  })
+
+  it('ships seed values that satisfy the schema unchanged', () => {
+    const { repairs } = sanitizePreferences(schema, seed)
+    // Clamps, resets or drops would mean the app rewrites its own defaults on
+    // first run; the only acceptable reports are the whitelisted unknown keys.
+    expect(hasEffectiveRepairs(repairs)).to.equal(false)
+    expect(repairs.map((repair) => repair.key).sort()).to.deep.equal(SEED_ONLY_KEYS)
+  })
+})
diff --git a/packages/desktop/test/unit/specs/preference-store.spec.ts b/packages/desktop/test/unit/specs/preference-store.spec.ts
new file mode 100644
index 00000000..62fecca2
--- /dev/null
+++ b/packages/desktop/test/unit/specs/preference-store.spec.ts
@@ -0,0 +1,281 @@
+// Behavioural tests for the two main-process defences added after the
+// 1.2.0-beta.2 report ("Config schema violation: `autoSaveDelay` must be
+// >= 1000" raised out of the `mt::set-user-preference` listener):
+//
+//   * Preference.setItem/setItems must contain a bad entry instead of letting
+//     electron-store's validation escape as an uncaught main-process exception.
+//   * Preference must repair an out-of-range preferences.json BEFORE the store
+//     is constructed, because `new Store(...)` validates the file itself and
+//     would otherwise abort startup before any window exists.
+//
+// The real electron-store (and therefore the real ajv validation) is used
+// against a temp directory; only `electron`, `electron-log` and the main-process
+// i18n helper are stubbed.
+import { EventEmitter } from 'node:events'
+import fs from 'node:fs'
+import os from 'node:os'
+import path from 'node:path'
+import { fileURLToPath } from 'node:url'
+import { afterEach, beforeEach, describe, expect, it, vi } from 'vitest'
+
+const specDir = path.dirname(fileURLToPath(import.meta.url))
+const STATIC_DIR = path.resolve(specDir, '..', '..', '..', 'static')
+
+const stubs = vi.hoisted(() => {
+  const sent: Array<{ channel: string; payload: unknown }> = []
+  const logs: Array<{ level: string; args: unknown[] }> = []
+  return {
+    sent,
+    logs,
+    userDataDir: { value: '' }
+  }
+})
+
+vi.mock('electron', () => {
+  const ipcMain = new EventEmitter()
+  // Preference registers several listeners on the same emitter per instance.
+  ipcMain.setMaxListeners(0)
+  const app = {
+    getPath: () => stubs.userDataDir.value,
+    getVersion: () => '1.2.0-test',
+    getName: () => 'marktext',
+    getLocale: () => 'en'
+  }
+  const BrowserWindow = {
+    getAllWindows: () => [
+      {
+        isDestroyed: () => false,
+        webContents: {
+          send: (channel: string, payload: unknown) => stubs.sent.push({ channel, payload })
+        }
+      }
+    ]
+  }
+  const nativeTheme = { shouldUseDarkColors: false }
+  const shell = { openPath: async() => '' }
+  // `electron-store` reads these off the *default* export, the rest of the
+  // codebase off the named ones — provide both.
+  return {
+    default: { app, BrowserWindow, ipcMain, nativeTheme, shell },
+    app,
+    BrowserWindow,
+    ipcMain,
+    nativeTheme,
+    shell
+  }
+})
+
+vi.mock('electron-log', () => {
+  const record = (level: string) => (...args: unknown[]) => stubs.logs.push({ level, args })
+  return {
+    default: {
+      info: record('info'),
+      warn: record('warn'),
+      error: record('error'),
+      verbose: record('verbose'),
+      debug: record('debug')
+    }
+  }
+})
+
+vi.mock('main_renderer/i18n', () => ({
+  t: (key: string, params: Record<string, string | number> = {}) =>
+    Object.entries(params).reduce<string>(
+      (acc, [name, value]) => acc.replace(`{${name}}`, String(value)),
+      `${key}|{key}|{reason}`
+    ),
+  setLanguage: () => {},
+  getCurrentLanguage: () => 'en'
+}))
+
+const { default: Preference } = await import('main_renderer/preferences')
+const { default: Store } = await import('electron-store')
+const { default: schema } = await import('main_renderer/preferences/schema.json')
+
+let dir: string
+
+const prefsPath = (): string => path.join(dir, 'preferences.json')
+const readPrefs = (): Record<string, unknown> =>
+  JSON.parse(fs.readFileSync(prefsPath(), 'utf8')) as Record<string, unknown>
+const writePrefs = (overrides: Record<string, unknown>): void => {
+  const seed = JSON.parse(
+    fs.readFileSync(path.join(STATIC_DIR, 'preference.json'), 'utf8')
+  ) as Record<string, unknown>
+  fs.writeFileSync(prefsPath(), JSON.stringify({ ...seed, ...overrides }, undefined, '\t'))
+}
+const notifications = (): Array<{ channel: string; payload: unknown }> =>
+  stubs.sent.filter((entry) => entry.channel === 'mt::show-notification')
+
+beforeEach(() => {
+  dir = fs.mkdtempSync(path.join(os.tmpdir(), 'reversion-pref-'))
+  stubs.userDataDir.value = dir
+  stubs.sent.length = 0
+  stubs.logs.length = 0
+  ;(globalThis as unknown as { __static: string }).__static = STATIC_DIR
+})
+
+afterEach(() => {
+  fs.rmSync(dir, { recursive: true, force: true })
+})
+
+describe('Preference.setItem containment', () => {
+  it('clamps an out-of-range number instead of throwing', () => {
+    writePrefs({ autoSaveDelay: 5000 })
+    const preference = new Preference({ preferencesPath: dir })
+
+    expect(preference.setItem('autoSaveDelay', 350)).to.equal(true)
+    expect(preference.getItem('autoSaveDelay')).to.equal(1000)
+    expect(readPrefs().autoSaveDelay).to.equal(1000)
+    expect(notifications()).to.have.lengthOf(0)
+  })
+
+  it('refuses an unusable value, keeps the old one and notifies the renderer', () => {
+    writePrefs({ autoSaveDelay: 5000 })
+    const preference = new Preference({ preferencesPath: dir })
+
+    expect(() => preference.setItem('autoSaveDelay', Number.NaN)).not.to.throw()
+    expect(preference.setItem('autoSaveDelay', Number.NaN)).to.equal(false)
+    expect(preference.getItem('autoSaveDelay')).to.equal(5000)
+
+    const notes = notifications()
+    expect(notes.length).to.be.greaterThan(0)
+    expect(JSON.stringify(notes.map((note) => note.payload))).to.include('autoSaveDelay')
+  })
+
+  it('refuses a value outside an enum', () => {
+    writePrefs({})
+    const preference = new Preference({ preferencesPath: dir })
+
+    expect(preference.setItem('endOfLine', 'cr')).to.equal(false)
+    expect(preference.getItem('endOfLine')).to.not.equal('cr')
+    expect(notifications().length).to.be.greaterThan(0)
+  })
+
+  // The payload from the report: `{ autoSave: true, autoSaveDelay: <350> }`.
+  // Before the fix the whole ipcMain listener threw on the second key, the
+  // error dialog blocked the main process, and the sender never got a reply.
+  it('applies the reported payload without throwing, clamping only the bad key', () => {
+    writePrefs({ autoSave: false, autoSaveDelay: 5000 })
+    const preference = new Preference({ preferencesPath: dir })
+
+    expect(() => preference.setItems({ autoSave: true, autoSaveDelay: 350 })).not.to.throw()
+    expect(preference.getItem('autoSave')).to.equal(true)
+    expect(preference.getItem('autoSaveDelay')).to.equal(1000)
+  })
+
+  it('keeps the remaining keys of a payload when one of them is unusable', () => {
+    writePrefs({ autoSave: false, autoSaveDelay: 5000 })
+    const preference = new Preference({ preferencesPath: dir })
+
+    expect(() =>
+      preference.setItems({ autoSave: true, autoSaveDelay: 'soon', hideScrollbar: true })
+    ).not.to.throw()
+    expect(preference.getItem('autoSave')).to.equal(true)
+    expect(preference.getItem('hideScrollbar')).to.equal(true)
+    expect(preference.getItem('autoSaveDelay')).to.equal(5000)
+  })
+})
+
+describe('Preference startup repair', () => {
+  it('electron-store alone cannot open an out-of-range preferences file', () => {
+    writePrefs({ autoSaveDelay: 350 })
+    expect(
+      () =>
+        new Store({
+          // eslint-disable-next-line @typescript-eslint/no-explicit-any
+          schema: schema as any,
+          name: 'preferences',
+          cwd: dir
+        })
+    ).to.throw(/autoSaveDelay/)
+  })
+
+  it('constructs successfully and clamps the out-of-range entry on disk', () => {
+    writePrefs({ autoSaveDelay: 350, fontSize: 999 })
+
+    const build = (): InstanceType<typeof Preference> => new Preference({ preferencesPath: dir })
+    expect(build).not.to.throw()
+
+    const preference = build()
+    expect(preference.getItem('autoSaveDelay')).to.equal(1000)
+    expect(preference.getItem('fontSize')).to.equal(32)
+    expect(readPrefs().autoSaveDelay).to.equal(1000)
+  })
+
+  it('resets a wrongly typed entry to the schema default', () => {
+    writePrefs({ autoSaveDelay: '5000' })
+    const preference = new Preference({ preferencesPath: dir })
+    expect(preference.getItem('autoSaveDelay')).to.equal(5000)
+  })
+
+  it("preserves electron-store's migration bookkeeping while repairing", () => {
+    writePrefs({ autoSaveDelay: 350 })
+    const withInternal = { ...readPrefs(), __internal__: { migrations: { version: '1.1.0' } } }
+    fs.writeFileSync(prefsPath(), JSON.stringify(withInternal, undefined, '\t'))
+
+    const preference = new Preference({ preferencesPath: dir })
+    expect(preference.getItem('autoSaveDelay')).to.equal(1000)
+    const after = readPrefs()
+    expect(after.autoSaveDelay).to.equal(1000)
+    expect(after.__internal__).to.be.an('object')
+  })
+
+  it('does not rewrite a file that only needs no repair', () => {
+    writePrefs({ autoSaveDelay: 5000 })
+    const preference = new Preference({ preferencesPath: dir })
+
+    expect(preference.getItem('autoSaveDelay')).to.equal(5000)
+    expect(readPrefs().autoSaveDelay).to.equal(5000)
+    // `treePathExcludePatterns` ships in static/preference.json but is absent
+    // from schema.json, so it is reported as an unknown key on every start.
+    // That alone must never trigger a rewrite.
+    const preflight = stubs.logs
+      .map((entry) => String(entry.args[0]))
+      .filter((line) => line.includes('Preferences pre-flight'))
+    expect(preflight.some((line) => line.includes('kept-unknown'))).to.equal(true)
+    expect(
+      preflight.some(
+        (line) =>
+          line.includes('clamped') || line.includes('reset-to-default') || line.includes('dropped')
+      )
+    ).to.equal(false)
+    expect(preflight.some((line) => line.includes('repaired'))).to.equal(false)
+  })
+
+  it('does nothing when there is no preferences file yet', () => {
+    expect(() => new Preference({ preferencesPath: dir })).not.to.throw()
+    expect(fs.existsSync(prefsPath())).to.equal(true)
+  })
+})
+
+describe('Preference.init key pruning', () => {
+  // Reproduces the 1.2.0-beta.2 seed state: editorTitleFontFamily declared in
+  // schema.json but missing from static/preference.json. init() used to treat
+  // the seed as the sole key authority, delete the "unknown" key and let ajv's
+  // `useDefaults` refill it with the schema default — reverting the user's
+  // customised value on every launch.
+  it('keeps a schema-described key that is missing from the seed file', () => {
+    const beta2Seed = JSON.parse(
+      fs.readFileSync(path.join(STATIC_DIR, 'preference.json'), 'utf8')
+    ) as Record<string, unknown>
+    delete beta2Seed.editorTitleFontFamily
+    const staticDir = path.join(dir, 'static-beta2')
+    fs.mkdirSync(staticDir)
+    fs.writeFileSync(path.join(staticDir, 'preference.json'), JSON.stringify(beta2Seed))
+    ;(globalThis as unknown as { __static: string }).__static = staticDir
+
+    writePrefs({ editorTitleFontFamily: 'Repro Custom Serif' })
+    const preference = new Preference({ preferencesPath: dir })
+
+    expect(preference.getItem('editorTitleFontFamily')).to.equal('Repro Custom Serif')
+    expect(readPrefs().editorTitleFontFamily).to.equal('Repro Custom Serif')
+  })
+
+  it('still prunes a key that neither the seed nor the schema describes', () => {
+    writePrefs({ someLegacyUnknownKey: true })
+    const preference = new Preference({ preferencesPath: dir })
+
+    expect(preference.getItem('someLegacyUnknownKey')).to.equal(undefined)
+    expect(readPrefs()).to.not.have.property('someLegacyUnknownKey')
+  })
+})
diff --git a/packages/desktop/test/unit/specs/preference-validate.spec.ts b/packages/desktop/test/unit/specs/preference-validate.spec.ts
new file mode 100644
index 00000000..9a0656f9
--- /dev/null
+++ b/packages/desktop/test/unit/specs/preference-validate.spec.ts
@@ -0,0 +1,172 @@
+import { describe, it, expect } from 'vitest'
+import {
+  coercePreferenceValue,
+  hasEffectiveRepairs,
+  sanitizePreferences,
+  type PreferenceSchema
+} from 'main_renderer/preferences/validate'
+import realSchema from 'main_renderer/preferences/schema.json'
+
+const schema = realSchema as unknown as PreferenceSchema
+
+describe('coercePreferenceValue', () => {
+  it('accepts an in-range number', () => {
+    expect(coercePreferenceValue(schema, 'autoSaveDelay', 5000)).to.deep.equal({
+      status: 'ok',
+      value: 5000
+    })
+  })
+
+  // The 1.2.0-beta.2 report: a sender posted `{ autoSave: true,
+  // autoSaveDelay: 350 }` over `mt::set-user-preference` and electron-store
+  // threw "`autoSaveDelay` must be >= 1000" out of the synchronous ipcMain
+  // listener.
+  it('clamps a number below the schema minimum instead of rejecting it', () => {
+    const outcome = coercePreferenceValue(schema, 'autoSaveDelay', 350)
+    expect(outcome.status).to.equal('clamped')
+    expect(outcome.status === 'clamped' && outcome.value).to.equal(1000)
+  })
+
+  it('clamps a number above the schema maximum', () => {
+    const outcome = coercePreferenceValue(schema, 'zoom', 12)
+    expect(outcome.status).to.equal('clamped')
+    expect(outcome.status === 'clamped' && outcome.value).to.equal(2.0)
+  })
+
+  it('rejects non-finite numbers, which ajv reports as "must be number"', () => {
+    for (const value of [Number.NaN, Number.POSITIVE_INFINITY, Number.NEGATIVE_INFINITY]) {
+      expect(coercePreferenceValue(schema, 'autoSaveDelay', value).status).to.equal('rejected')
+    }
+  })
+
+  it('rejects a wrongly typed value', () => {
+    expect(coercePreferenceValue(schema, 'autoSaveDelay', '5000').status).to.equal('rejected')
+    expect(coercePreferenceValue(schema, 'autoSaveDelay', null).status).to.equal('rejected')
+    expect(coercePreferenceValue(schema, 'autoSave', 'yes').status).to.equal('rejected')
+  })
+
+  it('rejects undefined, which the store turns into a TypeError', () => {
+    expect(coercePreferenceValue(schema, 'autoSaveDelay', undefined)).to.deep.equal({
+      status: 'rejected',
+      reason: 'value is undefined'
+    })
+  })
+
+  it('enforces enum membership', () => {
+    expect(coercePreferenceValue(schema, 'endOfLine', 'lf').status).to.equal('ok')
+    expect(coercePreferenceValue(schema, 'endOfLine', 'cr').status).to.equal('rejected')
+    // Numeric enums must stay numeric.
+    expect(coercePreferenceValue(schema, 'trimTrailingNewline', 2).status).to.equal('ok')
+    expect(coercePreferenceValue(schema, 'trimTrailingNewline', '2').status).to.equal('rejected')
+  })
+
+  it('accepts and clamps typography union preferences', () => {
+    expect(coercePreferenceValue(schema, 'readingFontSize', 'theme').status).to.equal('ok')
+    expect(coercePreferenceValue(schema, 'readingFontSize', 18).status).to.equal('ok')
+    expect(coercePreferenceValue(schema, 'readingFontSize', 99)).to.deep.equal({
+      status: 'clamped',
+      value: 24,
+      reason: '99 is above the maximum 24'
+    })
+    expect(coercePreferenceValue(schema, 'readingColumnWidth', 'window').status).to.equal('ok')
+    expect(coercePreferenceValue(schema, 'readingColumnWidth', 'wide').status).to.equal('rejected')
+  })
+
+  it('enforces string patterns', () => {
+    expect(coercePreferenceValue(schema, 'editorLineWidth', '80ch').status).to.equal('ok')
+    expect(coercePreferenceValue(schema, 'editorLineWidth', '').status).to.equal('ok')
+    expect(coercePreferenceValue(schema, 'editorLineWidth', '80 chars').status).to.equal('rejected')
+  })
+
+  it('enforces array item types', () => {
+    expect(coercePreferenceValue(schema, 'searchExclusions', ['node_modules']).status).to.equal('ok')
+    expect(coercePreferenceValue(schema, 'searchExclusions', [1]).status).to.equal('rejected')
+    expect(coercePreferenceValue(schema, 'searchExclusions', 'node_modules').status).to.equal(
+      'rejected'
+    )
+  })
+
+  it('reports keys the schema does not describe rather than guessing', () => {
+    expect(coercePreferenceValue(schema, 'treePathExcludePatterns', ['.git'])).to.deep.equal({
+      status: 'unknown-key'
+    })
+  })
+})
+
+describe('sanitizePreferences', () => {
+  it('leaves a valid object untouched and reports no repairs', () => {
+    const input = { autoSave: true, autoSaveDelay: 5000, endOfLine: 'lf' }
+    const { data, repairs } = sanitizePreferences(schema, input)
+    expect(data).to.deep.equal(input)
+    expect(repairs).to.deep.equal([])
+    expect(hasEffectiveRepairs(repairs)).to.equal(false)
+  })
+
+  it('never mutates its input', () => {
+    const input = { autoSaveDelay: 350 }
+    sanitizePreferences(schema, input)
+    expect(input.autoSaveDelay).to.equal(350)
+  })
+
+  // This is the case that makes the app fail to start: `new Store(...)` reads
+  // and validates preferences.json in its own constructor, and
+  // `clearInvalidConfig` is false, so the throw happens before any window
+  // exists.
+  it('clamps an out-of-range persisted value to the schema bound', () => {
+    const { data, repairs } = sanitizePreferences(schema, {
+      autoSaveDelay: 350,
+      fontSize: 999,
+      lineHeight: 0.1
+    })
+    expect(data.autoSaveDelay).to.equal(1000)
+    expect(data.fontSize).to.equal(32)
+    expect(data.lineHeight).to.equal(1.2)
+    expect(repairs.map((r) => r.action)).to.deep.equal(['clamped', 'clamped', 'clamped'])
+    expect(hasEffectiveRepairs(repairs)).to.equal(true)
+  })
+
+  it('resets an unusable value to the schema default', () => {
+    const { data, repairs } = sanitizePreferences(schema, {
+      autoSaveDelay: Number.NaN,
+      endOfLine: 'cr'
+    })
+    expect(data.autoSaveDelay).to.equal(5000)
+    expect(data.endOfLine).to.equal('default')
+    expect(repairs.every((r) => r.action === 'reset-to-default')).to.equal(true)
+  })
+
+  it('drops an unusable value when the schema declares no default', () => {
+    const { data, repairs } = sanitizePreferences(schema, { lastOpenedFolder: 42 })
+    expect('lastOpenedFolder' in data).to.equal(false)
+    expect(repairs.map((repair) => repair.action)).to.deep.equal(['dropped'])
+  })
+
+  it('keeps unknown keys, so a stale entry is never silently destroyed', () => {
+    const { data, repairs } = sanitizePreferences(schema, {
+      treePathExcludePatterns: ['.git', 'node_modules'],
+      autoSaveDelay: 5000
+    })
+    expect(data.treePathExcludePatterns).to.deep.equal(['.git', 'node_modules'])
+    expect(repairs.map((r) => r.action)).to.deep.equal(['kept-unknown'])
+    // Unknown keys alone must not trigger a rewrite of the file.
+    expect(hasEffectiveRepairs(repairs)).to.equal(false)
+  })
+
+  it('produces an object every schema constraint accepts', () => {
+    const poisoned: Record<string, unknown> = {
+      autoSaveDelay: 350,
+      zoom: 99,
+      fontSize: '16',
+      lineHeight: Number.NaN,
+      endOfLine: 'cr',
+      editorLineWidth: '80 chars',
+      searchExclusions: [1, 2],
+      unknownLegacyKey: { nested: true }
+    }
+    const { data } = sanitizePreferences(schema, poisoned)
+    for (const [key, value] of Object.entries(data)) {
+      const outcome = coercePreferenceValue(schema, key, value)
+      expect(outcome.status, `${key} = ${JSON.stringify(value)}`).to.be.oneOf(['ok', 'unknown-key'])
+    }
+  })
+})
