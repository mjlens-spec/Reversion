+import { describe, expect, it, vi } from 'vitest'
+import {
+  serializeDirectoryEntries,
+  type FsDirectoryEntryLike
+} from '../../../src/main/ipc/fsDirectory'
+
+const regularFile = (name: string): FsDirectoryEntryLike => ({
+  name,
+  isFile: () => true,
+  isDirectory: () => false,
+  isSymbolicLink: () => false
+})
+
+const symlink = (name: string): FsDirectoryEntryLike => ({
+  name,
+  isFile: () => false,
+  isDirectory: () => false,
+  isSymbolicLink: () => true
+})
+
+describe('filesystem directory entry classification', () => {
+  it('classifies thousands of ordinary files without sync target probing', async() => {
+    const isMarkdownFile = vi.fn(() => { throw new Error('ordinary files must not probe targets') })
+    const stat = vi.fn(async() => ({ isFile: true, isDirectory: false }))
+    const entries = Array.from({ length: 1000 }, (_, index) => regularFile(`note-${index}.md`))
+
+    const result = await serializeDirectoryEntries('/root', entries, {
+      hasMarkdownExtension: (name) => name.endsWith('.md'),
+      isMarkdownFile,
+      stat
+    })
+
+    expect(result).toHaveLength(1000)
+    expect(result.every((entry) => entry.isMarkdown && entry.isOpenable)).toBe(true)
+    expect(isMarkdownFile).not.toHaveBeenCalled()
+    expect(stat).not.toHaveBeenCalled()
+  })
+
+  it('resolves symlink openability from the target while keeping broken links closed', async() => {
+    const isMarkdownFile = vi.fn((pathname: string) => pathname.endsWith('alias.txt'))
+    const stat = vi.fn(async(pathname: string) => {
+      if (pathname.endsWith('broken.link')) throw new Error('broken link')
+      return { isFile: true, isDirectory: false }
+    })
+
+    const result = await serializeDirectoryEntries('/root', [
+      symlink('alias.txt'),
+      symlink('alias.md'),
+      symlink('broken.link')
+    ], {
+      hasMarkdownExtension: (name) => name.endsWith('.md'),
+      isMarkdownFile,
+      stat
+    })
+
+    expect(result.map(({ name, isMarkdown, isOpenable }) => ({ name, isMarkdown, isOpenable }))).toEqual([
+      { name: 'alias.txt', isMarkdown: true, isOpenable: true },
+      { name: 'alias.md', isMarkdown: false, isOpenable: false },
+      { name: 'broken.link', isMarkdown: false, isOpenable: false }
+    ])
+    expect(stat).toHaveBeenCalledTimes(3)
+    expect(isMarkdownFile).toHaveBeenCalledTimes(2)
+  })
+})
