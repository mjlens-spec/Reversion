+<template>
+  <div class="typography-panel">
+    <div
+      v-for="setting in numericSettings"
+      :key="setting.key"
+      class="typography-row"
+    >
+      <div class="typography-label">
+        <span>{{ t(setting.label) }}</span>
+        <button
+          class="theme-value"
+          :class="{ active: isTheme(setting.key) }"
+          type="button"
+          @click="resetOne(setting.key)"
+        >
+          {{ isTheme(setting.key) ? t('preferences.editor.typography.themeDefault') : t('preferences.editor.typography.useTheme') }}
+        </button>
+      </div>
+      <input
+        class="typography-range"
+        type="range"
+        :min="setting.min"
+        :max="setting.max"
+        :step="setting.step"
+        :value="effectiveValue(setting.key)"
+        :aria-label="t(setting.label)"
+        @input="onRangeInput(setting.key, $event)"
+      >
+      <output>{{ formatValue(setting.key, effectiveValue(setting.key)) }}</output>
+    </div>
+
+    <div class="typography-row">
+      <div class="typography-label">
+        <span>{{ t('preferences.editor.typography.columnWidth') }}</span>
+        <button
+          class="theme-value"
+          :class="{ active: readingColumnWidth === 'theme' }"
+          type="button"
+          @click="resetOne('readingColumnWidth')"
+        >
+          {{ readingColumnWidth === 'theme' ? t('preferences.editor.typography.themeDefault') : t('preferences.editor.typography.useTheme') }}
+        </button>
+      </div>
+      <input
+        class="typography-range"
+        type="range"
+        min="600"
+        max="1200"
+        step="20"
+        :disabled="readingColumnWidth === 'window'"
+        :value="effectiveValue('readingColumnWidth')"
+        :aria-label="t('preferences.editor.typography.columnWidth')"
+        @input="onRangeInput('readingColumnWidth', $event)"
+      >
+      <output>{{ columnWidthOutput }}</output>
+      <button
+        class="fit-window"
+        :class="{ active: readingColumnWidth === 'window' }"
+        type="button"
+        @click="setValue('readingColumnWidth', 'window')"
+      >
+        {{ t('preferences.editor.typography.fitWindow') }}
+      </button>
+    </div>
+
+    <button
+      class="reset-typography"
+      type="button"
+      @click="resetAll"
+    >
+      {{ t('preferences.editor.typography.reset') }}
+    </button>
+  </div>
+</template>
+
+<script setup lang="ts">
+import { computed } from 'vue'
+import { storeToRefs } from 'pinia'
+import { useI18n } from 'vue-i18n'
+import { usePreferencesStore, type PreferencesState } from '@/store/preferences'
+
+type TypographyKey = 'readingFontSize' | 'readingLineHeight' | 'readingParagraphSpacing' | 'readingColumnWidth'
+
+const defaultsByTheme: Record<string, Record<TypographyKey, number>> = {
+  'lens-design': {
+    readingFontSize: 16,
+    readingLineHeight: 1.72,
+    readingParagraphSpacing: 0.8,
+    readingColumnWidth: 1040
+  },
+  'claude-like': {
+    readingFontSize: 16,
+    readingLineHeight: 1.72,
+    readingParagraphSpacing: 0.82,
+    readingColumnWidth: 1080
+  }
+}
+
+const fallbackDefaults = defaultsByTheme['claude-like']
+const { t } = useI18n()
+const preferenceStore = usePreferencesStore()
+const {
+  theme,
+  readingFontSize,
+  readingLineHeight,
+  readingParagraphSpacing,
+  readingColumnWidth
+} = storeToRefs(preferenceStore)
+
+const numericSettings = [
+  { key: 'readingFontSize' as const, label: 'preferences.editor.typography.fontSize', min: 12, max: 24, step: 1 },
+  { key: 'readingLineHeight' as const, label: 'preferences.editor.typography.lineHeight', min: 1.3, max: 2.2, step: 0.05 },
+  { key: 'readingParagraphSpacing' as const, label: 'preferences.editor.typography.paragraphSpacing', min: 0, max: 2, step: 0.05 }
+]
+
+const themeDefaults = computed(() => defaultsByTheme[theme.value] ?? fallbackDefaults)
+const columnWidthOutput = computed(() => {
+  if (readingColumnWidth.value === 'theme') return '76%'
+  if (readingColumnWidth.value === 'window') return t('preferences.editor.typography.fitWindow')
+  return `${effectiveValue('readingColumnWidth')} px`
+})
+const refsByKey = { readingFontSize, readingLineHeight, readingParagraphSpacing, readingColumnWidth }
+
+const isTheme = (key: TypographyKey): boolean => refsByKey[key].value === 'theme'
+const effectiveValue = (key: TypographyKey): number => {
+  const value = refsByKey[key].value
+  return typeof value === 'number' ? value : themeDefaults.value[key]
+}
+const formatValue = (key: TypographyKey, value: number): string => {
+  if (key === 'readingFontSize') return `${value} px`
+  if (key === 'readingParagraphSpacing') return `${Number(value.toFixed(2))} em`
+  return Number(value.toFixed(2)).toString()
+}
+const setValue = (key: TypographyKey, value: PreferencesState[TypographyKey]): void => {
+  preferenceStore.SET_SINGLE_PREFERENCE({ type: key, value })
+}
+const onRangeInput = (key: TypographyKey, event: Event): void => {
+  setValue(key, Number((event.target as HTMLInputElement).value))
+}
+const resetOne = (key: TypographyKey): void => setValue(key, 'theme')
+const resetAll = (): void => {
+  for (const key of Object.keys(refsByKey) as TypographyKey[]) resetOne(key)
+}
+</script>
+
+<style scoped>
+.typography-panel {
+  width: 100%;
+  padding: 4px 0 2px;
+}
+
+.typography-row {
+  display: grid;
+  grid-template-columns: minmax(156px, 1fr) minmax(150px, 2fr) 74px;
+  gap: 12px;
+  align-items: center;
+  min-height: 46px;
+  border-bottom: 1px solid var(--floatBorderColor);
+}
+
+.typography-label {
+  display: flex;
+  flex-direction: column;
+  gap: 2px;
+  color: var(--editorColor);
+  font-size: 13px;
+}
+
+.theme-value {
+  width: fit-content;
+  padding: 0;
+  border: 0;
+  background: transparent;
+  color: var(--editorColor50);
+  font-size: 11px;
+  cursor: pointer;
+}
+
+.theme-value:hover,
+.theme-value.active {
+  color: var(--themeColor);
+}
+
+.typography-range {
+  width: 100%;
+  accent-color: var(--themeColor);
+}
+
+.typography-row output {
+  box-sizing: border-box;
+  min-width: 64px;
+  padding: 5px 7px;
+  border: 1px solid var(--floatBorderColor);
+  border-radius: 6px;
+  color: var(--editorColor);
+  background: var(--inputBgColor);
+  font-size: 12px;
+  text-align: center;
+}
+
+.fit-window {
+  grid-column: 2 / 4;
+  justify-self: end;
+  margin-top: -6px;
+  padding: 4px 9px;
+  border: 1px solid var(--floatBorderColor);
+  border-radius: 999px;
+  background: transparent;
+  color: var(--editorColor60);
+  font-size: 11px;
+}
+
+.fit-window.active {
+  border-color: var(--themeColor);
+  color: var(--themeColor);
+  background: var(--themeColor10);
+}
+
+.reset-typography {
+  display: block;
+  margin: 12px 0 2px auto;
+  padding: 6px 10px;
+  border: 1px solid var(--floatBorderColor);
+  border-radius: 6px;
+  color: var(--editorColor);
+  background: var(--buttonBgColor);
+}
+</style>
diff --git a/packages/desktop/src/renderer/src/util/appearance.ts b/packages/desktop/src/renderer/src/util/appearance.ts
new file mode 100644
index 00000000..a9c760f1
--- /dev/null
+++ b/packages/desktop/src/renderer/src/util/appearance.ts
@@ -0,0 +1,28 @@
+import { isBundledThemeId, isFixedLightThemeId } from 'common/theme'
+
+export type AppearancePreference = 'light' | 'dark' | 'system'
+export type EffectiveAppearance = 'light' | 'dark'
+
+export const isImportedTheme = (theme: unknown): boolean =>
+  typeof theme === 'string' && !isBundledThemeId(theme)
+
+export const resolveAppearance = (
+  appearance: AppearancePreference,
+  systemIsDark: boolean,
+  theme: unknown
+): EffectiveAppearance => {
+  if (isImportedTheme(theme) || isFixedLightThemeId(theme)) return 'light'
+  if (appearance === 'system') return systemIsDark ? 'dark' : 'light'
+  return appearance
+}
+
+export const applyAppearance = (
+  appearance: AppearancePreference,
+  systemIsDark: boolean,
+  theme: unknown
+): EffectiveAppearance => {
+  const effective = resolveAppearance(appearance, systemIsDark, theme)
+  document.documentElement.dataset.reversionAppearance = effective
+  document.body.classList.toggle('dark', effective === 'dark')
+  return effective
+}
diff --git a/packages/desktop/src/renderer/src/util/cjkTypography.ts b/packages/desktop/src/renderer/src/util/cjkTypography.ts
new file mode 100644
index 00000000..992fdf41
--- /dev/null
+++ b/packages/desktop/src/renderer/src/util/cjkTypography.ts
@@ -0,0 +1,225 @@
+export interface CjkTidyRules {
+  cjkLatinSpacing: boolean
+  fullWidthPunctuation: boolean
+  collapseSpaces: boolean
+  fullWidthSpace: boolean
+}
+
+export interface CjkTidyResult {
+  markdown: string
+  counts: Record<keyof CjkTidyRules, number>
+  total: number
+}
+
+export const CJK_TIDY_DEFAULT_RULES: CjkTidyRules = {
+  cjkLatinSpacing: true,
+  fullWidthPunctuation: true,
+  collapseSpaces: true,
+  fullWidthSpace: true
+}
+
+const CJK = /[\p{Script=Han}\p{Script=Hiragana}\p{Script=Katakana}\p{Script=Hangul}]/u
+const CJK_OR_PUNCTUATION = /[\p{Script=Han}\p{Script=Hiragana}\p{Script=Katakana}\p{Script=Hangul}，。！？：；、“”‘’（）《》【】]/u
+const LATIN_OR_NUMBER = /[A-Za-z0-9]/
+
+export const isCjkQuoteContext = (textBeforeCursor: string): boolean => {
+  const currentLine = textBeforeCursor.slice(textBeforeCursor.lastIndexOf('\n') + 1)
+  const nearest = currentLine.match(/\S(?=\s*$)/u)?.[0]
+  return Boolean(nearest && CJK_OR_PUNCTUATION.test(nearest))
+}
+
+const markRange = (mask: Uint8Array, start: number, end: number): void => {
+  mask.fill(1, Math.max(0, start), Math.min(mask.length, end))
+}
+
+const markRegexMatches = (source: string, mask: Uint8Array, pattern: RegExp, group = 0): void => {
+  for (const match of source.matchAll(pattern)) {
+    if (match.index === undefined) continue
+    const value = match[group]
+    if (!value) continue
+    const relative = group === 0 ? 0 : match[0].indexOf(value)
+    markRange(mask, match.index + relative, match.index + relative + value.length)
+  }
+}
+
+const buildProtectionMask = (source: string): Uint8Array => {
+  const mask = new Uint8Array(source.length)
+  const lines = source.matchAll(/.*(?:\n|$)/g)
+  let inFence = false
+  let fenceMarker = ''
+  let inHtmlBlock = false
+  let atDocumentStart = true
+  let inYaml = source.startsWith('---\n') || source === '---'
+
+  for (const match of lines) {
+    if (match.index === undefined || !match[0]) continue
+    const line = match[0]
+    const content = line.replace(/\n$/, '')
+    const trimmed = content.trim()
+    const fence = trimmed.match(/^(`{3,}|~{3,})/)
+
+    if (inYaml) {
+      markRange(mask, match.index, match.index + line.length)
+      if (!atDocumentStart && /^(---|\.\.\.)\s*$/.test(trimmed)) inYaml = false
+      atDocumentStart = false
+      continue
+    }
+    atDocumentStart = false
+
+    if (inFence) {
+      markRange(mask, match.index, match.index + line.length)
+      if (fence && fence[1][0] === fenceMarker[0] && fence[1].length >= fenceMarker.length) {
+        inFence = false
+      }
+      continue
+    }
+    if (fence) {
+      inFence = true
+      fenceMarker = fence[1]
+      markRange(mask, match.index, match.index + line.length)
+      continue
+    }
+
+    if (inHtmlBlock) {
+      markRange(mask, match.index, match.index + line.length)
+      if (!trimmed || /^<\/[A-Za-z][^>]*>\s*$/.test(trimmed) || /-->\s*$/.test(trimmed)) {
+        inHtmlBlock = false
+      }
+      continue
+    }
+    if (/^\s*<(?:!--|address\b|article\b|aside\b|base\b|basefont\b|blockquote\b|body\b|caption\b|center\b|col\b|colgroup\b|dd\b|details\b|dialog\b|dir\b|div\b|dl\b|dt\b|fieldset\b|figcaption\b|figure\b|footer\b|form\b|frame\b|frameset\b|h[1-6]\b|head\b|header\b|hr\b|html\b|iframe\b|legend\b|li\b|link\b|main\b|menu\b|menuitem\b|nav\b|noframes\b|ol\b|optgroup\b|option\b|p\b|param\b|search\b|section\b|summary\b|table\b|tbody\b|td\b|tfoot\b|th\b|thead\b|title\b|tr\b|track\b|ul\b)(?:\s|>|\/)/i.test(content)) {
+      inHtmlBlock = !/^\s*<[^>]+>.*<\/[A-Za-z][^>]*>\s*$/.test(content)
+      markRange(mask, match.index, match.index + line.length)
+      continue
+    }
+    if (/^(?: {4}|\t)/.test(content)) markRange(mask, match.index, match.index + line.length)
+  }
+
+  markRegexMatches(source, mask, /(`+)[\s\S]*?\1/g)
+  markRegexMatches(source, mask, /(\${1,2})(?!\$)[^\n]*?\1/g)
+  markRegexMatches(source, mask, /!?\[[^\]\n]*\]\(([^)\n]*)\)/g, 1)
+  markRegexMatches(source, mask, /<https?:\/\/[^>\n]+>/g)
+  markRegexMatches(source, mask, /<[^>\n]+>/g)
+  return mask
+}
+
+const nearestNonSpace = (text: string, index: number, direction: -1 | 1): string => {
+  for (let cursor = index + direction; cursor >= 0 && cursor < text.length; cursor += direction) {
+    if (!/\s/u.test(text[cursor])) return text[cursor]
+  }
+  return ''
+}
+
+const replaceCjkLatinSpacing = (text: string): { text: string; count: number } => {
+  let count = 0
+  const addSpace = (_match: string, left: string, right: string): string => {
+    count += 1
+    return `${left} ${right}`
+  }
+  const leftSpaced = text.replace(/([\p{Script=Han}\p{Script=Hiragana}\p{Script=Katakana}\p{Script=Hangul}])([A-Za-z0-9])/gu, addSpace)
+  return {
+    text: leftSpaced.replace(/([A-Za-z0-9])([\p{Script=Han}\p{Script=Hiragana}\p{Script=Katakana}\p{Script=Hangul}])/gu, addSpace),
+    count
+  }
+}
+
+const replaceFullWidthPunctuation = (text: string): { text: string; count: number } => {
+  const punctuation: Record<string, string> = {
+    ',': '，', '.': '。', '!': '！', '?': '？', ':': '：', ';': '；', '(': '（', ')': '）'
+  }
+  let count = 0
+  let result = ''
+  for (let index = 0; index < text.length; index += 1) {
+    const char = text[index]
+    const replacement = punctuation[char]
+    if (!replacement) {
+      result += char
+      continue
+    }
+    const left = nearestNonSpace(text, index, -1)
+    const right = nearestNonSpace(text, index, 1)
+    const numericSeparator = /[,.]/.test(char) && /\d/.test(left) && /\d/.test(right)
+    const context = text.slice(Math.max(0, index - 12), Math.min(text.length, index + 13))
+    if (!numericSeparator && CJK.test(context)) {
+      result += replacement
+      count += 1
+    } else {
+      result += char
+    }
+  }
+  return { text: result, count }
+}
+
+const collapsePlainSpaces = (
+  text: string,
+  source: string,
+  sourceOffset: number
+): { text: string; count: number } => {
+  let count = 0
+  const output = text.replace(/[ \t]{2,}/g, (spaces, offset: number) => {
+    const absolute = sourceOffset + offset
+    const lineStart = source.lastIndexOf('\n', absolute - 1) + 1
+    const before = source.slice(lineStart, absolute)
+    const atLineEnd = source[absolute + spaces.length] === '\n' || absolute + spaces.length === source.length
+    const isIndentation = /^\s*$/.test(before)
+    const isMarkdownPrefix = /^\s*(?:[-+*]|\d+[.)]|>)(?:\s*)$/.test(before)
+    if (isIndentation || isMarkdownPrefix || atLineEnd) return spaces
+    count += spaces.length - 1
+    return ' '
+  })
+  return { text: output, count }
+}
+
+export const tidyCjkMarkdown = (
+  markdown: string,
+  rules: CjkTidyRules = CJK_TIDY_DEFAULT_RULES
+): CjkTidyResult => {
+  const counts: CjkTidyResult['counts'] = {
+    cjkLatinSpacing: 0,
+    fullWidthPunctuation: 0,
+    collapseSpaces: 0,
+    fullWidthSpace: 0
+  }
+  const mask = buildProtectionMask(markdown)
+  let output = ''
+  let cursor = 0
+
+  while (cursor < markdown.length) {
+    const protectedValue = mask[cursor]
+    let end = cursor + 1
+    while (end < markdown.length && mask[end] === protectedValue) end += 1
+    let segment = markdown.slice(cursor, end)
+
+    if (!protectedValue) {
+      if (rules.cjkLatinSpacing) {
+        const transformed = replaceCjkLatinSpacing(segment)
+        segment = transformed.text
+        counts.cjkLatinSpacing += transformed.count
+      }
+      if (rules.fullWidthPunctuation) {
+        const transformed = replaceFullWidthPunctuation(segment)
+        segment = transformed.text
+        counts.fullWidthPunctuation += transformed.count
+      }
+      if (rules.collapseSpaces) {
+        const transformed = collapsePlainSpaces(segment, markdown, cursor)
+        segment = transformed.text
+        counts.collapseSpaces += transformed.count
+      }
+      if (rules.fullWidthSpace) {
+        segment = segment.replace(/\u3000/g, () => {
+          counts.fullWidthSpace += 1
+          return ' '
+        })
+      }
+    }
+    output += segment
+    cursor = end
+  }
+
+  return {
+    markdown: output,
+    counts,
+    total: Object.values(counts).reduce((sum, value) => sum + value, 0)
+  }
+}
