+const globalStylesPath = resolve(rendererRoot, 'assets/styles/index.css')
+
+describe('approved workspace layout placement', () => {
+  it('keeps the collapse control in the sidebar and exposes a restore control in the title bar', () => {
+    const sidebar = readFileSync(sidebarPath, 'utf8')
+    const titleBar = readFileSync(titleBarPath, 'utf8')
+    const workspaceBar = readFileSync(workspaceBarPath, 'utf8')
+
+    expect(sidebar).toContain('class="workspace-sidebar-toggle"')
+    expect(sidebar).toContain('@click="toggleSidebar"')
+    expect(sidebar).toContain('justify-content: space-between')
+    expect(titleBar).toContain('v-if="!showSideBar"')
+    expect(titleBar).toContain('class="collapsed-sidebar-toggle title-no-drag"')
+    expect(titleBar).toContain('@click.stop="restoreSidebar"')
+    expect(workspaceBar).not.toContain('class="workspace-sidebar-toggle"')
+    expect(workspaceBar).not.toContain('const toggleSidebar')
+  })
+
+  it('renders tabs in a bottom bar owned by the editor pane', () => {
+    const app = readFileSync(appPath, 'utf8')
+    const workspaceBar = readFileSync(workspaceBarPath, 'utf8')
+    const bottomTabs = app.match(/<div\s+v-if="init"\s+class="editor-bottom-tabs"[\s\S]*?<tabs\s*\/>[\s\S]*?<\/div>/)?.[0] ?? ''
+
+    expect(bottomTabs).not.toBe('')
+    expect(app).toContain("import Tabs from '@/components/editorWithTabs/tabs.vue'")
