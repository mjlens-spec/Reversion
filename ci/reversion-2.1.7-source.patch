@@ -0,0 +1,68 @@
+import { expect, test } from '@playwright/test'
+import type { ElectronApplication, Page } from 'playwright'
+import { launchWithTreeFixture } from './helpers'
+
+test.describe('single-file sidebar context tree', () => {
+  let app: ElectronApplication
+  let page: Page
+  let rootDirectory = ''
+  let filePath = ''
+
+  test.beforeAll(async() => {
+    const launched = await launchWithTreeFixture()
+    app = launched.app
+    page = launched.page
+    rootDirectory = launched.rootDirectory
+    filePath = launched.filePath
+    const filesTab = page.locator('.side-bar .sidebar-tab[aria-label="Files"]')
+    await filesTab.click()
+    await page.waitForSelector('.context-project-tree', { state: 'visible', timeout: 10000 })
+    await page.waitForSelector('.context-project-tree .side-bar-file', { state: 'visible', timeout: 10000 })
+  })
+
+  test.afterAll(async() => {
+    if (app) await app.close()
+  })
+
+  test('shows current highlight and supported/unsupported file states', async() => {
+    const note = page.locator('.context-project-tree .side-bar-file', { hasText: 'note.md' })
+    const unsupported = page.locator('.context-project-tree .side-bar-file', { hasText: 'image.png' })
+    await expect(note).toHaveClass(/current/)
+    await expect(note).not.toHaveAttribute('aria-disabled', 'true')
+    await expect(unsupported).toHaveClass(/unsupported/)
+    await expect(unsupported).toHaveAttribute('aria-disabled', 'true')
+    await expect(unsupported).toHaveCSS('opacity', '0.75')
+
+    // A real pointer cannot activate an aria-disabled tree item. Force the
+    // event here so the assertion also guards the component click handler.
+    await unsupported.click({ force: true })
+    await expect(note).toHaveClass(/current/)
+    await expect(page.locator('.editor-component')).toBeVisible()
+  })
+
+  test('expands a child directory and can move the context root upward', async() => {
+    const nested = page.locator('.context-project-tree > .tree-wrapper > .side-bar-folder', { hasText: 'nested' })
+    await nested.locator('.folder-name').click()
+    await expect(nested.locator('.folder-contents .side-bar-file', { hasText: 'child.md' })).toBeVisible()
+
+    const up = page.locator('.context-tree-up')
+    await expect(up).not.toBeDisabled()
+    await up.click()
+    await expect(page.locator('.context-project-tree > .title')).not.toContainText('nested')
+
+    // The parent root exposes the original fixture as a directory. Expanding
+    // it restores the note and nested child without changing projectTree.
+    const rootFolderName = rootDirectory.split(/[\\/]/).pop() || ''
+    const fixtureFolder = page.locator('.context-project-tree > .tree-wrapper > .side-bar-folder', { hasText: rootFolderName })
+    await expect(fixtureFolder).toBeVisible()
+    await fixtureFolder.locator('.folder-name').click()
+    await expect(fixtureFolder.locator('.folder-contents .side-bar-file', { hasText: 'note.md' })).toBeVisible()
+
+    const state = await page.evaluate(() => ({
+      root: document.querySelector('.context-project-tree > .title')?.textContent || '',
+      projectTree: (window as unknown as { __reversionProjectTree?: unknown }).__reversionProjectTree
+    }))
+    expect(state.root).toBeTruthy()
+    expect(filePath).toContain(rootFolderName)
+  })
+})
