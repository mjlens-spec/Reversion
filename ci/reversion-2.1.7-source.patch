diff --git a/packages/desktop/src/main/ipc/fsDirectory.ts b/packages/desktop/src/main/ipc/fsDirectory.ts
new file mode 100644
index 00000000..d41809f0
--- /dev/null
+++ b/packages/desktop/src/main/ipc/fsDirectory.ts
@@ -0,0 +1,73 @@
+import path from 'path'
+import type { SerializedDirectoryEntry } from '@shared/types/files'
+
+/** The serializable subset of a Node Dirent needed by the renderer tree. */
+export interface FsDirectoryEntryLike {
+  name: string
+  isFile(): boolean
+  isDirectory(): boolean
+  isSymbolicLink(): boolean
+}
+
+export interface FsDirectoryTargetStat {
+  isFile: boolean
+  isDirectory: boolean
+}
+
+export interface FsDirectoryClassificationOptions {
+  hasMarkdownExtension(filename: string): boolean
+  /** Used only for symbolic links, whose target extension may differ. */
+  isMarkdownFile(pathname: string): boolean
+  /** Used only for symbolic links, to determine the target kind. */
+  stat(pathname: string): Promise<FsDirectoryTargetStat>
+}
+
+/**
+ * Classify a readdir-with-types result without probing ordinary files.
+ *
+ * Dirents already identify normal files and directories, so their Markdown
+ * state is a pure filename check. Only symbolic links require an async target
+ * stat and the real `isMarkdownFile` rule; broken links remain visible but are
+ * not openable.
+ */
+export const serializeDirectoryEntries = async(
+  directoryPath: string,
+  entries: readonly FsDirectoryEntryLike[],
+  options: FsDirectoryClassificationOptions
+): Promise<SerializedDirectoryEntry[]> => {
+  const result: SerializedDirectoryEntry[] = []
+
+  for (const entry of entries) {
+    const isSymbolicLink = entry.isSymbolicLink()
+    let isFile = entry.isFile()
+    let isDirectory = entry.isDirectory()
+    const pathname = path.join(directoryPath, entry.name)
+
+    if (isSymbolicLink) {
+      try {
+        const target = await options.stat(pathname)
+        isFile = target.isFile
+        isDirectory = target.isDirectory
+      } catch {
+        isFile = false
+        isDirectory = false
+      }
+    }
+
+    const isMarkdown = isFile && (
+      isSymbolicLink
+        ? options.isMarkdownFile(pathname)
+        : options.hasMarkdownExtension(entry.name)
+    )
+    result.push({
+      name: entry.name,
+      isFile,
+      isDirectory,
+      isSymbolicLink,
+      isMarkdown,
+      isOpenable: isMarkdown
+    })
+  }
+
+  return result
+}
