+import { describe, expect, it } from 'vitest'
+import {
+  createReadingTypographyOverrideCss,
+  normalizeReadingTypography,
+  type ReadingTypographyPreferences
+} from '../../../src/renderer/src/util/readingTypography'
+
+const themeDefaults: ReadingTypographyPreferences = {
+  fontSize: 'theme',
+  lineHeight: 'theme',
+  paragraphSpacing: 'theme',
+  columnWidth: 'theme'
+}
+
+describe('reading typography overrides', () => {
+  it('emits no CSS when every value follows the theme', () => {
+    expect(createReadingTypographyOverrideCss(themeDefaults)).toBe('')
+  })
+
+  it('uses the same four variables for the editor and styled exports', () => {
+    expect(createReadingTypographyOverrideCss({
+      fontSize: 18,
+      lineHeight: 1.75,
+      paragraphSpacing: 1.2,
+      columnWidth: 920
+    })).toBe([
+      '  --reading-font-size: 18px;',
+      '  --reading-line-height: 1.75;',
+      '  --reading-paragraph-spacing: 1.2em;',
+      '  --reading-column-width: 920px;'
+    ].join('\n'))
+  })
+
+  it('uses max available width without overflow when requested', () => {
+    expect(createReadingTypographyOverrideCss({
+      ...themeDefaults,
+      columnWidth: 'window'
+    })).toContain('--reading-column-width: 100%;')
+  })
+
+  it('clamps persisted values and falls back invalid values to theme', () => {
+    expect(normalizeReadingTypography({
+      fontSize: 99,
+      lineHeight: 0,
+      paragraphSpacing: 'bad',
+      columnWidth: 420
+    } as unknown as ReadingTypographyPreferences)).toEqual({
+      fontSize: 24,
+      lineHeight: 1.3,
+      paragraphSpacing: 'theme',
+      columnWidth: 600
+    })
+  })
+})
