+    const exportHover = source.match(/\.workspace-export-trigger:not\(:disabled\):hover \{[\s\S]*?\n\}/)?.[0] ?? ''
+    const exportOpen = source.match(/\.workspace-export-trigger\[aria-expanded="true"\]:not\(:disabled\) \{[\s\S]*?\n\}/)?.[0] ?? ''
+    const exportPressed = source.match(/\.workspace-export-trigger:not\(:disabled\):active \{[\s\S]*?\n\}/)?.[0] ?? ''
+    const exportDisabled = source.match(/\.workspace-export-trigger:disabled \{[\s\S]*?\n\}/)?.[0] ?? ''
+    const exportFocus = source.match(/\.workspace-export-trigger:focus-visible \{[\s\S]*?\n\}/)?.[0] ?? ''
