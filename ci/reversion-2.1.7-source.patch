+    expect(workspaceBar).not.toContain('<tabs />')
+    expect(workspaceBar).not.toContain("import Tabs from '../editorWithTabs/tabs.vue'")
+  })
+
+  it('uses one shared header geometry for divider and title alignment', () => {
+    const globalStyles = readFileSync(globalStylesPath, 'utf8')
+    const app = readFileSync(appPath, 'utf8')
+    const titleBar = readFileSync(titleBarPath, 'utf8')
+    const workspaceBar = readFileSync(workspaceBarPath, 'utf8')
+    const sidebar = readFileSync(sidebarPath, 'utf8')
+
+    expect(globalStyles).toContain('--workspaceBarHeight: 46px')
+    expect(globalStyles).toContain('--workspaceHeaderHeight: calc(var(--titleBarHeight) + var(--workspaceBarHeight))')
+    expect(globalStyles).toContain('--workspaceTabBarHeight: 44px')
+    expect(app).toContain('class="editor-header"')
+    expect(app).toContain('height: var(--workspaceHeaderHeight)')
+    expect(workspaceBar).toContain('height: var(--workspaceBarHeight)')
+    expect(sidebar).toContain('height: var(--workspaceBarHeight)')
+    expect(titleBar).toContain('position: absolute')
+    expect(titleBar).toContain('top: var(--titleBarHeight)')
+    expect(titleBar).toContain('height: var(--workspaceBarHeight)')
+  })
+
+  it('raises the table-of-contents heading by eight pixels', () => {
+    const toc = readFileSync(tocPath, 'utf8')
+
+    expect(toc).toContain('margin: 29px 0 10px 0')
+    expect(toc).not.toContain('margin: 37px 0 10px 0')
+  })
+})
