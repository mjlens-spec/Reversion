+import { describe, expect, it } from 'vitest'
+import {
+  getDirectoryTrail,
+  getDisplayFilename
+} from '@/components/titleBar/presentation'
+
+describe('title bar document presentation', () => {
+  describe('getDisplayFilename', () => {
+    it('hides the final file extension', () => {
+      expect(getDisplayFilename('OLLY Y11代言人营销方案评审.md')).toBe(
+        'OLLY Y11代言人营销方案评审'
+      )
+    })
+
+    it('preserves earlier dots and extensionless names', () => {
+      expect(getDisplayFilename('brief.v2.markdown')).toBe('brief.v2')
+      expect(getDisplayFilename('Untitled-1')).toBe('Untitled-1')
+    })
+  })
+
+  describe('getDirectoryTrail', () => {
+    it('shows the three directories nearest to the file in reading order', () => {
+      expect(
+        getDirectoryTrail(
+          '/Users/lensmiao/联合利华/2607_OLLY_Y27_IMC/02_策略与创意/修改规划.md'
+        )
+      ).toEqual(['联合利华', '2607_OLLY_Y27_IMC', '02_策略与创意'])
+    })
+
+    it('keeps shorter directory trails intact', () => {
+      expect(getDirectoryTrail('/联合利华/修改规划.md')).toEqual(['联合利华'])
+      expect(getDirectoryTrail('/修改规划.md')).toEqual([])
+    })
+
+    it('supports Windows paths and repeated separators', () => {
+      expect(
+        getDirectoryTrail(
+          'C:\\Clients\\联合利华\\2607_OLLY_Y27_IMC\\02_策略与创意\\修改规划.md'
+        )
+      ).toEqual(['联合利华', '2607_OLLY_Y27_IMC', '02_策略与创意'])
+
+      expect(getDirectoryTrail('/Clients//联合利华///修改规划.md')).toEqual([
+        'Clients',
+        '联合利华'
+      ])
+    })
+
+    it('returns no directory trail without a pathname', () => {
+      expect(getDirectoryTrail()).toEqual([])
+      expect(getDirectoryTrail('')).toEqual([])
+    })
+
+    it('does not treat a Windows drive as a displayable folder', () => {
+      expect(getDirectoryTrail('C:\\修改规划.md')).toEqual([])
+    })
